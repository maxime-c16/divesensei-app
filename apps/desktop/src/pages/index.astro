---
import DesignWorkspace from "@/components/DesignWorkspace.astro";
import { getWorkspaceCopy } from "@/lib/copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

const copy = getWorkspaceCopy();
const theme = {
  id: "meet",
  name: "DiveSensei",
  route: "/",
  tagline: "Dive review",
  subtitle: "Review attempts quickly, keep the ones you want, then export the clips you need.",
  tabs: copy.tabs,
} as const;

Astro.response.headers.set("Cache-Control", "no-cache, no-store, must-revalidate");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");
---

<BaseLayout title="DiveSensei">
  <DesignWorkspace theme={theme} />
</BaseLayout>
