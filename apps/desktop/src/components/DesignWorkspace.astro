---
import path from "node:path";
import brandLockupDark from "@/assets/divesensei-lockup-dark.svg";
import {
  formatSeconds,
  getUiData,
  mediaUrl,
  resolveClipMediaPath,
  resolveSourceMediaPath,
  sessionIsReviewReady,
  sessionStatusLabel,
} from "@/lib/ui-data";
import { listExportedPathsForAnalysisRun } from "@/lib/export-jobs";
import { listEvaluationFalseNegatives } from "@/lib/evaluation-review-store";

interface ThemeConfig {
  id: string;
  name: string;
  route: string;
  tagline: string;
  subtitle: string;
  tabs: [string, string, string, string];
}

const { theme } = Astro.props as { theme: ThemeConfig };
const requestedSession = Astro.url.searchParams.get("session") ?? undefined;
const requestedTab = Astro.url.searchParams.get("tab");
const requestedJob = Astro.url.searchParams.get("job");
const requestedFocus = Astro.url.searchParams.get("focus");
const activeTabIndex = Number.parseInt(requestedTab ?? "0", 10);
const initialTabIndex = Number.isNaN(activeTabIndex) ? 0 : Math.max(0, Math.min(theme.tabs.length - 1, activeTabIndex));
const uiData = getUiData(requestedSession);
const { library, manifest, selectedSessionId, eventReviewSupport, eventReviewRefinementTop15 } = uiData;
const eventReviewSupportRows = Array.isArray(eventReviewSupport) ? eventReviewSupport : [];
const eventReviewQueueRows = Array.isArray(eventReviewRefinementTop15) ? eventReviewRefinementTop15 : [];
const refinementQueueStats = eventReviewQueueRows.reduce((acc, row) => {
  const key = String(row.current_final_human_event_label ?? "unlabeled");
  const currentCount = Number(acc[key] ?? 0);
  acc[key] = currentCount + 1;
  return acc;
}, {} as Record<string, number>);
const refinementFalseNegativeOrderBySession: Record<string, number> = {};
const formatQueueSessionLabel = (sessionId: string) => {
  const value = String(sessionId ?? "").trim();
  if (!value) return "Session";
  if (value.startsWith("evaluation_insep_15min")) return "INSEP · 15 min";
  if (value.startsWith("evaluation_insep_quick_9015")) return "INSEP · Quick 9015";
  if (value.startsWith("evaluation_champigny")) return "Champigny";
  if (value.startsWith("evaluation_")) {
    const parts = value.replace(/^evaluation_/, "").split("_").filter(Boolean);
    const short = parts.slice(0, 2).map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(" ");
    return short || "Session";
  }
  return value.length > 18 ? `${value.slice(0, 15)}…` : value;
};
const hasSession = library.session_count > 0;
const session = manifest.session;
const sessionMode = session.mode ?? "standard";
const isEvaluationSession = sessionMode === "evaluation";
const detections = manifest.detections.map((item) => ({
  ...item,
  reviewClipPath: resolveClipMediaPath(item.clip.browser_path ?? item.clip.path),
}));
const initialFalseNegativeAnnotations = isEvaluationSession ? listEvaluationFalseNegatives(manifest) : [];
const initialFalseNegativeDetections = initialFalseNegativeAnnotations.map((annotation, index) => ({
  id: annotation.id,
  index: detections.length + index + 1,
  timestamp_seconds: Number(annotation.timestampSeconds ?? 0),
  start_time_seconds: Number(annotation.reviewStartSeconds ?? Math.max(0, Number(annotation.timestampSeconds ?? 0) - 2)),
  end_time_seconds: Number(annotation.reviewEndSeconds ?? Number(annotation.timestampSeconds ?? 0) + 2),
  duration_seconds: Math.max(0.5, Number(annotation.reviewEndSeconds ?? 0) - Number(annotation.reviewStartSeconds ?? 0)),
  review_start_seconds: Number(annotation.reviewStartSeconds ?? Math.max(0, Number(annotation.timestampSeconds ?? 0) - 2)),
  review_end_seconds: Number(annotation.reviewEndSeconds ?? Number(annotation.timestampSeconds ?? 0) + 2),
  review_duration_seconds: Math.max(0.5, Number(annotation.reviewEndSeconds ?? 0) - Number(annotation.reviewStartSeconds ?? 0)),
  confidence: "medium" as const,
  scores: {
    audio: 0,
    video: 0,
    combined: 0,
    audio_model_probability: 0,
    audio_clip_probability: 0,
  },
  features: {},
  clip: {
    path: null,
    browser_path: null,
    filename: null,
  },
  reviewClipPath: null,
  notes: annotation.notes ?? "",
  subtype: annotation.subtype ?? "",
  eventLabel: annotation.eventLabel ?? null,
  entry_type: "false_negative",
}));
const selected = detections[0];
const highest = [...detections].sort((a, b) => b.scores.combined - a.scores.combined)[0] ?? selected;
const defaultSessionName = `Session ${new Intl.DateTimeFormat("sv-SE", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(new Date()).replace(" ", " ").replace(",", "")}`;
const sessionReadyNow = sessionIsReviewReady(session.status);
const primaryVideoUrl = mediaUrl(resolveSourceMediaPath(session.source_video_path, session.output_dir));
const sourceVideoUrl = mediaUrl(session.source_video_path);
const sourceVideoBrowserFriendly = [".mp4", ".webm", ".m4v"].includes(path.extname(session.source_video_path).toLowerCase());
const initialReviewVideoUrl = session.status === "ready_proxy_pending" && !sourceVideoBrowserFriendly ? "" : primaryVideoUrl;
const initialReviewPlaceholderVisible = session.status === "ready_proxy_pending" && !sourceVideoBrowserFriendly;
const timelineStart = 0;
const timelineEnd = Math.max(
  Number(session.session_duration_seconds ?? 0),
  Number(session.timestamp_range.last ?? 0),
  1,
);
const rangeStart = timelineStart;
const rangeSpan = Math.max(timelineEnd - timelineStart, 1);
const niceTimelineStep = (span: number) => {
  const targetTicks = 7;
  const rough = Math.max(span / targetTicks, 0.5);
  const steps = [0.5, 1, 2, 5, 10, 15, 20, 30, 45, 60, 90, 120, 180, 300, 600];
  return steps.find((step) => rough <= step) ?? steps[steps.length - 1];
};
const timelineStep = niceTimelineStep(rangeSpan);
const timelineTicks = (() => {
  const ticks: Array<{ value: number; left: number; label: string }> = [];
  const firstTick = Math.ceil(rangeStart / timelineStep) * timelineStep;
  for (let value = firstTick; value < timelineEnd; value += timelineStep) {
    if (value <= rangeStart + 0.01 || value >= timelineEnd - 0.01) continue;
    const left = Math.min(99.2, Math.max(0.8, ((value - rangeStart) / rangeSpan) * 100));
    ticks.push({ value, left, label: formatSeconds(value) });
  }
  return ticks;
})();
const timelineScaleLabels = [
  { left: 0.8, label: formatSeconds(timelineStart), edge: "start" },
  ...timelineTicks.map((tick) => ({ left: tick.left, label: tick.label, edge: "mid" })),
  { left: 99.2, label: formatSeconds(timelineEnd), edge: "end" },
];
const markerPosition = (timestamp: number) => {
  const normalized = ((timestamp - rangeStart) / rangeSpan) * 100;
  return Math.min(99.2, Math.max(0.8, normalized));
};
const reviewStartFor = (item: typeof detections[number]) => item.review_start_seconds ?? item.start_time_seconds;
const reviewEndFor = (item: typeof detections[number]) => item.review_end_seconds ?? item.end_time_seconds;
const signalLabelFor = (confidence: string) => {
  if (confidence === "high") return "Strong";
  if (confidence === "medium") return "Review";
  return "Weak";
};
const detectorLabelFor = (value: string | undefined) => {
  if (!value || value === "audio_v2_pcen_classifier") return "Standard audio";
  if (value === "audio_v1_heuristic") return "Legacy audio";
  if (value === "audio_v2_hybrid_video") return "Audio + video";
  return value.replaceAll("_", " ");
};
const profileLabelFor = (value: string | undefined) => {
  if (!value || value === "long-session") return "Training session";
  if (value === "reviewed") return "Reviewed session";
  return value.replaceAll("-", " ");
};
const formatSessionStamp = (value: string | undefined) => {
  if (!value) return "Unknown";
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return value;
  return new Intl.DateTimeFormat("en-GB", {
    year: "numeric",
    month: "short",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  }).format(parsed);
};
const sessionDisplayName = session.session_name ?? session.title;
const hasActiveSession = hasSession && Boolean(session.id);
const sessionDurationSeconds = Number(session.session_duration_seconds ?? session.timestamp_range.last ?? 0);
const analysisRuntimeSeconds = Number(session.telemetry.total_runtime_seconds ?? 0);
const sourceVideoLabel = session.source_video_path ? path.basename(session.source_video_path) : "No video selected";
const sourceAvailabilityLabel = session.source_availability === "missing"
  ? "Source missing"
  : session.source_availability === "relink-required"
    ? "Relink required"
    : "Source available";
const topAttemptSummary = highest
  ? `${formatSeconds(highest.timestamp_seconds)} · ${highest.confidence} confidence`
  : "Analysis not started";
const nextActionLabel = !hasActiveSession
  ? "Choose a video, keep the default detector, and start analysis."
  : detections.length === 0
    ? "This session is ready, but no attempts have been found yet."
    : sessionReadyNow
      ? (isEvaluationSession
        ? "Open Review, label each attempt as dive or non-dive, and mark missed dives directly on the proxy."
        : "Open Review, confirm the attempts you want, then export the clips you keep.")
      : "Wait for analysis to finish, then open Review.";
const initialExportedPaths = hasActiveSession ? listExportedPathsForAnalysisRun(session.id) : [];
const clientBundle = JSON.stringify({
  hasSession,
  session,
  sessionMode,
  detections,
  eventReviewSupportRows,
  primaryVideoUrl,
  sourceVideoUrl,
  rangeStart,
  rangeSpan,
  initialExportedPaths,
  initialReviewPending: initialReviewPlaceholderVisible,
  initialFalseNegativeAnnotations,
  requestedTab,
  requestedSession,
  requestedJob,
  requestedFocus,
  eventReviewRefinementTop15,
});
---

<main class={`screen theme-${theme.id}`} data-design-root>
  <header class="workspace-header shell">
    <a class="brand-lockup" href="/" aria-label="DiveSensei home">
      <img src={brandLockupDark.src} alt="DiveSensei" class="brand-lockup__image" />
    </a>
    <nav class="header-nav" aria-label="Workspace tabs">
      {theme.tabs.map((tab, index) => (
        <button
          class={`tab ${index === initialTabIndex ? "is-active" : ""}`}
          type="button"
          data-tab-trigger
          data-tab-target={`panel-${index}`}
        >
          {tab}
        </button>
      ))}
    </nav>
  </header>

  <section class={`panel shell ${initialTabIndex === 0 ? "is-active" : ""}`} id="panel-0" data-tab-panel>
    <div class="grid library-grid">
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>New session</h2>
            <p class="section-note">Choose a video, pick a detector, and start analysis.</p>
          </div>
          <button class="action-link" type="button" data-open-tab="3">Open library</button>
        </div>
        {sessionReadyNow && session.status === "ready_proxy_pending" && (
          <div class="library-inline-note">
            <strong>Ready to review.</strong> The review video is still being prepared.
          </div>
        )}
        <form class="analysis-launcher" data-analysis-form>
          <div class="analysis-launcher__grid">
            <label class="field">
              <span>Session name</span>
              <input
                type="text"
                name="sessionName"
                value={defaultSessionName}
                data-analysis-session-name
                data-default-session-name={defaultSessionName}
                autocomplete="off"
              />
            </label>
            <label class="field">
              <span>Video file</span>
              <div class="analysis-picker">
                <input type="text" name="videoPath" value="" data-analysis-path autocomplete="off" placeholder="/absolute/path/to/video.mov" />
                <div class="analysis-picker__controls">
                  <button type="button" class="action-link analysis-picker__button" data-analysis-pick>Choose file</button>
                  <span class="analysis-picker__label" data-analysis-file-label>No file selected. You can still paste a path manually.</span>
                </div>
                <input
                  type="file"
                  accept="video/*,.mov,.mp4,.m4v,.avi,.mkv,.webm"
                  class="analysis-picker__native"
                  data-analysis-file
                />
              </div>
            </label>
            <label class="field">
              <span>Session type</span>
              <select name="profile" data-analysis-profile>
                <option value="long-session" selected>Training session</option>
                <option value="reviewed">Reviewed session</option>
              </select>
            </label>
            <label class="field">
              <span>Detection method</span>
              <select name="detectorId" data-analysis-detector>
                <option value="audio_v2_pcen_classifier" selected>Standard</option>
                <option value="audio_v1_heuristic">Legacy audio</option>
                <option value="audio_v2_hybrid_video">Audio + video</option>
              </select>
            </label>
          </div>
          <div class="analysis-launcher__actions launcher-actions">
            <button type="submit" class="action-link action-link--primary">Start analysis</button>
          </div>
          <p class="analysis-launcher__status" data-analysis-status>Ready when you are.</p>
        </form>
      </article>

      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>What happens next</h2>
            <p class="section-note">Create first, review second, export last.</p>
          </div>
        </div>
        <div class="session-summary session-summary--empty">
          <div class="session-summary__empty-grid">
            <article>
              <strong>1. Choose a video</strong>
              <p>Pick a file, or paste a full path if the video is already on disk.</p>
            </article>
            <article>
              <strong>2. Start analysis</strong>
              <p>DiveSensei scans the full session and prepares reviewable attempts.</p>
            </article>
            <article>
              <strong>3. Open Library</strong>
              <p>Use the Library tab to reopen older sessions, rename them, or remove them.</p>
            </article>
            <article>
              <strong>4. Review and export</strong>
              <p>Confirm the attempts you want, then export only the clips you keep.</p>
            </article>
          </div>
          <div class="action-list">
            <button class="action-link" type="button" data-open-tab="3">Browse library</button>
            <button class="action-link" type="button" data-open-tab="1" disabled={!hasActiveSession}>Open review</button>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class={`panel panel--review shell ${initialTabIndex === 1 ? "is-active" : ""}`} id="panel-1" data-tab-panel>
    <div class="review-layout">
      <article class="review-main">
        <div class="review-main__video">
          <div class="player-stage__frame">
            <video
              class="review-video"
              controls
              preload="metadata"
              playsinline
              src={initialReviewVideoUrl || undefined}
              data-review-video
              data-source-src={primaryVideoUrl}
            ></video>
            <div class="library-inline-note" data-review-placeholder hidden={!initialReviewPlaceholderVisible}>
              The review video for this file is still being prepared. Playback will appear automatically.
            </div>
          </div>
        </div>
        <div class="review-main__controls">
          <div class="review-decisions">
            <button class="action-link review-decisions__button" type="button" data-review-prev aria-label="Previous queue item">Previous</button>
            <button class="action-link review-decisions__button" type="button" data-review-next aria-label="Next queue item">Next</button>
            <button class="action-link review-decisions__button" type="button" data-toggle-splash-pause aria-label="Pause briefly at splash cue">Pause at splash off</button>
            <span class="review-splash-indicator" data-splash-cue-indicator aria-live="polite">Splash cue</span>
            <button class="action-link review-decisions__button review-decisions__button--keep" type="button" data-decision={isEvaluationSession ? "dive" : "keep"}>{isEvaluationSession ? "Dive" : "Keep"}</button>
            <button class="action-link review-decisions__button review-decisions__button--reject" type="button" data-decision={isEvaluationSession ? "non_dive" : "reject"}>{isEvaluationSession ? "Non-dive" : "Reject"}</button>
            <button class="action-link review-decisions__button review-decisions__button--unsure" type="button" data-decision="unsure">Unsure</button>
            {isEvaluationSession && (
              <button class="action-link review-decisions__button review-decisions__button--reject" type="button" data-decision-false-negative>Missed dive</button>
            )}
            {isEvaluationSession && (
              <select class="review-decisions__subtype" data-decision-subtype aria-label="Evaluation subtype">
                <option value="">Subtype (optional)</option>
                <option value="board_rebound">Board rebound</option>
                <option value="board_slap">Board slap</option>
                <option value="non_dive_splash">Non-dive splash</option>
                <option value="voice_whistle">Voice / whistle</option>
                <option value="handling_noise">Handling noise</option>
                <option value="unknown_transient">Unknown transient</option>
              </select>
            )}
            {isEvaluationSession && (
              <select class="review-decisions__subtype" data-event-label aria-label="Event label">
                <option value="">Event label (optional)</option>
                <option value="springboard_dive">Springboard dive</option>
                <option value="springboard_rebound_only">Springboard rebound only</option>
                <option value="platform_dive">Platform dive</option>
                <option value="noise_or_other">Noise or other</option>
                <option value="uncertain">Uncertain</option>
              </select>
            )}
            <input type="text" class="review-decisions__note" data-decision-notes placeholder="Note (optional)" />
            {isEvaluationSession && (
              <button class="action-link review-decisions__button review-decisions__button--keep" type="button" data-event-save>Save event label</button>
            )}
          </div>
        </div>
        <div class="review-main__timeline">
          <div class="tl" data-timeline-viewport>
            <div class="tl__scale">
              {timelineScaleLabels.map((tick) => (
                <span
                  class={`tl__time tl__time--${tick.edge}`}
                  style={`left:${tick.left}%;`}
                >
                  {tick.label}
                </span>
              ))}
            </div>
            <div class="tl__track" data-timeline-track>
              <div class="tl__playhead" data-timeline-playhead></div>
              <div class="tl__tooltip" data-timeline-tooltip hidden></div>
              {timelineTicks.map((tick) => (
                <span
                  class="tl__tick"
                  style={`left:${tick.left}%;`}
                  aria-hidden="true"
                ></span>
              ))}
              {detections.map((item) => (
                <button
                  type="button"
                  class={`tl__pip confidence-${item.confidence} ${item.id === selected?.id ? "is-current" : ""}`}
                  style={`left:${markerPosition(item.timestamp_seconds)}%;`}
                  data-focus-detection={item.id}
                  data-timeline-marker={item.id}
                  data-pip-index={item.index}
                  data-pip-time={formatSeconds(item.timestamp_seconds)}
                  aria-label={`Attempt ${item.index} at ${formatSeconds(item.timestamp_seconds)}`}
                ></button>
              ))}
              {initialFalseNegativeDetections.map((item) => (
                <button
                  type="button"
                  class={`tl__pip confidence-${item.confidence} is-false-negative ${item.id === selected?.id ? "is-current" : ""}`}
                  style={`left:${markerPosition(item.timestamp_seconds)}%;`}
                  data-focus-detection={item.id}
                  data-timeline-marker={item.id}
                  data-pip-index={item.index}
                  data-pip-time={formatSeconds(item.timestamp_seconds)}
                  aria-label={`Manual false-negative window at ${formatSeconds(item.timestamp_seconds)}`}
                ></button>
              ))}
            </div>
          </div>
        </div>
        <p class="review-main__status" data-decision-status hidden>No decision saved for this attempt.</p>
        <div class="library-inline-note" data-review-progress hidden>
          Review is available now. Export only the clips you keep.
        </div>
        <section class="review-complete-toast" data-review-complete hidden>
          <div class="review-complete-toast__body">
            <strong data-review-complete-title>{isEvaluationSession ? "Evaluation review complete" : "Review complete"}</strong>
            <p data-review-complete-copy>{isEvaluationSession ? "You have reviewed every detector attempt. Open Summary to inspect dive, non-dive, and false-negative counts." : "You have finished the queue. Open Exports to create clips from the attempts you kept, or stay here and keep browsing."}</p>
          </div>
          <div class="review-complete-toast__actions">
            <button class="action-link action-link--primary" type="button" data-review-complete-export>{isEvaluationSession ? "Open summary" : "Open exports"}</button>
            <button class="action-link" type="button" data-review-complete-stay>Keep reviewing</button>
          </div>
          <div class="review-complete-toast__timer" aria-hidden="true"></div>
        </section>
      </article>

      <aside class="review-sidebar">
        {eventReviewQueueRows.length > 0 && (
          <section class="review-refinement">
            <div class="review-refinement__header">
              <div class="review-refinement__titleblock">
                <h2>Refinement queue</h2>
                <p>High-value rows selected from the confusion audit. Review these first to reduce class collapse.</p>
              </div>
              <div class="review-refinement__meta">
                <strong>{eventReviewQueueRows.length}</strong>
                <span>priority rows</span>
              </div>
            </div>
            <div class="review-refinement__stats">
              {Object.entries(refinementQueueStats).map(([label, count]) => (
                <article class="review-refinement__stat">
                  <strong>{count}</strong>
                  <span>{label.replaceAll("_", " ")}</span>
                </article>
              ))}
            </div>
            <div class="review-refinement__note">
              <strong>Review rule</strong>
              <p>Confirm real entry vs rebound-only structure first. Keep `noise_or_other` for handling noise, whistles, splashes, and other non-event clutter. Use `uncertain` only when the window still does not support a clean archetype.</p>
            </div>
            <ol class="review-refinement__list">
              {eventReviewQueueRows.map((row, index) => (
                (() => {
                  const sessionId = String(row.session_id ?? "");
                  const falseNegativeOrder = row.candidate_id == null
                    ? ((refinementFalseNegativeOrderBySession[sessionId] = (refinementFalseNegativeOrderBySession[sessionId] ?? 0) + 1), refinementFalseNegativeOrderBySession[sessionId])
                    : "";
                  return (
                <li class="review-refinement__item">
                  <button
                    type="button"
                    class="review-refinement__row"
                    data-queue-focus
                    data-queue-session={String(row.session_id ?? "")}
                    data-queue-candidate={String(row.candidate_id ?? "")}
                    data-queue-index={String(index + 1)}
                    data-queue-label={String(row.current_final_human_event_label ?? "")}
                    data-queue-pred={String(row.model_predicted_label ?? "")}
                    data-queue-suggestion={String(row.suggestion_label ?? "")}
                    data-queue-fn-order={String(falseNegativeOrder)}
                  >
                    <span class="review-refinement__rank">{String(index + 1).padStart(2, "0")}</span>
                    <div class="review-refinement__body">
                      <div class="review-refinement__rowhead">
                        <strong>{String(row.candidate_id ?? "Manual false-negative window")}</strong>
                        <div class="review-refinement__rowmeta">
                          <span class="review-refinement__sessiontag">{formatQueueSessionLabel(String(row.session_id ?? ""))}</span>
                          <span class="review-refinement__status" data-queue-status>Pending</span>
                        </div>
                      </div>
                      <div class="review-refinement__labels">
                        <span data-queue-final-label>Final {String(row.current_final_human_event_label ?? "unlabeled").replaceAll("_", " ")}</span>
                        <span>Model {String(row.model_predicted_label ?? "n/a").replaceAll("_", " ")}</span>
                        <span>Suggestion {String(row.suggestion_label ?? "n/a").replaceAll("_", " ")}</span>
                      </div>
                      <p>{String(row.why_this_row_matters ?? "")}</p>
                    </div>
                  </button>
                </li>
                  );
                })()
              ))}
            </ol>
            <div class="review-refinement__foot">
              <span>Click a row to jump directly into the review queue.</span>
            </div>
          </section>
        )}
        <div class="review-sidebar__header">
          <h2 data-review-list-title>{isEvaluationSession ? "Evaluation queue" : "Attempts"}</h2>
          <select class="review-sidebar__filter" data-review-filter>
            <option value="all" selected>All</option>
            <option value="pending">To review</option>
            <option value={isEvaluationSession ? "dive" : "keep"}>{isEvaluationSession ? "Dives" : "Kept"}</option>
            <option value={isEvaluationSession ? "non_dive" : "reject"}>{isEvaluationSession ? "Non-dives" : "Rejected"}</option>
            <option value="unsure">Unsure</option>
            {isEvaluationSession && <option value="false_negative">False negatives</option>}
          </select>
        </div>
        <div class="review-sidebar__list">
          <table class="queue-table">
            <thead>
              <tr>
                <th>Attempt</th>
                <th>Splash</th>
                <th>Decision</th>
                <th>{isEvaluationSession ? "Type" : "Signal"}</th>
              </tr>
            </thead>
            <tbody data-detection-table>
              {detections.map((item) => (
                <tr class={item.id === selected?.id ? "is-current" : ""} data-focus-detection={item.id}>
                  <td>{item.id}</td>
                  <td>{formatSeconds(item.timestamp_seconds)}</td>
                  <td>Pending</td>
                  <td>{signalLabelFor(item.confidence)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="detail-bar">
          <span data-detail-audio>Audio {selected ? selected.scores.audio.toFixed(2) : "0.00"}</span>
          <span data-detail-window>Window {selected ? `${formatSeconds(reviewStartFor(selected))} to ${formatSeconds(reviewEndFor(selected))}` : "0:00.000 to 0:00.000"}</span>
          <span data-detail-decision>No decision yet</span>
        </div>
      </aside>
    </div>
  </section>

  <section class={`panel shell ${initialTabIndex === 2 ? "is-active" : ""}`} id="panel-2" data-tab-panel>
    <div class="grid library-grid exports-grid">
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>{isEvaluationSession ? "Summary" : "Exports"}</h2>
          </div>
          <span class="counter">{isEvaluationSession ? `${detections.length} attempts` : `${session.extracted_count} exports`}</span>
        </div>
        {!isEvaluationSession && (
          <div class="analysis-launcher__actions export-actions">
            <button class="action-link action-link--primary" type="button" data-export-kept>Export kept clips</button>
          </div>
        )}
        <p class="analysis-launcher__status" data-export-status>{isEvaluationSession ? "Review decisions and false negatives will appear here." : "Ready when you are."}</p>
        <div class="artifact-grid" data-export-list></div>
      </article>
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>{isEvaluationSession ? "Evaluation status" : "Before you export"}</h2>
          </div>
        </div>
        <div class="export-insights__stats">
          <article class="export-insights__stat">
            <strong data-export-stat-ready>0</strong>
            <span>Ready</span>
          </article>
          <article class="export-insights__stat">
            <strong data-export-stat-exported>0</strong>
            <span>Exported</span>
          </article>
          <article class="export-insights__stat">
            <strong data-export-stat-review>0</strong>
            <span>To review</span>
