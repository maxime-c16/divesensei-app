          <strong data-export-callout-title>{isEvaluationSession ? "Start labeling" : "Nothing selected yet"}</strong>
          <p data-export-callout-copy>{isEvaluationSession ? "Label each detector attempt, then add missed dives directly from the review timeline." : "Review your session and mark the dives you want to keep. They will appear on the left when they are ready to export."}</p>
          <button class="action-link" type="button" data-export-callout-action data-open-tab="1">{isEvaluationSession ? "Open evaluation review" : "Open review"}</button>
        </div>
        <div class="export-insights__list">
          <div class="section-card__header section-card__header--subtle">
