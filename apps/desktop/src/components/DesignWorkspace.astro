      },
    };

    function currentSandboxTelemetryIdentity() {
      const sessionId = String(parsed.session?.id ?? "").trim();
      return approvedSandboxSessionMap[sessionId] ?? null;
    }

    function telemetryNow() {
      return Date.now();
    }

    function assignmentField(name) {
      return document.querySelector(`[data-assignment-input="${name}"]`);
    }

    function setAssignmentStatus(text, state = "neutral") {
      if (!assignmentStatus) return;
      assignmentStatus.textContent = text;
      assignmentStatus.setAttribute("data-state", state);
    }

    function setAssignmentControlsDisabled(disabled) {
      assignmentInputs.forEach((input) => {
        input.disabled = disabled;
      });
      if (assignmentSaveButton) assignmentSaveButton.disabled = disabled;
      if (assignmentApplyPreviousButton) assignmentApplyPreviousButton.disabled = disabled;
      if (assignmentValidateButton) assignmentValidateButton.disabled = !assignmentDraft?.draftDir;
    }

    function currentAssignmentRowKey() {
      const id = String(current?.id ?? "");
      return String(assignmentDraft?.rowKeyByCandidateId?.[id] ?? "");
    }

    function updateAssignmentDraftLine() {
      if (!assignmentDraftLine) return;
      const status = String(assignmentDraft?.discoveryStatus ?? "");
      const run = String(assignmentDraft?.requestedRun ?? "");
      const runs = Array.isArray(assignmentDraft?.availableRuns) ? assignmentDraft.availableRuns : [];
      assignmentDraftLine.hidden = false;
      if (assignmentDraft?.draftDir && run) {
        assignmentDraftLine.textContent = `Brouillon actif: ${run}`;
      } else if (status === "ambiguous") {
        assignmentDraftLine.textContent = `Plusieurs brouillons disponibles: ajoutez ?assignmentDraftRun=${runs[0] ?? "run-id"}`;
      } else if (status === "invalid_run_id") {
        assignmentDraftLine.textContent = "Brouillon refusé: identifiant non autorisé.";
      } else if (status === "not_found") {
        assignmentDraftLine.textContent = "Aucun brouillon trouvé pour cette séance.";
      } else {
        assignmentDraftLine.hidden = true;
      }
    }

    function setAssignmentFieldValue(name, value) {
      const field = assignmentField(name);
      if (!field) return;
      field.value = value == null ? "" : String(value);
      renderAssignmentInlineCompletion(name);
    }

    function normalizeAssignmentQuery(value) {
      return String(value ?? "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim()
        .replace(/\s+/g, " ");
    }

    function compactAssignmentQuery(value) {
      return normalizeAssignmentQuery(value).replace(/[^a-z0-9]/g, "");
    }

    function normalizeAssignmentHeight(value) {
      return String(value ?? "")
        .toLowerCase()
        .replace(",", ".")
        .replace(/\s*m$/, "")
        .trim();
    }

    function apparatusForAssignmentHeight(value) {
      const height = normalizeAssignmentHeight(value);
      if (height === "1" || height === "3") return "springboard";
      if (height === "5" || height === "7" || height === "10") return "platform";
      return "";
    }

    function apparatusLabelForAssignment(value) {
      if (value === "springboard") return "Tremplin";
      if (value === "platform") return "Plateforme";
      if (value === "unknown") return "Inconnu";
      return "";
    }

    function assignmentInitials(value) {
      return normalizeAssignmentQuery(value).split(" ").filter(Boolean).map((part) => part[0]).join("");
    }

    function assignmentNameParts(value) {
      return normalizeAssignmentQuery(value).split(" ").filter(Boolean);
    }

    function orderedFuzzyNameScore(label, query) {
      const compactQuery = compactAssignmentQuery(query);
      const compactLabel = compactAssignmentQuery(label);
      if (!compactQuery) return 0;
      let searchFrom = 0;
      let score = 0;
      let previousIndex = -1;
      for (const char of compactQuery) {
        const index = compactLabel.indexOf(char, searchFrom);
        if (index < 0) return 0;
        score += 12;
        if (index === 0 || /[^a-z0-9]/.test(label[index - 1] ?? "")) score += 10;
        if (previousIndex >= 0 && index === previousIndex + 1) score += 8;
        if (previousIndex >= 0 && index > previousIndex + 1) score -= Math.min(5, index - previousIndex - 1);
        previousIndex = index;
        searchFrom = index + 1;
      }
      score += Math.max(0, 16 - compactLabel.length);
      return score;
    }

    function orderedFuzzyAliasScore(item, query) {
      const aliases = Array.isArray(item.aliases) ? item.aliases : [];
      return aliases.reduce((best, alias) => Math.max(best, orderedFuzzyNameScore(alias, query)), 0);
    }

    function scoreAssignmentSuggestion(item, query) {
      const q = normalizeAssignmentQuery(query);
      const compact = compactAssignmentQuery(query);
      if (!q && !compact) return item.recent ? 40 : 10;
      const label = normalizeAssignmentQuery(item.label);
      const labelCompact = compactAssignmentQuery(item.label);
      const initials = assignmentInitials(item.label);
      const aliases = Array.isArray(item.aliases) ? item.aliases.map(normalizeAssignmentQuery) : [];
      const compactAliases = aliases.map((alias) => alias.replace(/[^a-z0-9]/g, ""));
      if (aliases.includes(q) || compactAliases.includes(compact)) return 130 + (item.recent ? 8 : 0);
      if (label === q || labelCompact === compact) return 128 + (item.recent ? 8 : 0);
      if (initials === compact) return 122 + (item.recent ? 8 : 0);
      if (aliases.some((alias) => alias.startsWith(q)) || compactAliases.some((alias) => alias.startsWith(compact))) return 112 + (item.recent ? 8 : 0);
      if (label.startsWith(q)) return 108 + (item.recent ? 8 : 0);
      if (assignmentNameParts(item.label).some((part) => part.startsWith(q))) return 102 + (item.recent ? 8 : 0);
      if (labelCompact.startsWith(compact)) return 96 + (item.recent ? 8 : 0);
      if (label.includes(q) || labelCompact.includes(compact)) return 84 + (item.recent ? 8 : 0);
      if (item.source === "Liste club" && compact.length >= 3) {
        const fuzzyScore = Math.max(orderedFuzzyNameScore(item.label, query), orderedFuzzyAliasScore(item, query));
        if (fuzzyScore > 0) return 58 + fuzzyScore + (item.recent ? 8 : 0);
      }
      if (item.recent && label.includes(q)) return 50;
      return 0;
    }

    function directAssignmentAliasMatch(item, query) {
      const q = normalizeAssignmentQuery(query);
      const compact = compactAssignmentQuery(query);
      const label = normalizeAssignmentQuery(item.label);
      const labelCompact = compactAssignmentQuery(item.label);
      const aliases = Array.isArray(item.aliases) ? item.aliases.map(normalizeAssignmentQuery) : [];
      const compactAliases = aliases.map((alias) => alias.replace(/[^a-z0-9]/g, ""));
      return Boolean(
        q && (
          label.includes(q)
          || labelCompact.includes(compact)
          || aliases.some((alias) => alias === q || alias.startsWith(q))
          || compactAliases.some((alias) => alias === compact || alias.startsWith(compact))
        )
      );
    }

    function uniqueAssignmentSuggestions(items) {
      const seen = new Set();
      return items.filter((item) => {
        const key = normalizeAssignmentQuery(item.label);
        if (!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    function assignmentSuggestionsFor(fieldName, query) {
      const recent = Array.isArray(assignmentRecentValues?.[fieldName]) ? assignmentRecentValues[fieldName] : [];
      let candidates = [];
      if (fieldName === "diver_query") {
        candidates = [
          ...assignmentKnownDivers.map((item) => ({ ...item, source: "Liste club" })),
          ...recent.map((label) => ({ label, source: "Récent", recent: true })),
          { label: "À identifier", source: "Statut" },
        ];
      } else if (fieldName === "training_group") {
        candidates = [
          ...recent.map((label) => ({ label, source: "Récent", recent: true })),
          ...assignmentKnownGroups.map((label) => ({ label, source: "Groupe club" })),
        ];
      } else if (fieldName === "dive_code") {
        candidates = [
          ...recent.map((label) => ({ label, source: "Récent", recent: true })),
          ...assignmentCommonDiveCodes.map((label) => ({ label, source: "Code" })),
          { label: "inconnu", source: "Manuel" },
        ];
      } else if (fieldName === "apparatus_height_m") {
        candidates = [
          ...recent.map((label) => ({ label, source: "Récent", recent: true })),
          ...assignmentKnownHeights.map((label) => ({
            label,
            source: apparatusForAssignmentHeight(label) === "springboard" ? "Tremplin" : "Plateforme",
          })),
        ];
      }
      return candidates
        .map((item) => ({ ...item, score: scoreAssignmentSuggestion(item, query) }))
        .map((item) => fieldName === "diver_query" && item.score === 0 && directAssignmentAliasMatch(item, query)
          ? { ...item, score: 88 }
          : item)
        .filter((item) => item.score > 0)
        .sort((a, b) => b.score - a.score || a.label.localeCompare(b.label))
        .filter((item, index, items) => items.findIndex((other) => normalizeAssignmentQuery(other.label) === normalizeAssignmentQuery(item.label)) === index)
        .slice(0, 6);
    }

    function bestAssignmentSuggestion(fieldName, query) {
      return assignmentSuggestionsFor(fieldName, query)[0] ?? null;
    }

    function renderAssignmentInlineCompletion(fieldName) {
      const ghost = document.querySelector(`[data-assignment-inline-completion="${fieldName}"]`);
      const field = assignmentField(fieldName);
      if (!ghost || !field) return;
      const query = String(field.value ?? "");
      const suggestion = assignmentInlineFields.has(fieldName) ? bestAssignmentSuggestion(fieldName, query) : null;
      const normalizedQuery = normalizeAssignmentQuery(query);
      if (!suggestion || !normalizedQuery || normalizeAssignmentQuery(suggestion.label) === normalizedQuery) {
        ghost.textContent = "";
        ghost.removeAttribute("data-completion-kind");
        return;
      }
      const label = String(suggestion.label ?? "");
      if (normalizeAssignmentQuery(label).startsWith(normalizedQuery)) {
        ghost.textContent = label;
        ghost.setAttribute("data-completion-kind", "prefix");
      } else {
        ghost.textContent = `${query}  → ${label}`;
        ghost.setAttribute("data-completion-kind", "fuzzy");
      }
    }

    function refreshAssignmentInlineCompletions() {
      assignmentInlineFields.forEach(renderAssignmentInlineCompletion);
    }

    function hideAssignmentSuggestions() {
      assignmentSuggestionBoxes.forEach((box) => {
        box.hidden = true;
        box.innerHTML = "";
      });
      assignmentInputs.forEach((input) => {
        const name = input?.getAttribute?.("data-assignment-input");
        if (name) input.setAttribute("aria-expanded", "false");
      });
      assignmentActiveSuggestionIndex = -1;
      assignmentActiveSuggestionField = "";
    }

    function renderAssignmentSuggestions(fieldName) {
      if (assignmentSuggestionSuppressOnce) {
        assignmentSuggestionSuppressOnce = false;
        return;
      }
      const field = assignmentField(fieldName);
      const box = document.querySelector(`[data-assignment-suggestions="${fieldName}"]`);
      if (!field || !box) return;
      const suggestions = assignmentSuggestionsFor(fieldName, field.value ?? "");
      box.dataset.query = field.value ?? "";
      if (suggestions.length === 0) {
        box.hidden = true;
        box.innerHTML = "";
        field.setAttribute("aria-expanded", "false");
        renderAssignmentInlineCompletion(fieldName);
        return;
      }
      assignmentActiveSuggestionField = fieldName;
      assignmentActiveSuggestionIndex = -1;
      box.innerHTML = "";
      suggestions.forEach((suggestion, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.setAttribute("data-assignment-suggestion-index", String(index));
        const label = document.createElement("span");
        label.textContent = suggestion.label;
        const source = document.createElement("small");
        source.textContent = suggestion.source;
        button.append(label, source);
        button.addEventListener("mousedown", (event) => {
          event.preventDefault();
          field.value = suggestion.label;
          markAssignmentDirty();
          renderAssignmentInlineCompletion(fieldName);
          hideAssignmentSuggestions();
        });
        box.appendChild(button);
      });
      box.hidden = false;
      field.setAttribute("aria-expanded", "true");
      renderAssignmentInlineCompletion(fieldName);
    }

    function refreshAssignmentSuggestionsForInput(input) {
      const name = input?.getAttribute?.("data-assignment-input");
      if (name === "diver_query" || name === "training_group" || name === "dive_code" || name === "apparatus_height_m") {
        window.requestAnimationFrame(() => renderAssignmentSuggestions(name));
      }
    }

    function syncApparatusFromHeight() {
      const heightField = assignmentField("apparatus_height_m");
      const apparatusField = assignmentField("apparatus_type");
      if (!heightField || !apparatusField) return;
      const apparatus = apparatusForAssignmentHeight(heightField.value);
      if (apparatus && apparatusField.value !== apparatus) {
        apparatusField.value = apparatus;
        markAssignmentDirty();
      }
      updateDerivedApparatusHint();
    }

    function updateDerivedApparatusHint() {
      if (!assignmentDerivedApparatus) return;
      const heightField = assignmentField("apparatus_height_m");
      const apparatusField = assignmentField("apparatus_type");
      const fromHeight = apparatusForAssignmentHeight(heightField?.value ?? "");
      const label = apparatusLabelForAssignment(fromHeight || apparatusField?.value || "");
      assignmentDerivedApparatus.textContent = label ? `Appareil: ${label}` : "Appareil selon la hauteur";
    }

    function moveAssignmentSuggestion(fieldName, direction) {
      const box = document.querySelector(`[data-assignment-suggestions="${fieldName}"]`);
      if (!box || box.hidden) return;
      const buttons = Array.from(box.querySelectorAll("button"));
      if (buttons.length === 0) return;
      assignmentActiveSuggestionField = fieldName;
      assignmentActiveSuggestionIndex = (assignmentActiveSuggestionIndex + direction + buttons.length) % buttons.length;
      buttons.forEach((button, index) => button.toggleAttribute("aria-selected", index === assignmentActiveSuggestionIndex));
    }

    function acceptAssignmentSuggestion(fieldName) {
      const field = assignmentField(fieldName);
      const box = document.querySelector(`[data-assignment-suggestions="${fieldName}"]`);
      if (!field || !box || box.hidden) return false;
      const buttons = Array.from(box.querySelectorAll("button"));
      const index = assignmentActiveSuggestionIndex >= 0 ? assignmentActiveSuggestionIndex : 0;
      const button = buttons[index];
      if (!button) return false;
      const label = button.querySelector("span")?.textContent ?? "";
      if (!label) return false;
      field.value = label;
      if (fieldName === "apparatus_height_m") {
        syncApparatusFromHeight();
      }
      markAssignmentDirty();
      assignmentSuggestionSuppressOnce = true;
      renderAssignmentInlineCompletion(fieldName);
      hideAssignmentSuggestions();
      return true;
    }

    function assignmentUpdatesFromFields() {
      const updates = {};
      assignmentInputs.forEach((field) => {
        const name = field.getAttribute("data-assignment-input");
        if (!name) return;
        updates[name] = field.value ?? "";
      });
      return updates;
    }

    function fillAssignmentFields(row) {
      const safeRow = row ?? {};
      setAssignmentFieldValue("diver_query", safeRow.diver_query ?? "");
      setAssignmentFieldValue("training_group", safeRow.training_group ?? "");
      setAssignmentFieldValue("apparatus_type", safeRow.apparatus_type ?? "");
      setAssignmentFieldValue("apparatus_height_m", safeRow.apparatus_height_m ?? "");
      setAssignmentFieldValue("apparatus_id", safeRow.apparatus_id ?? "");
      setAssignmentFieldValue("dive_code", safeRow.dive_code ?? "");
      setAssignmentFieldValue("assignment_status", safeRow.assignment_status || "a_identifier");
      setAssignmentFieldValue("share_status", safeRow.share_status || "a_verifier");
      setAssignmentFieldValue("notes", safeRow.notes ?? "");
      assignmentCurrentRow = safeRow;
      assignmentDirty = false;
      refreshAssignmentInlineCompletions();
      updateDerivedApparatusHint();
    }

    function resetAssignmentFields() {
      fillAssignmentFields({
        assignment_status: "a_identifier",
        share_status: "a_verifier",
      });
    }

    function markAssignmentDirty() {
      if (assignmentLoading) return;
      assignmentDirty = true;
      setAssignmentStatus("Modifications non enregistrées", "warning");
    }

    function updateAssignmentValidationCounts(result) {
      if (!assignmentValidation) return;
      assignmentValidation.hidden = false;
      const errors = Array.isArray(result?.blocking_errors) ? result.blocking_errors.length : 0;
      const warnings = Array.isArray(result?.warnings) ? result.warnings.length : 0;
      if (assignmentCounts.errors) assignmentCounts.errors.textContent = String(errors);
      if (assignmentCounts.warnings) assignmentCounts.warnings.textContent = String(warnings);
      if (assignmentCounts.packageable) assignmentCounts.packageable.textContent = String(result?.packageable_count ?? 0);
      if (assignmentCounts.aIdentifier) assignmentCounts.aIdentifier.textContent = String(result?.a_identifier_count ?? 0);
      if (assignmentCounts.aVerifier) assignmentCounts.aVerifier.textContent = String(result?.a_verifier_count ?? 0);
      if (errors > 0) {
        setAssignmentStatus("Bloqué par erreurs", "error");
      } else if (warnings > 0) {
        setAssignmentStatus("Affectations valides avec avertissements", "warning");
      } else {
        setAssignmentStatus("À vérifier avant export", "ok");
      }
    }

    function renderAssignmentRecentValues(values = {}) {
      assignmentRecentValues = values || {};
      assignmentRecentLists.forEach((list) => {
        const name = list.getAttribute("data-assignment-recent-list");
        const items = Array.isArray(values?.[name]) ? values[name] : [];
        list.innerHTML = "";
        items.forEach((value) => {
          const option = document.createElement("option");
          option.value = String(value);
          list.appendChild(option);
        });
      });
    }

    async function refreshAssignmentRecentValues() {
      if (!assignmentPanel || !assignmentDraft?.draftDir) return;
      try {
        const response = await fetch("/api/assignment-draft", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "list-recent-values",
            draftDir: assignmentDraft.draftDir,
          }),
        });
        const data = await response.json();
        if (response.ok && data?.values) {
          renderAssignmentRecentValues(data.values);
        }
      } catch {
        renderAssignmentRecentValues({});
      }
    }

    async function syncAssignmentPanelForCurrent() {
      if (!assignmentPanel) return;
      updateAssignmentDraftLine();
      if (!assignmentDraft?.draftDir) {
        resetAssignmentFields();
        setAssignmentControlsDisabled(true);
        setAssignmentStatus(assignmentDraft?.discoveryStatus === "ambiguous" ? "Brouillon à choisir" : "Brouillon non chargé", "neutral");
        return;
      }
      const rowKey = currentAssignmentRowKey();
      if (assignmentRowKeyLabel) {
        assignmentRowKeyLabel.textContent = rowKey;
        assignmentRowKeyLabel.hidden = !rowKey;
      }
      if (!rowKey) {
        resetAssignmentFields();
        setAssignmentControlsDisabled(true);
        setAssignmentStatus("Brouillon chargé · clip non lié", "warning");
        return;
      }
      assignmentLoading = true;
      setAssignmentControlsDisabled(true);
      setAssignmentStatus("Brouillon chargé", "neutral");
      try {
        const params = new URLSearchParams({
          draftDir: String(assignmentDraft.draftDir),
          rowKey,
        });
        const response = await fetch(`/api/assignment-draft?${params.toString()}`);
        const data = await response.json();
        if (!response.ok || !data?.row) {
          throw new Error(data?.error ?? "assignment_row_load_failed");
        }
        fillAssignmentFields(data.row);
        void refreshAssignmentRecentValues();
        setAssignmentControlsDisabled(false);
        setAssignmentStatus("Brouillon chargé", "ok");
      } catch (error) {
        resetAssignmentFields();
        setAssignmentControlsDisabled(true);
        setAssignmentStatus("Brouillon non chargé", "error");
      } finally {
        assignmentLoading = false;
      }
    }

    async function saveAssignmentDraftRow() {
      if (!assignmentPanel || !assignmentDraft?.draftDir) return false;
      const rowKey = currentAssignmentRowKey();
      if (!rowKey) {
        setAssignmentStatus("Brouillon chargé · clip non lié", "warning");
        return false;
      }
      setAssignmentControlsDisabled(true);
      setAssignmentStatus("Brouillon en cours", "neutral");
      const updates = assignmentUpdatesFromFields();
      try {
        const response = await fetch("/api/assignment-draft", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "update-row",
            draftDir: assignmentDraft.draftDir,
            rowKey,
            updates,
            explicitOverwriteFields: Object.keys(updates),
            lastModifiedBy: "desktop_assignment_panel_scaffold",
            assignmentSource: "desktop_assignment_panel_scaffold",
          }),
        });
        const data = await response.json();
        if (!response.ok || !data?.row) {
          throw new Error(data?.error ?? "assignment_row_save_failed");
        }
        fillAssignmentFields(data.row);
        void refreshAssignmentRecentValues();
        setAssignmentStatus("Brouillon enregistré", "ok");
        return true;
      } catch (error) {
        setAssignmentStatus("Bloqué par erreurs", "error");
        return false;
      } finally {
        setAssignmentControlsDisabled(false);
      }
    }

    function nextAssignmentDetectionFrom(fromId) {
      if (!detections.length) return null;
      const startIndex = Math.max(0, detections.findIndex((item) => item.id === fromId));
      for (let step = 1; step < detections.length; step += 1) {
        const candidate = detections[(startIndex + step) % detections.length];
        if (candidate) return candidate;
      }
      return null;
    }

    async function saveAssignmentDraftRowAndAdvance() {
      const savedId = current?.id;
      const didSave = await saveAssignmentDraftRow();
      if (!didSave || !savedId) return;
      const next = nextAssignmentDetectionFrom(savedId);
      if (!next) return;
      selectDetection(next.id, { autoplay: false, scrollQueue: true });
    }

    function isAssignmentTypingTarget(target) {
      const element = target instanceof HTMLElement ? target : null;
      if (!element) return false;
      const tag = element.tagName.toLowerCase();
      return tag === "input" || tag === "textarea" || tag === "select" || element.isContentEditable;
    }

    function formatAssignmentConflict(conflict) {
      const labels = {
        diver_query: "Plongeur",
        training_group: "Groupe",
        apparatus_type: "Appareil",
        apparatus_height_m: "Hauteur",
        apparatus_id: "Appareil",
        dive_code: "Code",
        assignment_status: "Statut",
        share_status: "Partage",
      };
      const label = labels[conflict?.field] ?? conflict?.field ?? "Champ";
      return `${label}: ${conflict?.before ?? ""} -> ${conflict?.after ?? ""}`;
    }

    async function applyPreviousAssignmentContext(confirmOverwrite = false) {
      if (!assignmentPanel || !assignmentDraft?.draftDir) return;
      const rowKey = currentAssignmentRowKey();
      if (!rowKey) {
        setAssignmentStatus("Brouillon chargé · clip non lié", "warning");
        return;
      }
      setAssignmentControlsDisabled(true);
      setAssignmentStatus("Application du précédent", "neutral");
      try {
        const response = await fetch("/api/assignment-draft", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "apply-previous",
            draftDir: assignmentDraft.draftDir,
            rowKey,
            confirmOverwrite,
            lastModifiedBy: "desktop_assignment_panel_apply_previous",
          }),
        });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data?.error ?? "assignment_apply_previous_failed");
        }
        if (data?.requires_confirmation) {
          setAssignmentControlsDisabled(false);
          const changes = Array.isArray(data.conflicts) ? data.conflicts.map(formatAssignmentConflict).join("\n") : "";
          const confirmed = window.confirm(`Appliquer le contexte précédent et remplacer les champs remplis ?\n\n${changes}`);
          if (confirmed) {
            await applyPreviousAssignmentContext(true);
          } else {
            setAssignmentStatus("Application annulée", "warning");
          }
          return;
        }
        if (!data?.row) {
          throw new Error("assignment_apply_previous_missing_row");
        }
        fillAssignmentFields(data.row);
        void refreshAssignmentRecentValues();
        setAssignmentStatus("Précédent appliqué", "ok");
      } catch (error) {
        setAssignmentStatus("Aucun précédent applicable", "warning");
      } finally {
        setAssignmentControlsDisabled(false);
      }
    }

    async function validateAssignmentDraft() {
      if (!assignmentPanel || !assignmentDraft?.draftDir || !assignmentDraft?.mobilePackage) return;
      if (assignmentDirty) {
        setAssignmentStatus("Modifications non enregistrées", "warning");
        return;
      }
      if (assignmentValidateButton) assignmentValidateButton.disabled = true;
      setAssignmentStatus("À vérifier avant export", "neutral");
      try {
        const response = await fetch("/api/assignment-draft", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "validate-preview",
            draftDir: assignmentDraft.draftDir,
            mobilePackage: assignmentDraft.mobilePackage,
            runId: "s025-panel-preview",
          }),
        });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data?.error ?? "assignment_validation_failed");
        }
        updateAssignmentValidationCounts(data);
      } catch (error) {
        updateAssignmentValidationCounts({ blocking_errors: [{}], warnings: [] });
      } finally {
        if (assignmentValidateButton) assignmentValidateButton.disabled = false;
      }
    }

    async function emitTelemetry(event) {
      const sandboxIdentity = currentSandboxTelemetryIdentity();
      const payload = Object.assign({
        schema_version: "r153_opt_in_sort_telemetry_v1",
        source: "desktop_review_ui",
        timestamp_ms: telemetryNow(),
        session_id: parsed.session?.id ?? "",
        evaluation_root: telemetryRoot,
        eligible: telemetryEligible,
        sort_enabled: sortEnabled,
        ...(sandboxIdentity ? {
          sandbox_test: true,
          sandbox_session_id: sandboxIdentity.sandbox_session_id,
          original_session_id: sandboxIdentity.original_session_id,
        } : {}),
      }, event);
      try {
        await fetch("/api/telemetry", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          cache: "no-store",
          keepalive: false,
          body: JSON.stringify({ event: payload }),
        });
      } catch (_e) {
        // Telemetry failure must not break review UI
      }
    }

    function emitRowTelemetry(eventType, candidateId, extra) {
      if (!candidateId) return;
      const supp = supportFor(candidateId);
      const cqs = supp?.candidate_quality_shadow;
      const ts = supp?.timing_semantics_shadow;
      let tgroup = null;
      if (ts && typeof ts === "object") {
        if (ts.immediate_pair_is_confirmed_on_dive) tgroup = "confirmed_on_dive_pair";
        else if (ts.immediate_pair_is_dive_labeled_event) tgroup = "dive_labeled_pair";
        else if (ts.chain_reaches_dive_labeled_event) tgroup = "rebound_chain_to_dive_labeled";
        else if (ts.immediate_pair_candidate_id && ts.immediate_pair_delta_seconds != null && Number(ts.immediate_pair_delta_seconds) <= 3.0) tgroup = "rebound_chain_to_dive_labeled";
        else if (ts.bucket === "er_isolated_representative") tgroup = "isolated_early_rebound_representative";
        else if (ts.bucket === "er_ambiguous") tgroup = "ambiguous_early_rebound";
      }
      const evt = {
        event_type: eventType,
        candidate_id: candidateId,
        current_rank: (typeof cqs?.current_rank_within_session === "number") ? cqs.current_rank_within_session : null,
        shadow_rank: (typeof cqs?.shadow_rank_within_session === "number") ? cqs.shadow_rank_within_session : null,
        timing_group: tgroup,
      };
      emitTelemetry(Object.assign(evt, extra ?? {}));
    }

    function buildUnloadSummary() {
      const durationMs = telemetrySortEnabledAt > 0 ? telemetryNow() - telemetrySortEnabledAt : 0;
      return {
        event_type: "review_sort_page_unload_summary",
        sort_ever_enabled: telemetryToggleOnCount > 0,
        toggle_on_count: telemetryToggleOnCount,
        toggle_off_count: telemetryToggleOffCount,
        decisions_while_sorted: telemetryDecisionsWhileSorted,
        filter_changes_while_sorted: telemetryFilterChangesWhileSorted,
        next_nav_while_sorted: telemetryNextWhileSorted,
        prev_nav_while_sorted: telemetryPrevWhileSorted,
        rapid_toggle_back_count: telemetryRapidToggleBacks,
        total_time_sorted_ms: durationMs,
      };
    }

    window.addEventListener("beforeunload", () => {
      const summary = buildUnloadSummary();
      freezeTelemetry(summary);
    });

    function freezeTelemetry(event) {
      const sandboxIdentity = currentSandboxTelemetryIdentity();
      const payload = Object.assign({
        schema_version: "r153_opt_in_sort_telemetry_v1",
        source: "desktop_review_ui",
        timestamp_ms: telemetryNow(),
        session_id: parsed.session?.id ?? "",
        evaluation_root: telemetryRoot,
        eligible: telemetryEligible,
        sort_enabled: sortEnabled,
        ...(sandboxIdentity ? {
          sandbox_test: true,
          sandbox_session_id: sandboxIdentity.sandbox_session_id,
          original_session_id: sandboxIdentity.original_session_id,
        } : {}),
      }, event);
      try {
        navigator.sendBeacon(
          "/api/telemetry",
          new Blob([JSON.stringify({ event: payload })], { type: "application/json" }),
        );
      } catch (_e) {
        // Best-effort
      }
    }

    // ── Shadow v2 telemetry (default-off, local-only) ──
    const shadowV2Active = String(parsed.shadowV2Telemetry ?? "") === "1";
    if (shadowV2Active) {
      emitTelemetry({
        event_type: "shadow_v2_session_loaded",
        schema_version: "r182_shadow_v2_telemetry_v1",
        v2_shadow_active: true,
      });
    }

    if (sortToggle) {
      sortToggle.addEventListener("click", () => {
        sortEnabled = !sortEnabled;
        sortToggle.setAttribute("aria-pressed", String(sortEnabled));
        sortToggle.classList.toggle("is-active", sortEnabled);
        sortToggle.textContent = sortEnabled ? "Current order" : "Experimental sort";
        if (sortEnabled) {
          telemetryToggleOnCount += 1;
          telemetrySortEnabledAt = telemetryNow();
          emitTelemetry({ event_type: "review_sort_toggle_enabled" });
        } else {
          telemetryToggleOffCount += 1;
          const durationMs = telemetrySortEnabledAt > 0 ? telemetryNow() - telemetrySortEnabledAt : 0;
          if (durationMs < 5000) telemetryRapidToggleBacks += 1;
          emitTelemetry({ event_type: "review_sort_toggle_disabled", duration_sorted_ms: durationMs });
        }
        if (!tableBody) return;
        rows = Array.from(tableBody.querySelectorAll("tr"));
        const rowData = rows.map((row) => ({
          el: row,
          sr: parseFloat(row.getAttribute("data-shadow-rank") ?? "999"),
          cr: parseFloat(row.getAttribute("data-shadow-rank-cur") ?? "999"),
        }));
        if (sortEnabled) {
          rowData.sort((a, b) => a.sr - b.sr);
        } else {
          rowData.sort((a, b) => a.cr - b.cr);
        }
        rowData.forEach((rd) => tableBody.appendChild(rd.el));
        applyQueueFilter();
        const firstRow = tableBody.querySelector("tr:not([hidden])");
        if (firstRow) {
          const firstId = firstRow.getAttribute("data-focus-detection");
          if (firstId) selectDetection(firstId, { autoplay: false, scrollQueue: false });
        }
      });
    }
    // Page-load telemetry: toggle visible or session ineligible
    if (isEvaluationSession()) {
      if (telemetryEligible) {
        emitTelemetry({ event_type: "review_sort_toggle_visible" });
      } else {
        emitTelemetry({ event_type: "review_sort_session_ineligible" });
      }
    }
    let previousSidebarMode = reviewSidebar?.getAttribute("data-sidebar-mode") ?? "review";
    let timelineLayoutFrame = null;
    let playbackUiFrame = null;
    let splashCueFired = false;
    let splashCueLastTime = null;
    let splashCueResetTimer = null;
    let splashPauseEnabled = false;

    try {
      const savedRefinementState = JSON.parse(window.localStorage.getItem(refinementReviewStorageKey) ?? "[]");
      if (Array.isArray(savedRefinementState)) {
        refinementReviewedKeys = new Set(savedRefinementState.map((value) => String(value)));
      }
    } catch {
      refinementReviewedKeys = new Set();
    }

    function sessionMode() {
      return parsed.sessionMode ?? parsed.session?.mode ?? "standard";
    }

    function setSidebarMode(mode, options = {}) {
      if (!reviewSidebar) return;
      const nextMode = String(mode || "review");
      const currentMode = reviewSidebar.getAttribute("data-sidebar-mode") ?? "review";
      if (!options.fromGuide && currentMode !== "guide") {
        previousSidebarMode = currentMode;
      }
      reviewSidebar.setAttribute("data-sidebar-mode", nextMode);
      sidebarModeButtons.forEach((button) => {
        const isActive = button.getAttribute("data-sidebar-mode-target") === nextMode;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
      sidebarPanels.forEach((panel) => {
        const isActive = panel.getAttribute("data-sidebar-panel") === nextMode;
        panel.hidden = !isActive;
      });
    }

    function isEvaluationSession() {
      return sessionMode() === "evaluation";
    }

    function positiveDecisionLabel() {
      return isEvaluationSession() ? "dive" : "keep";
    }

    function negativeDecisionLabel() {
      return isEvaluationSession() ? "non_dive" : "reject";
    }

    function falseNegativeOrdinalFor(annotationId) {
      const sortedFalseNegatives = falseNegativeAnnotations
        .slice()
        .sort((a, b) => Number(a.timestampSeconds ?? 0) - Number(b.timestampSeconds ?? 0));
      const index = sortedFalseNegatives.findIndex((annotation) => annotation.id === annotationId);
      return index >= 0 ? index + 1 : null;
    }

    setSidebarMode(reviewSidebar?.getAttribute("data-sidebar-mode") ?? "review", { fromGuide: true });

    document.querySelectorAll("[data-timing-scroll-to]").forEach((span) => {
      span.addEventListener("click", (event) => {
        event.preventDefault();
        const groupKey = span.getAttribute("data-timing-scroll-to");
        if (!groupKey) return;
        jumpToTimingGroup(groupKey);
      });
    });

    function falseNegativeLabelFor(item) {
      const ordinal = falseNegativeOrdinalFor(String(item?.id ?? ""));
      return ordinal != null ? `FN ${String(ordinal).padStart(2, "0")}` : "FN";
    }

    function falseNegativeQueueCandidates(queueSuggestion = "") {
      return detections.filter((item) => {
        if (!String(item.id).startsWith("fn-")) return false;
        if (!queueSuggestion) return true;
        const support = supportFor(item.id);
        return String(support?.suggested_event_label ?? "") === queueSuggestion;
      });
    }

    function hydrateFalseNegativeDetection(annotation, index) {
      return {
        id: annotation.id,
        index,
        entry_type: "false_negative",
        timestamp_seconds: Number(annotation.timestampSeconds ?? 0),
        start_time_seconds: Number(annotation.reviewStartSeconds ?? Math.max(0, Number(annotation.timestampSeconds ?? 0) - 2)),
        end_time_seconds: Number(annotation.reviewEndSeconds ?? Number(annotation.timestampSeconds ?? 0) + 2),
        duration_seconds: Math.max(0.5, Number(annotation.reviewEndSeconds ?? 0) - Number(annotation.reviewStartSeconds ?? 0)),
        review_start_seconds: Number(annotation.reviewStartSeconds ?? Math.max(0, Number(annotation.timestampSeconds ?? 0) - 2)),
        review_end_seconds: Number(annotation.reviewEndSeconds ?? Number(annotation.timestampSeconds ?? 0) + 2),
        review_duration_seconds: Math.max(0.5, Number(annotation.reviewEndSeconds ?? 0) - Number(annotation.reviewStartSeconds ?? 0)),
        confidence: "medium",
        scores: {
          audio: 0,
          video: 0,
          combined: 0,
          audio_model_probability: 0,
          audio_clip_probability: 0,
        },
        features: {},
        clip: {
          path: null,
          browser_path: null,
          filename: null,
        },
        reviewClipPath: null,
        notes: annotation.notes ?? "",
        subtype: annotation.subtype ?? "",
        eventLabel: annotation.eventLabel ?? null,
        candidateUsefulness: annotation.candidateUsefulness ?? null,
        clipQuality: annotation.clipQuality ?? null,
        anchorQuality: annotation.anchorQuality ?? null,
      };
    }

    function rebuildDetections() {
      const synthesized = falseNegativeAnnotations.map((annotation, index) =>
        hydrateFalseNegativeDetection(annotation, baseDetections.length + index + 1)
      );
      detections = [...baseDetections, ...synthesized].sort((a, b) => a.timestamp_seconds - b.timestamp_seconds);
      if (current) {
        current = detections.find((item) => item.id === current.id) ?? detections[0] ?? null;
      } else {
        current = detections[0] ?? null;
      }
    }

    function syncTabInUrl(index, mode = "replace") {
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set("tab", String(index));
      if (mode === "push") {
        window.history.pushState({}, "", nextUrl.toString());
        return;
      }
      window.history.replaceState({}, "", nextUrl.toString());
    }

    function syncSessionAndFocus(sessionId, focusId) {
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set("session", sessionId);
      nextUrl.searchParams.set("tab", "1");
      if (focusId) {
        nextUrl.searchParams.set("focus", focusId);
      } else {
        nextUrl.searchParams.delete("focus");
      }
      window.location.href = nextUrl.toString();
    }

    function getActiveTabIndex() {
      return Number.isInteger(currentTabIndex) ? currentTabIndex : 0;
    }

    function setTab(index) {
      currentTabIndex = index;
      tabButtons.forEach((button, buttonIndex) => button.classList.toggle("is-active", buttonIndex === index));
      panels.forEach((panel, panelIndex) => panel.classList.toggle("is-active", panelIndex === index));
      syncTabInUrl(index);
    }

    function formatSeconds(value) {
      const minutes = Math.floor(value / 60);
      const seconds = value - minutes * 60;
      return `${minutes}:${seconds.toFixed(3).padStart(6, "0")}`;
    }

    function reviewStartFor(item) {
      return Number(item?.review_start_seconds ?? item?.start_time_seconds ?? 0);
    }

    function reviewEndFor(item) {
      const fallbackStart = reviewStartFor(item);
      return Number(item?.review_end_seconds ?? item?.end_time_seconds ?? fallbackStart + 0.5);
    }

    function signalLabelFor(item) {
      if (!item) return "Check";
      if (item.entry_type === "false_negative") return "Manual";
      if (item.confidence === "high") return "Strong";
      if (item.confidence === "medium") return "Check";
      return "Low";
    }

    function decisionFor(detectionId) {
      if (String(detectionId).startsWith("fn-")) return null;
      return decisions.find((entry) => entry.detectionId === detectionId) ?? null;
    }

    function upsertDecisionSnapshot(decision) {
      if (!decision?.detectionId) return;
      const nextDecision = {
        ...decision,
        eventLabel: decision.eventLabel ?? null,
        subtype: decision.subtype ?? null,
        candidateUsefulness: decision.candidateUsefulness ?? null,
        clipQuality: decision.clipQuality ?? null,
        anchorQuality: decision.anchorQuality ?? null,
        notes: decision.notes ?? "",
      };
      const existingIndex = decisions.findIndex((entry) => entry.detectionId === nextDecision.detectionId);
      if (existingIndex >= 0) {
        decisions.splice(existingIndex, 1, {
          ...decisions[existingIndex],
          ...nextDecision,
        });
      } else {
        decisions.unshift(nextDecision);
      }
    }

    function queueKeyForNode(node) {
      const sessionId = String(node?.getAttribute("data-queue-session") ?? "");
      const candidateId = String(node?.getAttribute("data-queue-candidate") ?? "");
      const queueIndex = String(node?.getAttribute("data-queue-index") ?? "");
      return `${sessionId}::${candidateId || "manual"}::${queueIndex}`;
    }

    function persistRefinementReviewedKeys() {
      if (cleanupQueueActive) return;
      try {
        window.localStorage.setItem(refinementReviewStorageKey, JSON.stringify(Array.from(refinementReviewedKeys)));
      } catch {}
    }

    function cleanupValueFromDecision(decision, field) {
      if (!decision) return "";
      if (field === "review") return String(decision.label ?? "");
      if (field === "event") return String(decision.eventLabel ?? "");
      if (field === "anchor") return anchorQualityValue(decision.anchorQuality);
      if (field === "usefulness") return String(decision.candidateUsefulness ?? "");
      if (field === "clip") return String(decision.clipQuality?.clip_quality ?? "");
      return "";
    }

    function cleanupNodeState(node) {
      const queueSession = String(node?.getAttribute("data-queue-session") ?? "");
      const queueCandidate = String(node?.getAttribute("data-queue-candidate") ?? "");
      const sameSession = queueSession === String(parsed.requestedSession ?? "");
      const liveDecision = sameSession && queueCandidate ? decisionFor(queueCandidate) : null;
      return {
        review: cleanupValueFromDecision(liveDecision, "review") || String(node?.getAttribute("data-queue-cleanup-review-label") ?? ""),
        event: cleanupValueFromDecision(liveDecision, "event") || String(node?.getAttribute("data-queue-cleanup-event-label") ?? ""),
        anchor: cleanupValueFromDecision(liveDecision, "anchor") || String(node?.getAttribute("data-queue-cleanup-anchor-quality") ?? ""),
        usefulness: cleanupValueFromDecision(liveDecision, "usefulness") || String(node?.getAttribute("data-queue-cleanup-usefulness") ?? ""),
        clip: cleanupValueFromDecision(liveDecision, "clip") || String(node?.getAttribute("data-queue-cleanup-clip-quality") ?? ""),
      };
    }

    function cleanupNodeComplete(node) {
      const state = cleanupNodeState(node);
      return [state.review, state.event, state.anchor, state.usefulness, state.clip].every((value) => String(value ?? "").trim().length > 0);
    }

    function isQueueNodeReviewed(node) {
      if (cleanupQueueActive) return cleanupNodeComplete(node);
      return refinementReviewedKeys.has(queueKeyForNode(node));
    }

    function setQueueNodeReviewed(node, reviewed = true) {
      if (cleanupQueueActive) return;
      const key = queueKeyForNode(node);
      if (!key) return;
      if (reviewed) {
        refinementReviewedKeys.add(key);
      } else {
        refinementReviewedKeys.delete(key);
      }
      persistRefinementReviewedKeys();
    }

    function queueNodeForDetection(detectionId = current?.id) {
      const currentId = String(detectionId ?? "");
      return queueNodes.find((node) => {
        const queueSession = String(node.getAttribute("data-queue-session") ?? "");
        const queueCandidate = String(node.getAttribute("data-queue-candidate") ?? "");
        if (queueSession !== String(parsed.requestedSession ?? "")) return false;
        if (currentId.startsWith("fn-")) {
          return !queueCandidate || queueCandidate === "None";
        }
        return queueCandidate === currentId;
      }) ?? null;
    }

    function nextRefinementQueueNode(afterNode) {
      if (!queueNodes.length) return null;
      const startIndex = Math.max(0, queueNodes.findIndex((node) => node === afterNode));
      for (let step = 1; step <= queueNodes.length; step += 1) {
        const node = queueNodes[(startIndex + step) % queueNodes.length];
        if (!isQueueNodeReviewed(node)) return node;
      }
      return null;
    }

    function formatQueueLabel(value, fallback = "unlabeled") {
      const normalized = String(value ?? "").trim();
      return (normalized || fallback).replaceAll("_", " ");
    }

    function updateQueueNodeSnapshot(node) {
      const finalLabelNode = node.querySelector("[data-queue-final-label]");
      const statusNode = node.querySelector("[data-queue-status]");
      const queueSession = String(node.getAttribute("data-queue-session") ?? "");
      const queueCandidate = String(node.getAttribute("data-queue-candidate") ?? "");
      const queueFinalLabel = String(node.getAttribute("data-queue-label") ?? "");
      if (cleanupQueueActive) {
        const cleanupState = cleanupNodeState(node);
        if (finalLabelNode) {
          finalLabelNode.textContent = `Review ${formatQueueLabel(cleanupState.review, "unlabeled")}`;
        }
        if (statusNode) {
          statusNode.textContent = cleanupNodeComplete(node) ? "Complete" : "Needs labels";
        }
        return;
      }
      let liveFinalLabel = queueFinalLabel;
      if (queueSession === String(parsed.requestedSession ?? "") && queueCandidate && queueCandidate !== "None") {
        liveFinalLabel = String(decisionFor(queueCandidate)?.eventLabel ?? queueFinalLabel ?? "");
      }
      if (finalLabelNode) {
        finalLabelNode.textContent = `Final ${formatQueueLabel(liveFinalLabel)}`;
      }
      if (statusNode) {
        statusNode.textContent = isQueueNodeReviewed(node) ? "Reviewed" : "Pending";
      }
    }

    function supportFor(detectionId) {
      const supportRows = Array.isArray(parsed.eventReviewSupportRows) ? parsed.eventReviewSupportRows : [];
      if (String(detectionId).startsWith("fn-")) {
        const currentItem = detections.find((item) => item.id === detectionId);
        if (!currentItem) return null;
        return supportRows.find((item) =>
          item.is_false_negative_window === true &&
          Math.abs(Number(item.event_anchor_timestamp_seconds ?? -1) - Number(currentItem.timestamp_seconds ?? 0)) < 0.02
        ) ?? null;
      }
      return supportRows.find((item) => String(item.legacy_candidate_id ?? "") === String(detectionId)) ?? null;
    }

    function anchorQualityValue(anchorQuality) {
      return String(anchorQuality?.anchor_quality ?? anchorQuality?.anchorQuality ?? "");
    }

    function anchorQualityFromSuggestion(item) {
      const support = supportFor(item?.id);
      return item?.anchorQuality
        ?? item?.anchor_quality
        ?? support?.anchor_quality_suggestion
        ?? support?.anchor_quality
        ?? null;
    }

    function setAnchorQualityDetail(item, decision = null) {
      void item;
      void decision;
    }

    function syncEventSupportUi(currentId) {
      const support = supportFor(currentId);
      const suggestedEventLabel = String(support?.suggested_event_label ?? "");
      if (eventLabelSelect && !eventLabelSelect.value) {
        eventLabelSelect.value = suggestedEventLabel || "uncertain";
      }
    }

    function decisionLabelFor(detectionId) {
      if (String(detectionId).startsWith("fn-")) return "false_negative";
      return decisionFor(detectionId)?.label ?? "pending";
    }

    function approveReviewScoreFor(item) {
      const score = Number(item?.scores?.audio_model_probability);
      return Number.isFinite(score) ? score : null;
    }

    function approveReviewLaneFor(item) {
      const threshold = Number(approveReviewPolicy?.approve_min_score ?? Number.POSITIVE_INFINITY);
      const score = approveReviewScoreFor(item);
      return score !== null && score >= threshold ? "auto_approved" : "needs_review";
    }

    function displayDecisionLabelFor(item) {
      const manualDecision = decisionLabelFor(item?.id);
      if (manualDecision !== "pending") return formatQueueLabel(manualDecision, "pending");
      return formatQueueLabel(approveReviewLaneFor(item), "needs review");
    }

    function formatPolicyScore(item) {
      const score = approveReviewScoreFor(item);
      return score === null ? "n/a" : score.toFixed(3);
    }

    function shadowRankFor(item) {
      return item?.shadow_rank ?? item?.ranking_shadow ?? null;
    }

    function formatShadowRank(item) {
      const shadow = shadowRankFor(item);
      if (!shadow) return "Shadow rank: audio embedding unavailable";
      const valid = shadow.valid !== false && shadow.score != null;
      if (!valid) return `Shadow rank: ${shadow.status ?? "invalid"} · research only`;
      const rank = shadow.rank != null ? `#${shadow.rank}` : "unranked";
      return `Shadow rank: audio embedding ${rank} · ${Number(shadow.score).toFixed(3)} · research only`;
    }

    function candidateQualityShadowFor(item) {
      const support = supportFor(item?.id);
      return support?.candidate_quality_shadow ?? null;
    }

    function formatCandidateQualityShadow(item) {
      const shadow = candidateQualityShadowFor(item);
      if (!shadow) return "Shadow review relevance: unavailable";
      if (shadow.valid !== true || shadow.score_keep == null) {
        return `Shadow review relevance: ${shadow.status ?? "not scored"} · telemetry only`;
      }
      const bucket = String(shadow.recommended_shadow_bucket ?? "unknown").replaceAll("_", " ");
      const delta = Number(shadow.rank_delta ?? 0);
      const deltaText = delta > 0 ? `promote +${delta}` : delta < 0 ? `deprioritize ${delta}` : "no rank change";
      return `Shadow review relevance: ${bucket} · keep ${Number(shadow.score_keep).toFixed(3)} · ${deltaText} · telemetry only`;
    }

    function timingSemanticsFor(item) {
      const support = supportFor(item?.id);
      const ts = support?.timing_semantics_shadow ?? null;
      if (!ts || typeof ts !== "object") return null;
      return ts;
    }

    function timingGroupKeyFor(item) {
      const ts = timingSemanticsFor(item);
      if (!ts) return "";
      if (ts.immediate_pair_is_confirmed_on_dive) return "confirmed_on_dive_pair";
      if (ts.immediate_pair_is_dive_labeled_event) return "dive_labeled_pair";
      if (ts.chain_reaches_dive_labeled_event) return "rebound_chain_to_dive_labeled";
      if (ts.immediate_pair_candidate_id && ts.immediate_pair_delta_seconds != null && Number(ts.immediate_pair_delta_seconds) <= 3.0) {
        return "rebound_chain_to_dive_labeled";
      }
      if (ts.bucket === "er_isolated_representative") return "isolated_early_rebound_representative";
      if (ts.bucket === "er_ambiguous") return "ambiguous_early_rebound";
      return "";
    }

    function timingTooltipForItem(item) {
      const ts = timingSemanticsFor(item);
      if (!ts) return "";
      const pairId = String(ts.immediate_pair_candidate_id ?? "");
      const delta = ts.immediate_pair_delta_seconds != null ? Number(ts.immediate_pair_delta_seconds).toFixed(2) : "";
      const termId = String(ts.chain_terminal_candidate_id ?? "");
      const termDelta = ts.chain_terminal_delta_seconds != null ? Number(ts.chain_terminal_delta_seconds).toFixed(2) : "";
      const hops = ts.chain_hops_to_dive_labeled_event != null ? Number(ts.chain_hops_to_dive_labeled_event) : "";
      if (ts.immediate_pair_is_confirmed_on_dive) return `On-dive pair: paired with confirmed on-dive candidate ${pairId} (${delta}s)`;
      if (ts.immediate_pair_is_dive_labeled_event) return `Dive-labeled pair: not confirmed on-dive · paired with ${pairId} (${delta}s)`;
      if (ts.chain_reaches_dive_labeled_event) return `Chain to dive: reaches ${termId} (${termDelta}s, ${hops} hops) · not guaranteed same dive`;
      if (ts.immediate_pair_candidate_id && ts.immediate_pair_delta_seconds != null && Number(ts.immediate_pair_delta_seconds) <= 3.0) {
        return `Chain to next: paired with non-dive ${pairId} (${delta}s) · not guaranteed same dive`;
      }
      if (ts.bucket === "er_isolated_representative") return "Useful isolated: no nearby pair or chain";
      if (ts.bucket === "er_ambiguous") return "Needs review: cannot auto-classify · needs human judgment";
      return "";
    }

    function formatTimingSemantics(item) {
      const ts = timingSemanticsFor(item);
      if (!ts) return null;
      const pairId = String(ts.immediate_pair_candidate_id ?? "");
      const delta = ts.immediate_pair_delta_seconds != null ? Number(ts.immediate_pair_delta_seconds).toFixed(2) : "";
      const termId = String(ts.chain_terminal_candidate_id ?? "");
      const termDelta = ts.chain_terminal_delta_seconds != null ? Number(ts.chain_terminal_delta_seconds).toFixed(2) : "";
      const hops = ts.chain_hops_to_dive_labeled_event != null ? Number(ts.chain_hops_to_dive_labeled_event) : "";
      if (ts.immediate_pair_is_confirmed_on_dive) return `on-dive pair · ${pairId} · ${delta}s`;
      if (ts.immediate_pair_is_dive_labeled_event) return `dive-labeled pair · ${pairId} · ${delta}s`;
      if (ts.chain_reaches_dive_labeled_event) return `chain to dive · ${termId} · ${termDelta}s · ${hops} hops`;
      if (ts.immediate_pair_candidate_id && ts.immediate_pair_delta_seconds != null && Number(ts.immediate_pair_delta_seconds) <= 3.0) return `chain to next · ${pairId} · ${delta}s`;
      if (ts.bucket === "er_isolated_representative") return "useful isolated";
      if (ts.bucket === "er_ambiguous") return "needs review";
      return null;
    }

    function setTimingSemanticsDetail(item) {
      void item;
    }

    function isUnresolvedDecision(label) {
      return label === "pending" || label === "unsure";
    }

    function pendingDecisionCount() {
      return baseDetections.filter((item) => decisionLabelFor(item.id) === "pending").length;
    }

    function unresolvedDecisionCount() {
      return unresolvedDetections().length;
    }

    function dismissReviewCompleteNotice() {
      if (reviewCompleteNoticeTimer != null) {
        window.clearTimeout(reviewCompleteNoticeTimer);
        reviewCompleteNoticeTimer = null;
      }
      reviewCompleteNoticeDismissed = true;
      if (reviewCompleteNotice) {
        reviewCompleteNotice.hidden = true;
      }
    }

    function keptDetections() {
      return baseDetections.filter((item) => decisionLabelFor(item.id) === positiveDecisionLabel());
    }

    function syncCurrentDecisionUi() {
      if (!current) return;
      const currentDecision = decisionFor(current.id);
      if (currentDecision) {
        decisionStatus && (decisionStatus.textContent = `Saved ${currentDecision.label} for ${currentDecision.detectionId}.`);
        decisionDetailLabel && (decisionDetailLabel.textContent = `Decision ${currentDecision.label}`);
        if (decisionNotes) decisionNotes.value = currentDecision.notes ?? "";
        if (decisionSubtype) decisionSubtype.value = currentDecision.subtype ?? "";
        if (eventLabelSelect) {
          eventLabelSelect.value = String(currentDecision.eventLabel ?? "");
        }
        if (candidateUsefulnessSelect) candidateUsefulnessSelect.value = String(currentDecision.candidateUsefulness ?? "");
        if (clipQualitySelect) clipQualitySelect.value = String(currentDecision.clipQuality?.clip_quality ?? "");
        if (anchorQualitySelect) anchorQualitySelect.value = anchorQualityValue(currentDecision.anchorQuality);
        setAnchorQualityDetail(current, currentDecision);
        if (shadowRankDetailLabel) shadowRankDetailLabel.textContent = formatShadowRank(current);
        if (candidateQualityShadowDetailLabel) candidateQualityShadowDetailLabel.textContent = formatCandidateQualityShadow(current);
        setTimingSemanticsDetail(current);
        syncEventSupportUi(current.id);
        return;
      }
      if (String(current?.id ?? "").startsWith("fn-")) {
        decisionStatus && (decisionStatus.textContent = "Manual false negative annotation.");
        decisionDetailLabel && (decisionDetailLabel.textContent = "Decision false_negative");
        if (decisionNotes) decisionNotes.value = String(current?.notes ?? "");
        if (decisionSubtype) decisionSubtype.value = String(current?.subtype ?? "");
        if (eventLabelSelect) eventLabelSelect.value = String(current?.eventLabel ?? "");
        if (candidateUsefulnessSelect) candidateUsefulnessSelect.value = String(current?.candidateUsefulness ?? "");
        if (clipQualitySelect) clipQualitySelect.value = String(current?.clipQuality?.clip_quality ?? "");
        if (anchorQualitySelect) anchorQualitySelect.value = anchorQualityValue(current?.anchorQuality);
        setAnchorQualityDetail(current, current?.anchorQuality ? { anchorQuality: current.anchorQuality } : null);
        if (shadowRankDetailLabel) shadowRankDetailLabel.textContent = formatShadowRank(current);
        if (candidateQualityShadowDetailLabel) candidateQualityShadowDetailLabel.textContent = formatCandidateQualityShadow(current);
        setTimingSemanticsDetail(current);
        syncEventSupportUi(current.id);
        return;
      }
      decisionStatus && (decisionStatus.textContent = "No decision saved for this attempt.");
      decisionDetailLabel && (decisionDetailLabel.textContent = `Policy ${approveReviewLaneFor(current).replace("_", " ")} · score ${formatPolicyScore(current)}`);
      if (decisionNotes) decisionNotes.value = "";
      if (decisionSubtype) decisionSubtype.value = "";
      if (eventLabelSelect) eventLabelSelect.value = "";
      if (candidateUsefulnessSelect) candidateUsefulnessSelect.value = "";
      if (clipQualitySelect) clipQualitySelect.value = "";
      if (anchorQualitySelect) anchorQualitySelect.value = "";
      setAnchorQualityDetail(current, null);
      if (shadowRankDetailLabel) shadowRankDetailLabel.textContent = formatShadowRank(current);
      if (candidateQualityShadowDetailLabel) candidateQualityShadowDetailLabel.textContent = formatCandidateQualityShadow(current);
      setTimingSemanticsDetail(current);
      syncEventSupportUi(current.id);
    }

    function applyUsefulnessAutofill() {
      if (!isEvaluationSession()) return;
      const usefulness = candidateUsefulnessSelect?.value?.trim() || "";
      const eventLabel = eventLabelSelect?.value?.trim() || "";
      const subtype = decisionSubtype?.value?.trim() || "";
      if (usefulness === "wrong_event") {
        if (clipQualitySelect && !clipQualitySelect.value) {
          clipQualitySelect.value = "wrong_event";
        }
        if (anchorQualitySelect && !anchorQualitySelect.value) {
          anchorQualitySelect.value = "wrong_event";
        }
        return;
      }
      if (usefulness === "too_early_or_late" && eventLabel === "springboard_rebound_only") {
        if (clipQualitySelect && !clipQualitySelect.value) {
          clipQualitySelect.value = "too_early";
        }
        if (anchorQualitySelect && !anchorQualitySelect.value) {
          anchorQualitySelect.value = "early_rebound";
        }
      }
      if (eventLabel === "springboard_dive" && subtype === "board_rebound") {
        if (candidateUsefulnessSelect && !candidateUsefulnessSelect.value) {
          candidateUsefulnessSelect.value = "useful_clip";
        }
        if (clipQualitySelect && !clipQualitySelect.value) {
          clipQualitySelect.value = "too_early";
        }
        if (anchorQualitySelect && !anchorQualitySelect.value) {
          anchorQualitySelect.value = "early_rebound";
        }
        return;
      }
      if (eventLabel === "springboard_dive" && !subtype) {
        if (candidateUsefulnessSelect && !candidateUsefulnessSelect.value) {
          candidateUsefulnessSelect.value = "useful_clip";
        }
        if (clipQualitySelect && !clipQualitySelect.value) {
          clipQualitySelect.value = "good";
        }
        if (anchorQualitySelect && !anchorQualitySelect.value) {
          anchorQualitySelect.value = "on_dive";
        }
      }
    }

    function updateRefinementQueueState() {
      queueNodes.forEach((node) => {
        const queueSession = String(node.getAttribute("data-queue-session") ?? "");
        const queueCandidate = String(node.getAttribute("data-queue-candidate") ?? "");
        const sameSession = queueSession === String(parsed.requestedSession ?? "");
        const sameCandidate = queueCandidate && queueCandidate !== "None"
          ? queueCandidate === String(current?.id ?? "")
          : String(current?.id ?? "").startsWith("fn-");
        node.classList.toggle("is-current", Boolean(sameSession && sameCandidate));
        node.classList.toggle("is-reviewed", isQueueNodeReviewed(node));
        updateQueueNodeSnapshot(node);
      });
      updateCleanupQueueProgress();
    }

    function updateCleanupQueueProgress() {
      if (!cleanupQueueActive) return;
      const totalNode = document.querySelector("[data-cleanup-total]");
      const completedNode = document.querySelector("[data-cleanup-completed]");
      const remainingNode = document.querySelector("[data-cleanup-remaining]");
      const positionNode = document.querySelector("[data-cleanup-current-position]");
      const total = queueNodes.length;
      const completed = queueNodes.filter((node) => cleanupNodeComplete(node)).length;
      const remaining = total - completed;
      if (totalNode) totalNode.textContent = String(total);
      if (completedNode) completedNode.textContent = String(completed);
      if (remainingNode) remainingNode.textContent = String(remaining);
      if (positionNode) {
        const currentIndex = Math.max(0, queueNodes.findIndex((node) => node.classList.contains("is-current")));
        positionNode.textContent = String(total > 0 ? currentIndex + 1 : 0);
      }
    }

    function moveRefinementQueueForwardAfterSave(savedDetectionId, label) {
      const activeQueueNode = queueNodeForDetection(savedDetectionId);
      if (!activeQueueNode) return false;
      setQueueNodeReviewed(activeQueueNode, true);
      updateRefinementQueueState();
      const nextQueueNode = nextRefinementQueueNode(activeQueueNode);
      if (!nextQueueNode) {
        decisionStatus && (decisionStatus.textContent = `Saved ${label} for ${savedDetectionId}. Refinement checklist complete.`);
        return true;
      }
      decisionStatus && (decisionStatus.textContent = `Saved ${label} for ${savedDetectionId}. Moving to the next refinement row.`);
      focusDetectionByQueue(nextQueueNode);
      return true;
    }

    function updateReviewCompleteNotice() {
      if (!reviewCompleteNotice) return;
      const unresolvedCount = unresolvedDecisionCount();
      const acceptedCount = baseDetections.filter((item) => decisionLabelFor(item.id) === positiveDecisionLabel()).length;
      if (unresolvedCount > 0 || baseDetections.length === 0) {
        if (reviewCompleteNoticeTimer != null) {
          window.clearTimeout(reviewCompleteNoticeTimer);
          reviewCompleteNoticeTimer = null;
        }
        reviewCompleteNotice.hidden = true;
        reviewCompleteNoticeDismissed = false;
        return;
      }
      if (reviewCompleteNoticeDismissed) {
        reviewCompleteNotice.hidden = true;
        return;
      }
      reviewCompleteNotice.hidden = false;
      reviewCompleteNotice.classList.remove("is-timed");
      void reviewCompleteNotice.offsetWidth;
      reviewCompleteNotice.classList.add("is-timed");
      if (reviewCompleteTitle) {
        reviewCompleteTitle.textContent = isEvaluationSession()
          ? "Evaluation review complete"
          : acceptedCount > 0 ? "Review complete" : "Queue complete";
      }
      if (reviewCompleteCopy) {
        if (isEvaluationSession()) {
          const falseNegativeCount = falseNegativeAnnotations.length;
          reviewCompleteCopy.textContent = `You finished reviewing every detector attempt. ${acceptedCount} dive${acceptedCount === 1 ? "" : "s"} confirmed, ${falseNegativeCount} false negative${falseNegativeCount === 1 ? "" : "s"} logged.`;
        } else {
          reviewCompleteCopy.textContent = acceptedCount > 0
            ? `You finished reviewing every attempt. ${acceptedCount} clip${acceptedCount === 1 ? "" : "s"} ${acceptedCount === 1 ? "is" : "are"} ready to export.`
            : "You finished reviewing every attempt. Nothing is marked Keep yet, so there is nothing to export right now.";
        }
      }
      if (reviewCompleteExportButton) {
        reviewCompleteExportButton.disabled = !isEvaluationSession() && acceptedCount === 0;
      }
      if (reviewCompleteNoticeTimer != null) {
        window.clearTimeout(reviewCompleteNoticeTimer);
      }
      reviewCompleteNoticeTimer = window.setTimeout(() => {
        dismissReviewCompleteNotice();
      }, 5500);
    }

    function updateReviewCounts() {
      const keepCount = baseDetections.filter((item) => decisionLabelFor(item.id) === positiveDecisionLabel()).length;
      const unsureCount = baseDetections.filter((item) => decisionLabelFor(item.id) === "unsure").length;
      const pendingCount = pendingDecisionCount();
      const unresolvedCount = pendingCount + unsureCount;
      const exportedCount = exportedPaths.length;
      const readyToExportCount = Math.max(0, keepCount - exportedCount);
      if (exportStatReady) exportStatReady.textContent = String(readyToExportCount);
      if (exportStatExported) exportStatExported.textContent = String(exportedCount);
      if (exportStatReview) exportStatReview.textContent = String(isEvaluationSession() ? falseNegativeAnnotations.length : unresolvedCount);
      if (exportButton) {
        exportButton.disabled = keepCount === 0;
      }
      updateReviewCompleteNotice();
    }

    function updateToggleButtons() {
      if (loopButton) loopButton.textContent = loopEnabled ? "Loop on" : "Loop off";
      if (autoplayButton) autoplayButton.textContent = autoPlayEnabled ? "Autoplay on" : "Autoplay off";
      if (autoAdvanceButton) autoAdvanceButton.textContent = autoAdvanceEnabled ? "Auto-next on" : "Auto-next off";
    }

    function updateQueueNavigationState() {
      const disabled = detections.length === 0;
      if (previousButton) previousButton.disabled = disabled;
      if (nextButton) nextButton.disabled = disabled;
    }

    function updateSplashPauseButton() {
      if (!splashPauseButton) return;
      splashPauseButton.textContent = splashPauseEnabled ? "Pause at splash on" : "Pause at splash off";
    }

    function resetSplashCueCycle() {
      splashCueFired = false;
      splashCueLastTime = null;
    }

    function flashSplashCueUi() {
      if (!current) return;
      const activeQueueRows = Array.from(document.querySelectorAll("[data-focus-detection]"))
        .filter((node) => node.getAttribute("data-focus-detection") === String(current.id));
      activeQueueRows.forEach((node) => node.classList.add("is-splash-cue"));
      if (splashCueIndicator) splashCueIndicator.classList.add("is-active");
      if (splashCueResetTimer != null) {
        window.clearTimeout(splashCueResetTimer);
      }
      splashCueResetTimer = window.setTimeout(() => {
        activeQueueRows.forEach((node) => node.classList.remove("is-splash-cue"));
        if (splashCueIndicator) splashCueIndicator.classList.remove("is-active");
        splashCueResetTimer = null;
      }, 240);
    }

    function resolveSplashCueAnchor(start, end) {
      if (!current) return start;
      // Manual false negatives should cue exactly at the reviewer-marked timestamp.
      if (String(current.id).startsWith("fn-")) {
        return Math.min(Math.max(Number(current.timestamp_seconds ?? start), start), end);
      }
      const support = supportFor(current.id);
      const supportAnchor = Number(support?.event_anchor_timestamp_seconds ?? Number.NaN);
      const fallbackAnchor = Number(current.timestamp_seconds ?? start);
      const anchor = Number.isFinite(supportAnchor) ? supportAnchor : fallbackAnchor;
      return Math.min(Math.max(anchor, start), end);
    }

    function maybeTriggerSplashCue() {
      if (!reviewVideo || !current) return;
      const cueStart = reviewStartFor(current);
      const cueEnd = reviewEndFor(current);
      const now = Number(reviewVideo.currentTime ?? 0);
      if (splashCueLastTime != null && now + 0.06 < splashCueLastTime) {
        splashCueFired = false;
      }
      splashCueLastTime = now;
      const anchor = resolveSplashCueAnchor(cueStart, cueEnd);
      if (splashCueFired || now < anchor - 0.012) return;
      splashCueFired = true;
      flashSplashCueUi();
      if (!splashPauseEnabled || reviewVideo.paused) return;
      reviewVideo.pause();
      window.setTimeout(() => {
        if (!reviewVideo || !current) return;
        if (!splashPauseEnabled) return;
        if (reviewVideo.currentTime >= cueEnd - 0.05) return;
        void reviewVideo.play().catch(() => {});
      }, 260);
    }

    function browserFriendlySource(url) {
      return /\.(mp4|webm|m4v)(\?|$)/i.test(url || "");
    }

    function bindDetectionNodes() {
      document.querySelectorAll("[data-focus-detection]").forEach((node) => {
        if (node.dataset.focusBound === "true") return;
        node.dataset.focusBound = "true";
        node.addEventListener("click", () => selectDetection(node.getAttribute("data-focus-detection")));
      });
      rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
      rows.forEach((row) => {
        if (row.dataset.fnContextBound === "true") return;
        row.dataset.fnContextBound = "true";
        row.addEventListener("contextmenu", async (event) => {
          const detectionId = String(row.getAttribute("data-focus-detection") ?? "");
          if (!isEvaluationSession() || !detectionId.startsWith("fn-")) return;
          event.preventDefault();
          const confirmed = window.confirm(`Remove ${detectionId} completely? This cannot be undone.`);
          if (!confirmed) return;
          await removeFalseNegativeAnnotation(detectionId);
        });
      });
    }

    function scheduleTimelineLayout() {
      if (!timelineTrack) return;
      if (timelineLayoutFrame != null) {
        window.cancelAnimationFrame(timelineLayoutFrame);
      }
      timelineLayoutFrame = window.requestAnimationFrame(() => {
        timelineLayoutFrame = null;
        layoutTimelineMarkers();
      });
    }

    function layoutTimelineMarkers() {
      if (!timelineTrack || !timelineViewport) return;
      const pips = Array.from(timelineTrack.querySelectorAll("[data-timeline-marker]"));
      pips.forEach((pip) => {
        const id = pip.getAttribute("data-timeline-marker") ?? "";
        const decision = decisionLabelFor(id);
        pip.classList.toggle("is-kept", decision === "keep");
        pip.classList.toggle("is-rejected", decision === "reject");
        pip.classList.toggle("is-unsure", decision === "unsure");
        pip.classList.toggle("is-false-negative", String(id).startsWith("fn-"));
        pip.classList.toggle("is-current", id === current?.id);
      });
    }

    function shouldRenderTimelineMarker(item) {
      if (!fnTimelineFocusEnabled) return true;
      if (String(item.id).startsWith("fn-")) return true;
      return decisionLabelFor(item.id) === positiveDecisionLabel();
    }

    function isFnFocusFreePlaybackItem(item) {
      return Boolean(item) && fnTimelineFocusEnabled && shouldRenderTimelineMarker(item);
    }

    function renderTimelineMarkers() {
      if (!timelineTrack) return;
      timelineTrack.querySelectorAll("[data-timeline-marker]").forEach((node) => node.remove());
      detections.filter(shouldRenderTimelineMarker).forEach((item) => {
        const pip = document.createElement("button");
        pip.type = "button";
        pip.className = `tl__pip confidence-${item.confidence}`;
        if (item.id === current?.id) pip.classList.add("is-current");
        if (String(item.id).startsWith("fn-")) pip.classList.add("is-false-negative");
        pip.style.left = `${Math.min(99.2, Math.max(0.8, ((Number(item.timestamp_seconds ?? 0) - rangeStartValue) / rangeSpanValue) * 100))}%`;
        pip.dataset.focusDetection = item.id;
        pip.dataset.timelineMarker = item.id;
        pip.dataset.pipIndex = String(item.index ?? "");
        pip.dataset.pipTime = formatSeconds(Number(item.timestamp_seconds ?? 0));
        pip.setAttribute(
          "aria-label",
          String(item.id).startsWith("fn-")
            ? `${falseNegativeLabelFor(item)} at ${formatSeconds(Number(item.timestamp_seconds ?? 0))}`
            : `Attempt ${item.index} at ${formatSeconds(Number(item.timestamp_seconds ?? 0))}`,
        );
        pip.addEventListener("click", () => selectDetection(item.id, { autoplay: false }));
        timelineTrack.appendChild(pip);
      });
      layoutTimelineMarkers();
    }

    const timelinePlayhead = document.querySelector("[data-timeline-playhead]");
    const timelineTooltip = document.querySelector("[data-timeline-tooltip]");

    function updateTimelinePlayhead() {
      if (!timelinePlayhead || !reviewVideo) return;
      const pos = ((reviewVideo.currentTime - rangeStartValue) / rangeSpanValue) * 100;
      const clamped = Math.min(100, Math.max(0, pos));
      timelinePlayhead.style.left = clamped + "%";
    }

    function cancelPlaybackUiLoop() {
      if (playbackUiFrame == null) return;
      window.cancelAnimationFrame(playbackUiFrame);
      playbackUiFrame = null;
    }

    function syncPlaybackUi() {
      updateTimelinePlayhead();
      followTimelinePlayheadSelection();
    }

    function tickPlaybackUi() {
      playbackUiFrame = null;
      syncPlaybackUi();
      if (!reviewVideo || reviewVideo.paused || reviewVideo.ended) return;
      playbackUiFrame = window.requestAnimationFrame(tickPlaybackUi);
    }

    function startPlaybackUiLoop() {
      cancelPlaybackUiLoop();
      if (!reviewVideo || reviewVideo.paused || reviewVideo.ended) {
        syncPlaybackUi();
        return;
      }
      playbackUiFrame = window.requestAnimationFrame(tickPlaybackUi);
    }

    if (timelineTrack) {
      const timelineTimeFromClientX = (clientX) => {
        const rect = timelineTrack.getBoundingClientRect();
        if (rect.width <= 0) return rangeStartValue;
        const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        return rangeStartValue + ratio * rangeSpanValue;
      };

      const closestDetectionForTime = (targetTime) => {
        if (!detections.length) return null;
        return detections.reduce((closest, item) => {
          if (!closest) return item;
          return Math.abs(item.timestamp_seconds - targetTime) < Math.abs(closest.timestamp_seconds - targetTime) ? item : closest;
        }, null);
      };

      const showTimelineTooltipAt = (timeValue, clientX) => {
        if (!timelineTooltip) return;
        const rect = timelineTrack.getBoundingClientRect();
        const ratio = rect.width <= 0 ? 0 : Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
        timelineTooltip.textContent = formatSeconds(timeValue);
        timelineTooltip.hidden = false;
        timelineTooltip.style.left = `${ratio * 100}%`;
      };

      const seekTimelineFreely = (targetTime) => {
        if (!reviewVideo) return;
        manualTimelineSeekMode = isEvaluationSession();
        reviewVideo.pause();
        const duration = Number.isFinite(reviewVideo.duration) && reviewVideo.duration > 0
          ? reviewVideo.duration
          : rangeStartValue + rangeSpanValue;
        reviewVideo.currentTime = Math.min(Math.max(targetTime, 0), Math.max(0, duration - 0.05));
        syncPlaybackUi();
      };

      const commitTimelineScrub = (clientX) => {
        const targetTime = timelineTimeFromClientX(clientX);
        if (isEvaluationSession()) {
          seekTimelineFreely(targetTime);
          return;
        }
        const nextDetection = closestDetectionForTime(targetTime);
        if (!nextDetection) return;
        selectDetection(nextDetection.id, { autoplay: false });
        if (reviewVideo) {
          const start = reviewStartFor(nextDetection);
          const end = Math.max(start + 0.05, reviewEndFor(nextDetection));
          reviewVideo.currentTime = Math.min(end - 0.05, Math.max(start, targetTime));
          syncPlaybackUi();
        }
      };

      const finishTimelineScrub = (clientX) => {
        timelineScrubbing = false;
        if (timelinePointerId != null && timelineTrack.hasPointerCapture?.(timelinePointerId)) {
          timelineTrack.releasePointerCapture(timelinePointerId);
        }
        timelinePointerId = null;
        commitTimelineScrub(clientX);
        if (timelineTooltip) timelineTooltip.hidden = true;
      };

      timelineTrack.addEventListener("pointerdown", (event) => {
        if (event.target.closest("[data-timeline-marker]")) return;
        timelineScrubbing = true;
        timelinePointerId = event.pointerId;
        timelineTrack.setPointerCapture?.(event.pointerId);
        showTimelineTooltipAt(timelineTimeFromClientX(event.clientX), event.clientX);
        commitTimelineScrub(event.clientX);
        event.preventDefault();
      });

      timelineTrack.addEventListener("pointermove", (event) => {
        if (!timelineScrubbing) return;
        const targetTime = timelineTimeFromClientX(event.clientX);
        showTimelineTooltipAt(targetTime, event.clientX);
        if (timelinePlayhead) {
          const normalized = ((targetTime - rangeStartValue) / rangeSpanValue) * 100;
          timelinePlayhead.style.left = `${Math.min(100, Math.max(0, normalized))}%`;
        }
      });

      timelineTrack.addEventListener("pointerup", (event) => {
        if (!timelineScrubbing) return;
        finishTimelineScrub(event.clientX);
      });

      timelineTrack.addEventListener("pointercancel", () => {
        timelineScrubbing = false;
        timelinePointerId = null;
        if (timelineTooltip) timelineTooltip.hidden = true;
        syncPlaybackUi();
      });

      timelineTrack.addEventListener("mouseover", (event) => {
        if (timelineScrubbing) return;
        const pip = event.target.closest("[data-timeline-marker]");
        if (!pip || !timelineTooltip) return;
        const idx = pip.getAttribute("data-pip-index") ?? "";
        const time = pip.getAttribute("data-pip-time") ?? "";
        const id = pip.getAttribute("data-timeline-marker") ?? "";
        const decision = decisionLabelFor(id);
        const tag = decision !== "pending" ? decision : "";
        const label = String(id).startsWith("fn-") ? falseNegativeLabelFor({ id }) : "#" + idx;
        timelineTooltip.textContent = label + "  " + time + (tag ? "  " + tag : "");
        timelineTooltip.hidden = false;
        const left = pip.style.left;
        timelineTooltip.style.left = left;
      });
      timelineTrack.addEventListener("mouseout", (event) => {
        if (timelineScrubbing) return;
        const pip = event.target.closest("[data-timeline-marker]");
        if (pip && timelineTooltip) timelineTooltip.hidden = true;
      });
    }

    if (reviewVideo) {
      reviewVideo.addEventListener("timeupdate", syncPlaybackUi);
      reviewVideo.addEventListener("play", startPlaybackUiLoop);
      reviewVideo.addEventListener("pause", () => {
        cancelPlaybackUiLoop();
        syncPlaybackUi();
      });
      reviewVideo.addEventListener("ended", () => {
        cancelPlaybackUiLoop();
        syncPlaybackUi();
      });
      reviewVideo.addEventListener("seeking", syncPlaybackUi);
      reviewVideo.addEventListener("seeked", syncPlaybackUi);
      reviewVideo.addEventListener("loadedmetadata", syncPlaybackUi);
    }

    function renderDetectionTable() {
      if (!tableBody) return;
      tableBody.innerHTML = detections.map((item) => {
        const lane = approveReviewLaneFor(item);
        const timingGroup = timingGroupKeyFor(item);
        const timingTooltip = timingTooltipForItem(item);
        const support = supportFor(item.id);
        const shadowRank = (support?.candidate_quality_shadow)?.shadow_rank_within_session ?? 999;
        const currentRank = (support?.candidate_quality_shadow)?.current_rank_within_session ?? 999;
        return `
        <tr class="${item.id === current?.id ? "is-current" : ""} is-${lane}${timingGroup ? ` timing-${timingGroup}` : ""}" data-focus-detection="${item.id}" data-policy-lane="${lane}" data-policy-score="${formatPolicyScore(item)}"${timingGroup ? ` data-timing-group="${timingGroup}"` : ""}${timingTooltip ? ` title="${timingTooltip.replaceAll('"', '&quot;')}` + `"` : ""} data-shadow-rank="${shadowRank}" data-shadow-rank-cur="${currentRank}">
          <td>${item.entry_type === "false_negative" ? falseNegativeLabelFor(item) : item.id}</td>
          <td>${formatSeconds(item.timestamp_seconds)}</td>
          <td>${displayDecisionLabelFor(item)}</td>
          <td>${signalLabelFor(item)}</td>
        </tr>
      `;
      }).join("");
      if (sortEnabled && tableBody) {
        const rows = Array.from(tableBody.querySelectorAll("tr"));
        rows.sort((a, b) => parseFloat(a.getAttribute("data-shadow-rank") ?? "999") - parseFloat(b.getAttribute("data-shadow-rank") ?? "999"));
        rows.forEach((row) => tableBody.appendChild(row));
      }
      bindDetectionNodes();
      applyQueueFilter();
      renderTimelineMarkers();
      scheduleTimelineLayout();
      updateQueueNavigationState();
    }

    function updateReviewModeCopy() {
      if (reviewListTitle) reviewListTitle.textContent = isEvaluationSession() ? "Evaluation queue" : "Attempts";
      if (reviewListNote) {
        reviewListNote.textContent = isEvaluationSession()
          ? "Label each detector attempt, then add missed dives directly from the proxy."
          : "Choose an attempt, review it, then save your decision.";
      }
    }

    function configureCleanupModeUi() {
      if (!cleanupQueueActive) return;
      if (eventSaveButton) {
        eventSaveButton.hidden = true;
        eventSaveButton.disabled = true;
      }
      const legacyUncertainOption = eventLabelSelect?.querySelector('option[value="uncertain"]');
      if (legacyUncertainOption) {
        legacyUncertainOption.disabled = true;
        legacyUncertainOption.hidden = true;
      }
    }

    function validateCleanupDecision(label, eventLabel, candidateUsefulness, clipQuality, anchorQuality) {
      if (!cleanupQueueActive) return null;
      const issues = [];
      if (!cleanupAllowed.reviewLabel.includes(String(label ?? ""))) {
        issues.push("Pick Dive, Non-dive, or Unsure.");
      }
      if (!cleanupAllowed.eventLabel.includes(String(eventLabel ?? ""))) {
        issues.push("Choose an event label from the cleanup contract.");
      }
      if (!cleanupAllowed.anchorQuality.includes(String(anchorQuality ?? ""))) {
        issues.push("Choose an anchor quality from the cleanup contract.");
      }
      if (!cleanupAllowed.candidateUsefulness.includes(String(candidateUsefulness ?? ""))) {
        issues.push("Choose a usefulness value from the cleanup contract.");
      }
      if (!cleanupAllowed.clipQuality.includes(String(clipQuality ?? ""))) {
        issues.push("Choose a clip quality value from the cleanup contract.");
      }
      return issues.length > 0 ? issues.join(" ") : null;
    }

    function playCurrentSegment() {
      if (!reviewVideo || !current) return;
      manualTimelineSeekMode = false;
      if (isFnFocusFreePlaybackItem(current)) {
        return reviewVideo.play().catch(() => {});
      }
      const start = reviewStartFor(current);
      const end = reviewEndFor(current);
      if (reviewVideo.currentTime < start || reviewVideo.currentTime >= end) {
        reviewVideo.currentTime = start;
      }
      return reviewVideo.play().catch(() => {});
    }

    function nextDetection(direction = 1, preferPending = false) {
      if (!current || detections.length === 0) return null;
      if (sortEnabled) {
        rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
        const filtered = rows.filter((row) => !row.hidden);
        const currentIndex = filtered.findIndex((row) => row.getAttribute("data-focus-detection") === current.id);
        if (currentIndex < 0) return null;
        for (let step = 1; step <= filtered.length; step += 1) {
          const candidateIndex = (currentIndex + step * direction + filtered.length) % filtered.length;
          const candidateId = filtered[candidateIndex].getAttribute("data-focus-detection");
          if (!candidateId) continue;
          if (!preferPending || isUnresolvedDecision(decisionLabelFor(candidateId))) {
            return detections.find((item) => item.id === candidateId) ?? null;
          }
        }
        return null;
      }
      const startIndex = Math.max(0, detections.findIndex((item) => item.id === current.id));
      for (let step = 1; step <= detections.length; step += 1) {
        const candidate = detections[(startIndex + step * direction + detections.length) % detections.length];
        if (!preferPending || isUnresolvedDecision(decisionLabelFor(candidate.id))) {
          return candidate;
        }
      }
      return null;
    }

    function selectAdjacentDetection(direction) {
      // When priority queue (focus sidebar) is active, navigate through priority queue rows
      const currentMode = reviewSidebar?.getAttribute("data-sidebar-mode");
      if (currentMode === "focus") {
        const allQueueNodes = Array.from(document.querySelectorAll("[data-queue-focus]"));
        // Filter out false-negative placeholder rows (no candidate_id)
        const queueNodes = allQueueNodes.filter((node) => {
          const cid = node.getAttribute("data-queue-candidate");
          return cid && cid !== "None";
        });
        if (queueNodes.length === 0) return;
        const currentCandidate = current?.id ?? null;
        const currentIndex = queueNodes.findIndex((node) =>
          node.getAttribute("data-queue-candidate") === currentCandidate
          || (String(currentCandidate ?? "").startsWith("fn-") && String(node.getAttribute("data-queue-fn-order") ?? "") !== "")
        );
        if (currentIndex < 0) {
          const firstNode = direction > 0 ? queueNodes[0] : queueNodes[queueNodes.length - 1];
          focusDetectionByQueue(firstNode);
          return;
        }
        const nextIndex = (currentIndex + direction + queueNodes.length) % queueNodes.length;
        focusDetectionByQueue(queueNodes[nextIndex]);
        return;
      }
      // Standard review queue navigation
      const candidate = nextDetection(direction, false);
      if (candidate) {
        if (sortEnabled) {
          if (direction > 0) {
            telemetryNextWhileSorted += 1;
            emitRowTelemetry("review_sort_navigation_next", candidate.id, {
              direction: "next",
              from_candidate_id: current?.id ?? null,
            });
          } else {
            telemetryPrevWhileSorted += 1;
            emitRowTelemetry("review_sort_navigation_prev", candidate.id, {
              direction: "prev",
              from_candidate_id: current?.id ?? null,
            });
          }
        }
        selectDetection(candidate.id, { autoplay: autoPlayEnabled, scrollQueue: true });
      }
    }

    function matchesQueueFilter(detection, filterValue = reviewFilter) {
      if (!detection) return false;
      const decision = decisionLabelFor(detection.id);
      const isFalseNegativeRow = Boolean(
        detection.entry_type === "false_negative"
        || String(detection.id ?? "").startsWith("fn-")
        || decision === "false_negative",
      );
      const productLane = approveReviewLaneFor(detection);
      if (filterValue === "all") return true;
      if (filterValue === "auto_approved") return productLane === "auto_approved";
      if (filterValue === "needs_review") return productLane !== "auto_approved";
      if (filterValue === "pending") return isUnresolvedDecision(decision);
      if (filterValue === "false_negative") return isFalseNegativeRow;
      if (filterValue === "shadow_available") return Boolean(shadowRankFor(detection)?.score != null);
      if (filterValue === "useful_clip") return decisionFor(detection.id)?.candidateUsefulness === "useful_clip";
      if (filterValue === "needs_anchor_quality") return !(decisionFor(detection.id)?.anchorQuality ?? null);
      if (filterValue === "unknown_or_unsure") return decisionFor(detection.id)?.eventLabel === "unknown_or_unsure";
      if (
        isEvaluationSession()
        && fnTimelineFocusEnabled
        && filterValue === positiveDecisionLabel()
      ) {
        return decision === positiveDecisionLabel() || isFalseNegativeRow;
      }
      return decision === filterValue;
    }

    function scrollQueueRowIntoView(detectionId = current?.id) {
      if (!detectionId) return;
      rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
      const targetRow = rows.find((row) => row.getAttribute("data-focus-detection") === String(detectionId));
      if (!targetRow || targetRow.hidden) return;
      targetRow.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
    }

    function flashQueueRow(detectionId) {
      rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
      const targetRow = rows.find((row) => row.getAttribute("data-focus-detection") === String(detectionId));
      if (!targetRow) return;
      targetRow.classList.remove("timing-flash");
      // Force restart if the same row is flashed twice.
      void targetRow.offsetWidth;
      targetRow.classList.add("timing-flash");
      window.setTimeout(() => targetRow.classList.remove("timing-flash"), 1500);
    }

    function firstDetectionIdForTimingGroup(groupKey) {
      rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
      const targetRow = rows.find((row) => row.getAttribute("data-timing-group") === String(groupKey));
      return targetRow?.getAttribute("data-focus-detection") ?? null;
    }

    function jumpToTimingGroup(groupKey) {
      const detectionId = firstDetectionIdForTimingGroup(groupKey);
      if (!detectionId) return;
      setSidebarMode("review");
      window.requestAnimationFrame(() => {
        scrollQueueRowIntoView(detectionId);
        flashQueueRow(detectionId);
      });
    }

    function timelineFollowDetectionForTime(timeSeconds, allowNearestFallback = true) {
      const candidates = detections.filter((item) => shouldRenderTimelineMarker(item) && matchesQueueFilter(item));
      if (!candidates.length) return null;
      const containing = candidates.filter((item) => {
        const start = reviewStartFor(item);
        const end = reviewEndFor(item);
        return timeSeconds >= start && timeSeconds < end;
      });
      if (!containing.length && !allowNearestFallback) {
        return null;
      }
      const pool = containing.length ? containing : candidates;
      return pool.reduce((closest, item) => {
        if (!closest) return item;
        return Math.abs(Number(item.timestamp_seconds ?? 0) - timeSeconds) < Math.abs(Number(closest.timestamp_seconds ?? 0) - timeSeconds)
          ? item
          : closest;
      }, null);
    }

    function adoptTimelineDetection(detectionId) {
      const next = detections.find((item) => item.id === detectionId);
      if (!next || next.id === current?.id) return;
      current = next;
      resetSplashCueCycle();
      reviewLabel && (reviewLabel.textContent = `${formatSeconds(reviewStartFor(current))} to ${formatSeconds(reviewEndFor(current))} · ${parsed.session?.source_video_path ?? ""}`);
      audioLabel && (audioLabel.textContent = String(current.id).startsWith("fn-") ? "Manual annotation" : `Audio ${current.scores.audio.toFixed(2)}`);
      windowLabel && (windowLabel.textContent = `Window ${formatSeconds(reviewStartFor(current))} to ${formatSeconds(reviewEndFor(current))}`);
      decisionDetailLabel && (decisionDetailLabel.textContent = `Decision ${displayDecisionLabelFor(current)} · score ${formatPolicyScore(current)}`);
      shadowRankDetailLabel && (shadowRankDetailLabel.textContent = formatShadowRank(current));
      candidateQualityShadowDetailLabel && (candidateQualityShadowDetailLabel.textContent = formatCandidateQualityShadow(current));
      document.querySelectorAll("[data-focus-detection]").forEach((node) => {
        node.classList.toggle("is-current", node.getAttribute("data-focus-detection") === String(detectionId));
      });
      rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
      rows.forEach((row) => row.classList.toggle("is-current", row.getAttribute("data-focus-detection") === String(detectionId)));
      scheduleTimelineLayout();
      updateMediaSessionMetadata();
      syncCurrentDecisionUi();
      updateRefinementQueueState();
      updateQueueNavigationState();
      void syncAssignmentPanelForCurrent();
      scrollQueueRowIntoView(detectionId);
    }

    function followTimelinePlayheadSelection() {
      if (!isEvaluationSession() || !reviewVideo) return;
      const freeTimelineMode = manualTimelineSeekMode || isFnFocusFreePlaybackItem(current);
      if (!freeTimelineMode) return;
      const target = timelineFollowDetectionForTime(
        Number(reviewVideo.currentTime ?? 0),
        manualTimelineSeekMode,
      );
      if (!target) return;
      adoptTimelineDetection(target.id);
    }

    function unresolvedDetections() {
      return baseDetections.filter((item) => isUnresolvedDecision(decisionLabelFor(item.id)));
    }

    function nextReviewQueueDetectionFrom(fromId) {
      if (detections.length === 0) return null;
      const unresolved = unresolvedDetections();
      if (!unresolved.length) return null;
      const startIndex = Math.max(0, detections.findIndex((item) => item.id === fromId));
      for (let step = 1; step <= detections.length; step += 1) {
        const candidate = detections[(startIndex + step) % detections.length];
        if (isUnresolvedDecision(decisionLabelFor(candidate.id))) {
          return candidate;
        }
      }
      return unresolved[0] ?? null;
    }

    function moveReviewForwardAfterDecision(savedDetectionId, label) {
      const unresolved = unresolvedDetections();
      if (!unresolved.length) {
        reviewCompleteNoticeDismissed = false;
        decisionStatus && (decisionStatus.textContent = `Saved ${label} for ${savedDetectionId}. Review complete.`);
        updateReviewCounts();
        return;
      }
      const nextQueueItem = nextReviewQueueDetectionFrom(savedDetectionId);
      if (!nextQueueItem) return;
      if (reviewFilterSelect && !["all", "pending", "needs_review"].includes(reviewFilter)) {
        reviewFilter = "needs_review";
        reviewFilterSelect.value = "needs_review";
        applyQueueFilter();
      }
      decisionStatus && (decisionStatus.textContent = `Saved ${label} for ${savedDetectionId}. ${unresolved.length} still in review.`);
      selectDetection(nextQueueItem.id, { autoplay: autoPlayEnabled, scrollQueue: true });
    }

    function nextVisibleReviewQueueDetectionFrom(fromId) {
      if (detections.length === 0) return null;
      const startIndex = detections.findIndex((item) => item.id === fromId);
      if (startIndex < 0) return null;
      for (let index = startIndex + 1; index < detections.length; index += 1) {
        const candidate = detections[index];
        if (matchesQueueFilter(candidate)) return candidate;
      }
      return null;
    }

    function moveReviewForwardAfterEventSave(savedDetectionId, label) {
      const nextQueueItem = nextVisibleReviewQueueDetectionFrom(savedDetectionId);
      if (!nextQueueItem) {
        decisionStatus && (decisionStatus.textContent = `Saved ${label} for ${savedDetectionId}. End of current queue.`);
        updateReviewCounts();
        return;
      }
      decisionStatus && (decisionStatus.textContent = `Saved ${label} for ${savedDetectionId}. Moving to next queue row.`);
      selectDetection(nextQueueItem.id, { autoplay: autoPlayEnabled, scrollQueue: true });
    }

     function applyQueueFilter() {
      rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
      let visibleCount = 0;
      rows.forEach((row) => {
        const id = row.getAttribute("data-focus-detection") ?? "";
        const detection = detections.find((item) => item.id === id);
        const visible = matchesQueueFilter(detection);
        row.hidden = !visible;
        row.style.display = visible ? "" : "none";
        if (visible) visibleCount += 1;
      });
      if (reviewSidebar) {
        reviewSidebar.dataset.filterMode = reviewFilter;
      }
      reviewRefinement?.classList.toggle("is-compact", reviewFilter === "false_negative");
      if (reviewEmptyState) {
        reviewEmptyState.hidden = visibleCount !== 0;
      }
    }

    function syncVideoSource() {
      if (!reviewVideo || !current) return;
      resetSplashCueCycle();
      const proxySrc = parsed.primaryVideoUrl ?? "";
      const directSrc = parsed.sourceVideoUrl ?? "";
      if (sourceLoopHandler) {
        reviewVideo.removeEventListener("timeupdate", sourceLoopHandler);
        sourceLoopHandler = null;
      }
      const start = reviewStartFor(current);
      const end = reviewEndFor(current);
      reviewVideo.controls = true;
      const proxyAvailable = Boolean(parsed.reviewProxyAvailable);
      const directSourceSafe = Boolean(parsed.sourceVideoBrowserFriendly) || browserFriendlySource(directSrc);
      const sourceSrc = proxyAvailable
        ? proxySrc
        : directSourceSafe
          ? directSrc
          : "";
      const waitingForProxy = !sourceSrc;

      if (waitingForProxy) {
        cancelPlaybackUiLoop();
        reviewVideo.pause();
        reviewVideo.removeAttribute("src");
        reviewVideo.load();
        if (reviewPlaceholder) {
          reviewPlaceholder.hidden = false;
          reviewPlaceholder.textContent = "A browser-ready review proxy is required for this source. Create the MP4 proxy before continuing review.";
        }
        return;
      }

      reviewPlaceholder && (reviewPlaceholder.hidden = true);
      if (reviewVideo.dataset.sourceSrc !== sourceSrc || !reviewVideo.getAttribute("src")) {
        reviewVideo.src = sourceSrc;
        reviewVideo.dataset.sourceSrc = sourceSrc;
        reviewVideo.addEventListener("loadedmetadata", () => {
          reviewVideo.currentTime = start;
          syncPlaybackUi();
          if (autoPlayEnabled) void playCurrentSegment();
        }, { once: true });
      } else {
        reviewVideo.currentTime = start;
      }
      sourceLoopHandler = () => {
        if (manualTimelineSeekMode && isEvaluationSession()) {
          syncPlaybackUi();
          return;
        }
        maybeTriggerSplashCue();
        if (reviewVideo.currentTime >= end) {
          if (isFnFocusFreePlaybackItem(current)) {
            syncPlaybackUi();
            return;
          } else if (loopEnabled) {
            reviewVideo.currentTime = start;
          } else if (autoAdvanceEnabled) {
            reviewVideo.pause();
            const next = nextDetection(1, true) ?? nextDetection(1, false);
            if (next && next.id !== current?.id) {
              selectDetection(next.id, { autoplay: autoPlayEnabled, scrollQueue: true });
              return;
            }
            reviewVideo.currentTime = start;
          } else {
            reviewVideo.pause();
            reviewVideo.currentTime = start;
          }
        }
        syncPlaybackUi();
      };
      reviewVideo.addEventListener("timeupdate", sourceLoopHandler);
      updateReviewModeCopy();
      startPlaybackUiLoop();
    }

    function selectDetection(id, options = {}) {
      current = detections.find((item) => item.id === id) ?? current;
      if (!current) return;
      resetSplashCueCycle();
      manualTimelineSeekMode = false;
      reviewLabel && (reviewLabel.textContent = `${formatSeconds(reviewStartFor(current))} to ${formatSeconds(reviewEndFor(current))} · ${parsed.session?.source_video_path ?? ""}`);
      audioLabel && (audioLabel.textContent = String(current.id).startsWith("fn-") ? "Manual annotation" : `Audio ${current.scores.audio.toFixed(2)}`);
      windowLabel && (windowLabel.textContent = `Window ${formatSeconds(reviewStartFor(current))} to ${formatSeconds(reviewEndFor(current))}`);
      decisionDetailLabel && (decisionDetailLabel.textContent = `Decision ${decisionFor(current.id)?.label ?? "pending"}`);
      document.querySelectorAll("[data-focus-detection]").forEach((node) => {
        node.classList.toggle("is-current", node.getAttribute("data-focus-detection") === id);
      });
      rows.forEach((row) => row.classList.toggle("is-current", row.getAttribute("data-focus-detection") === id));
      scheduleTimelineLayout();
      syncVideoSource();
      updateMediaSessionMetadata();
      updateReviewCounts();
      syncCurrentDecisionUi();
      updateRefinementQueueState();
      updateQueueNavigationState();
      void syncAssignmentPanelForCurrent();
      if (options.scrollQueue) {
        scrollQueueRowIntoView(id);
      }
      if (options.autoplay && autoPlayEnabled) {
        window.setTimeout(() => { void playCurrentSegment(); }, 40);
      }
      if (shadowV2Active) {
        emitTelemetry({
          event_type: "shadow_v2_row_viewed",
          schema_version: "r182_shadow_v2_telemetry_v1",
          v2_shadow_active: true,
          candidate_id: String(current?.id ?? ""),
        });
        emitTelemetry({
          event_type: "shadow_v2_rank_context",
          schema_version: "r182_shadow_v2_telemetry_v1",
          v2_shadow_active: true,
          candidate_id: String(current?.id ?? ""),
        });
      }
    }

    function focusDetectionByQueue(row) {
      const sessionId = String(row?.dataset?.queueSession ?? "");
      const candidateId = String(row?.dataset?.queueCandidate ?? "");
      const label = String(row?.dataset?.queueLabel ?? "");
      const falseNegativeOrder = Number(row?.dataset?.queueFnOrder ?? "0");
      const queueSuggestion = String(row?.dataset?.queueSuggestion ?? "");
      if (sessionId && sessionId !== parsed.requestedSession) {
        syncSessionAndFocus(sessionId, candidateId || `fn-order-${falseNegativeOrder || 1}-${queueSuggestion || "any"}`);
        return;
      }
      if (candidateId && candidateId !== "None") {
        selectDetection(candidateId, { autoplay: false });
        return;
      }
      const falseNegativeRows = falseNegativeQueueCandidates(queueSuggestion);
      const nextManual = (falseNegativeOrder > 0 ? falseNegativeRows[falseNegativeOrder - 1] : falseNegativeRows[0]) ?? detections[0];
      if (nextManual) selectDetection(nextManual.id, { autoplay: false });
    }

    tabButtons.forEach((button, index) => button.addEventListener("click", () => setTab(index)));
    document.querySelectorAll("[data-open-tab]").forEach((button) => {
      button.addEventListener("click", () => setTab(Number(button.getAttribute("data-open-tab"))));
    });
    bindDetectionNodes();
    assignmentInputs.forEach((input) => {
      input.addEventListener("input", () => {
        markAssignmentDirty();
        if (input.getAttribute("data-assignment-input") === "apparatus_height_m") {
          syncApparatusFromHeight();
        }
        refreshAssignmentSuggestionsForInput(input);
      });
      input.addEventListener("focus", () => {
        refreshAssignmentSuggestionsForInput(input);
      });
      input.addEventListener("keyup", () => refreshAssignmentSuggestionsForInput(input));
      input.addEventListener("keydown", (event) => {
        const name = input.getAttribute("data-assignment-input");
        if (!(name === "diver_query" || name === "training_group" || name === "dive_code" || name === "apparatus_height_m")) return;
        if (event.key === "ArrowDown") {
          event.preventDefault();
          moveAssignmentSuggestion(name, 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          moveAssignmentSuggestion(name, -1);
      } else if (event.key === "Enter") {
          if (acceptAssignmentSuggestion(name)) event.preventDefault();
        } else if (event.key === "Tab") {
          if (assignmentInlineFields.has(name) && acceptAssignmentSuggestion(name)) event.preventDefault();
        } else if (event.key === "Escape") {
          hideAssignmentSuggestions();
          renderAssignmentInlineCompletion(name);
        }
      });
      input.addEventListener("change", () => {
        if (input.getAttribute("data-assignment-input") === "apparatus_height_m") {
          syncApparatusFromHeight();
        }
        markAssignmentDirty();
      });
    });
    document.addEventListener("input", (event) => {
      const input = event.target;
      if (!(input instanceof HTMLElement) || !input.matches("[data-assignment-input]")) return;
      refreshAssignmentSuggestionsForInput(input);
    });
    document.addEventListener("focusin", (event) => {
      const input = event.target;
      if (!(input instanceof HTMLElement) || !input.matches("[data-assignment-input]")) return;
      refreshAssignmentSuggestionsForInput(input);
    });
    assignmentSaveButton?.addEventListener("click", () => {
      void saveAssignmentDraftRowAndAdvance();
    });
    assignmentApplyPreviousButton?.addEventListener("click", () => {
      void applyPreviousAssignmentContext(false);
    });
    assignmentValidateButton?.addEventListener("click", () => {
      void validateAssignmentDraft();
    });
    document.addEventListener("keydown", (event) => {
      if (!event.altKey || event.metaKey || event.ctrlKey || event.shiftKey) return;
      if (isAssignmentTypingTarget(event.target)) return;
      if (event.key.toLowerCase() !== "p") return;
      event.preventDefault();
      void applyPreviousAssignmentContext(false);
    });
    scheduleTimelineLayout();
    window.addEventListener("resize", scheduleTimelineLayout);

    reviewFilterSelect?.addEventListener("change", (event) => {
      const prevFilter = reviewFilter;
      reviewFilter = String(event.target?.value ?? "all");
      if (sortEnabled) {
        telemetryFilterChangesWhileSorted += 1;
        emitTelemetry({
          event_type: "review_sort_filter_changed_while_sorted",
          filter_before: prevFilter,
          filter_after: reviewFilter,
        });
      }
      applyQueueFilter();
      followTimelinePlayheadSelection();
    });
    timelineFnToggle?.addEventListener("change", (event) => {
      fnTimelineFocusEnabled = Boolean(event.target?.checked);
      renderTimelineMarkers();
      followTimelinePlayheadSelection();
    });

    reviewCompleteExportButton?.addEventListener("click", () => {
      dismissReviewCompleteNotice();
      setTab(2);
    });

    reviewCompleteStayButton?.addEventListener("click", () => {
      dismissReviewCompleteNotice();
    });

    const form = document.querySelector("[data-analysis-form]");
    const input = document.querySelector("[data-analysis-path]");
    const status = document.querySelector("[data-analysis-status]");
    const profile = document.querySelector("[data-analysis-profile]");
    const detector = document.querySelector("[data-analysis-detector]");
    const sessionNameInput = document.querySelector("[data-analysis-session-name]");
    const pickedFileInput = document.querySelector("[data-analysis-file]");
    const pickButton = document.querySelector("[data-analysis-pick]");
    const pickedFileLabel = document.querySelector("[data-analysis-file-label]");
    let pickedVideoFile = null;
    const defaultSessionName = String(sessionNameInput?.getAttribute("data-default-session-name") ?? "").trim();
    let sessionNameAutoFilled = !sessionNameInput || String(sessionNameInput.value ?? "").trim() === defaultSessionName;

    function deriveSessionNameFromPath(filePath) {
      const raw = String(filePath ?? "").trim();
      if (!raw) return "";
      const leaf = raw.split(/[\\\\/]/).pop() ?? raw;
      return leaf.replace(/\.[^.]+$/, "");
    }

    function canAutoFillSessionName() {
      if (!sessionNameInput) return false;
      const currentValue = String(sessionNameInput.value ?? "").trim();
      return !currentValue || currentValue === defaultSessionName || sessionNameAutoFilled;
    }

    function reconcileSessionList(sessions) {
      if (!sessionList || !Array.isArray(sessions)) return;
      const liveIds = new Set(sessions.map((item) => item.sessionId));
      sessionList.querySelectorAll("[data-session-row]").forEach((row) => {
        const rowId = row.getAttribute("data-session-row");
        if (rowId && !liveIds.has(rowId)) {
          row.remove();
        }
      });
      if (sessionTotal) {
        sessionTotal.textContent = `${sessions.length} sessions`;
      }
    }

    function renderExportInsights() {
      if (!decisionList) return;
      if (isEvaluationSession()) {
        const diveCount = baseDetections.filter((item) => decisionLabelFor(item.id) === "dive").length;
        const nonDiveCount = baseDetections.filter((item) => decisionLabelFor(item.id) === "non_dive").length;
        const unsureCount = baseDetections.filter((item) => decisionLabelFor(item.id) === "unsure").length;
        const pendingCount = baseDetections.filter((item) => decisionLabelFor(item.id) === "pending").length;
        if (exportCalloutTitle) exportCalloutTitle.textContent = pendingCount > 0 ? "Keep labeling" : "Evaluation summary";
        if (exportCalloutCopy) {
          exportCalloutCopy.textContent = pendingCount > 0
            ? `${pendingCount} detector attempt${pendingCount === 1 ? "" : "s"} still need a decision.`
            : `${diveCount} dive${diveCount === 1 ? "" : "s"} confirmed, ${nonDiveCount} non-dive${nonDiveCount === 1 ? "" : "s"} confirmed, ${falseNegativeAnnotations.length} false negative${falseNegativeAnnotations.length === 1 ? "" : "s"} logged.`;
        }
        if (exportCalloutAction) {
          exportCalloutAction.hidden = false;
          exportCalloutAction.textContent = "Open evaluation review";
        }
        if (exportFocusTitle) exportFocusTitle.textContent = "Evaluation labels";
        decisionList.innerHTML = [
          `<article class="export-focus-card export-focus-card--quiet"><strong>${diveCount} dive${diveCount === 1 ? "" : "s"}</strong><span>Detector attempts confirmed as dives.</span></article>`,
          `<article class="export-focus-card export-focus-card--quiet"><strong>${nonDiveCount} non-dive${nonDiveCount === 1 ? "" : "s"}</strong><span>Detector attempts rejected as non-dives.</span></article>`,
          `<article class="export-focus-card export-focus-card--quiet"><strong>${falseNegativeAnnotations.length} false negative${falseNegativeAnnotations.length === 1 ? "" : "s"}</strong><span>Missed dives logged manually from the proxy.</span></article>`,
          `<article class="export-focus-card export-focus-card--quiet"><strong>${unsureCount} unsure</strong><span>Attempts that still need a stronger decision.</span></article>`,
        ].join("");
        return;
      }
      const keepCount = keptDetections().length;
      const exportedCount = exportedPaths.length;
      const unresolved = unresolvedDetections();
      const readyCount = Math.max(0, keepCount - exportedCount);

      if (unresolved.length > 0) {
        if (exportCalloutTitle) exportCalloutTitle.textContent = "Finish review first";
        if (exportCalloutCopy) {
          exportCalloutCopy.textContent = `${unresolved.length} attempt${unresolved.length === 1 ? "" : "s"} still need a decision before this session is fully wrapped up.`;
        }
        if (exportCalloutAction) {
          exportCalloutAction.hidden = false;
          exportCalloutAction.textContent = "Open review";
        }
        if (exportFocusTitle) exportFocusTitle.textContent = "Still to review";
        decisionList.innerHTML = unresolved.slice(0, 6).map((item) => `
          <article class="export-focus-card">
            <strong>Dive ${item.index}</strong>
            <span>Splash at ${formatSeconds(item.timestamp_seconds)}</span>
            <em>${decisionLabelFor(item.id) === "unsure" ? "Unsure" : "No decision yet"}</em>
          </article>
        `).join("");
        return;
      }

      if (keepCount > 0 && readyCount > 0) {
        if (exportCalloutTitle) exportCalloutTitle.textContent = "Ready to export";
        if (exportCalloutCopy) {
          exportCalloutCopy.textContent = `${readyCount} dive${readyCount === 1 ? "" : "s"} ${readyCount === 1 ? "is" : "are"} ready on the left. Export them whenever you are ready.`;
        }
        if (exportCalloutAction) exportCalloutAction.hidden = true;
      } else if (keepCount > 0 && exportedCount > 0) {
        if (exportCalloutTitle) exportCalloutTitle.textContent = "Everything is exported";
        if (exportCalloutCopy) {
          exportCalloutCopy.textContent = `${exportedCount} dive${exportedCount === 1 ? "" : "s"} ${exportedCount === 1 ? "has" : "have"} already been exported. You can reopen Review any time if you want to change a choice.`;
        }
        if (exportCalloutAction) {
          exportCalloutAction.hidden = false;
          exportCalloutAction.textContent = "Open review";
        }
      } else {
        if (exportCalloutTitle) exportCalloutTitle.textContent = "Nothing selected yet";
        if (exportCalloutCopy) {
          exportCalloutCopy.textContent = "Nothing is marked to keep yet. Open Review if you want to change a decision before exporting.";
        }
        if (exportCalloutAction) {
          exportCalloutAction.hidden = false;
          exportCalloutAction.textContent = "Open review";
        }
      }

      if (exportFocusTitle) exportFocusTitle.textContent = "Session status";
      decisionList.innerHTML = `
        <article class="export-focus-card export-focus-card--quiet">
          <strong>${keepCount > 0 ? `${keepCount} dive${keepCount === 1 ? "" : "s"} selected` : "No dives selected"}</strong>
          <span>${exportedCount > 0 ? `${exportedCount} already exported.` : "Selected dives and exports stay grouped on the left."}</span>
        </article>
      `;
    }

    async function readJsonResponse(response) {
      const contentType = String(response.headers.get("content-type") ?? "").toLowerCase();
      const raw = await response.text();
      if (!raw) return {};
      if (!contentType.includes("application/json")) {
        return {
          error: response.ok ? "Unexpected non-JSON response." : raw.trim() || "Request failed.",
          _invalidJson: true,
        };
      }
      try {
        return JSON.parse(raw);
      } catch {
        return { error: "Invalid JSON response.", _invalidJson: true };
      }
    }

    async function refreshDecisions() {
      if (!parsed.session?.id) return;
      const response = await fetch(`/api/review?analysisRunId=${encodeURIComponent(parsed.session.id)}&t=${Date.now()}`, {
        cache: "no-store",
      });
      const payload = await readJsonResponse(response);
      decisions = payload.decisions ?? [];
      falseNegativeAnnotations = payload.falseNegatives ?? [];
      rebuildDetections();
      updateReviewCounts();
      renderExportInsights();
      renderExportList(exportedPaths);
      renderDetectionTable();
      syncCurrentDecisionUi();
      updateRefinementQueueState();
    }

    sessionNameInput?.addEventListener("input", () => {
      const currentValue = String(sessionNameInput.value ?? "").trim();
      sessionNameAutoFilled = !currentValue || currentValue === defaultSessionName;
    });

    pickButton?.addEventListener("click", () => {
      pickedFileInput?.click();
    });

    pickedFileInput?.addEventListener("change", () => {
      pickedVideoFile = pickedFileInput?.files?.[0] ?? null;
      if (pickedFileLabel) {
        pickedFileLabel.textContent = pickedVideoFile
          ? `${pickedVideoFile.name} selected. It will be copied into the app workspace when you start analysis.`
          : "No file selected. You can still paste a path manually.";
      }
      if (input) {
        input.value = pickedVideoFile
          ? pickedVideoFile.name
          : "";
      }
      if (!sessionNameInput || !pickedVideoFile || !canAutoFillSessionName()) return;
      sessionNameInput.value = deriveSessionNameFromPath(pickedVideoFile.name);
      sessionNameAutoFilled = true;
    });

    loopButton?.addEventListener("click", () => {
      loopEnabled = !loopEnabled;
      updateToggleButtons();
    });
    autoplayButton?.addEventListener("click", () => {
      autoPlayEnabled = !autoPlayEnabled;
      updateToggleButtons();
    });
    autoAdvanceButton?.addEventListener("click", () => {
      autoAdvanceEnabled = !autoAdvanceEnabled;
      updateToggleButtons();
    });

    const initialTab = Number(parsed.requestedTab ?? "0");
    if (!Number.isNaN(initialTab) && initialTab >= 0) {
      setTab(initialTab);
    }
    if (String(parsed.requestedFocus ?? "").trim()) {
      const focusId = String(parsed.requestedFocus).trim();
      const falseNegativeOrderMatch = /^fn-order-(\d+)-(.*)$/.exec(focusId) ?? /^fn-order-(\d+)$/.exec(focusId);
      const focusSuggestion = falseNegativeOrderMatch?.[2] ? String(falseNegativeOrderMatch[2]) : "";
      const falseNegativeRows = falseNegativeQueueCandidates(focusSuggestion);
      const focusRow = falseNegativeOrderMatch
        ? falseNegativeRows[Math.max(0, Number(falseNegativeOrderMatch[1]) - 1)]
        : detections.find((item) => item.id === focusId) ?? falseNegativeRows[0];
      if (focusRow) {
        selectDetection(focusRow.id, { autoplay: false });
      }
    }

    function installMediaSessionHandlers() {
      if (!("mediaSession" in navigator)) return;
      try {
        navigator.mediaSession.setActionHandler("play", () => { void playCurrentSegment(); });
        navigator.mediaSession.setActionHandler("pause", () => { reviewVideo?.pause(); });
        navigator.mediaSession.setActionHandler("previoustrack", () => { selectAdjacentDetection(-1); });
        navigator.mediaSession.setActionHandler("nexttrack", () => { selectAdjacentDetection(1); });
      } catch {}
    }

    function updateMediaSessionMetadata() {
      if (!("mediaSession" in navigator) || !current) return;
      try {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: `Attempt ${current.index}`,
          artist: parsed.session?.session_name ?? parsed.session?.title ?? "DiveSensei",
          album: "DiveSensei Review",
        });
      } catch {}
    }

    async function refreshManifest() {
      if (!parsed.hasSession || !parsed.session?.output_dir) return;
      const manifestPath = `${parsed.session.output_dir}/ui_session_manifest.json`;
      const response = await fetch(`/api/media?path=${encodeURIComponent(manifestPath)}`, { cache: "no-store" });
      if (!response.ok) return;
      const manifest = await readJsonResponse(response);
      if (manifest?._invalidJson || !manifest?.session) return;
      parsed.session = manifest.session;
      parsed.sessionMode = manifest.session.mode ?? "standard";
      parsed.sourceVideoUrl = `/api/media?path=${encodeURIComponent(manifest.session.source_video_path)}`;
      const manifestReviewProxy = manifest.artifacts?.review_proxy ?? "";
      parsed.reviewProxyAvailable = Boolean(manifestReviewProxy);
      parsed.sourceVideoBrowserFriendly = [".mp4", ".webm", ".m4v"].some((ext) =>
        String(manifest.session.source_video_path ?? "").toLowerCase().endsWith(ext)
      );
      parsed.primaryVideoUrl = manifestReviewProxy
        ? `/api/media?path=${encodeURIComponent(manifestReviewProxy)}`
        : parsed.sourceVideoBrowserFriendly
          ? parsed.sourceVideoUrl
          : "";
      baseDetections = (manifest.detections ?? []).map((item) => ({
        ...item,
        reviewClipPath: item.clip?.browser_path ?? item.clip?.path,
      }));
      rebuildDetections();
      const currentId = current?.id;
      current = detections.find((item) => item.id === currentId) ?? detections[0] ?? null;
      parsed.requestedSession = manifest.session.id;
      renderDetectionTable();
      scheduleTimelineLayout();
      if (current) {
        selectDetection(current.id);
      }
    }

    async function pollJob(jobId) {
      let redirectedToReview = false;
      while (true) {
        const response = await fetch(`/api/analysis?job=${encodeURIComponent(jobId)}`);
        const payload = await readJsonResponse(response);
        if (payload?._invalidJson) {
          status && (status.textContent = payload.error ?? "Could not read the analysis status.");
          reviewProgress && (reviewProgress.textContent = payload.error ?? "Could not read the analysis status.");
          return;
        }
        const headline = payload.phaseLabel ?? payload.phase ?? payload.status;
        const detail = payload.progressDetail ? ` - ${payload.progressDetail}` : "";
        status && (status.textContent = `${headline}${detail}`);
        reviewProgress && (reviewProgress.textContent = `${headline}${detail}`);
        if (!redirectedToReview && (payload.phase === "review-ready" || payload.phase === "building-review-proxy" || payload.phase === "finalizing" || payload.status === "completed")) {
          const targetTab = getActiveTabIndex();
          const alreadyOnTargetSession = parsed.requestedSession === payload.sessionId && String(parsed.requestedTab ?? "0") === String(targetTab);
          redirectedToReview = true;
          if (!alreadyOnTargetSession) {
            const nextUrl = new URL(window.location.href);
            nextUrl.searchParams.set("session", payload.sessionId);
            nextUrl.searchParams.set("tab", String(targetTab));
            nextUrl.searchParams.set("job", payload.id);
            window.location.replace(nextUrl.toString());
            return;
          }
        }
        if (parsed.requestedJob) {
          await refreshManifest();
        }
        if (payload.status === "completed" || payload.status === "failed") {
          if (payload.status === "completed") {
            await refreshManifest();
            reviewProgress && (reviewProgress.textContent = "Review video is ready. Finish your review, then export the clips you want.");
          }
          return;
        }
        await new Promise((resolve) => setTimeout(resolve, 1500));
      }
    }

    if (parsed.hasSession && parsed.requestedJob && parsed.session?.status === "ready_proxy_pending") {
      pollJob(parsed.requestedJob);
    }

    if (parsed.hasSession && !parsed.requestedJob && parsed.session?.status === "ready_proxy_pending") {
      const passivePoll = async () => {
        while (parsed.session?.status === "ready_proxy_pending") {
          await new Promise((resolve) => setTimeout(resolve, 3000));
          await refreshManifest();
          reviewProgress && (reviewProgress.textContent = "The review video is still being prepared. Playback will appear automatically.");
        }
        reviewProgress && (reviewProgress.textContent = "Review video is ready. Finish your review, then export the clips you want.");
      };
      void passivePoll();
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      status && (status.textContent = "Starting analysis...");
      let videoPath = input?.value ?? "";
      if (pickedVideoFile) {
        status && (status.textContent = `Copying ${pickedVideoFile.name} into the workspace...`);
        const importResponse = await fetch("/api/import-video", {
          method: "POST",
          headers: {
            "Content-Type": "application/octet-stream",
            "X-File-Name": pickedVideoFile.name,
          },
          body: pickedVideoFile,
        });
        const importPayload = await readJsonResponse(importResponse);
        if (!importResponse.ok) {
          status && (status.textContent = importPayload.error ?? "Could not import the selected file.");
          return;
        }
        videoPath = importPayload.path ?? "";
        if (!videoPath) {
          status && (status.textContent = "Could not resolve the imported file path.");
          return;
        }
        input && (input.value = videoPath);
      }
      const response = await fetch("/api/analysis", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          videoPath,
          sessionName: sessionNameInput?.value ?? "",
          profile: profile?.value ?? "long-session",
          detectorId: detector?.value ?? "audio_v2_pcen_classifier",
        }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        status && (status.textContent = payload.error ?? "Could not start analysis.");
        return;
      }
      await pollJob(payload.id);
    });

    async function openSession(sessionId) {
      await fetch("/api/catalog", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "open", analysisRunId: sessionId }),
      }).catch(() => {});
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set("session", sessionId);
      nextUrl.searchParams.set("tab", "1");
      nextUrl.searchParams.delete("job");
      window.location.assign(nextUrl.toString());
    }

    sessionOpenNodes.forEach((node) => {
      node.addEventListener("click", (event) => {
        event.preventDefault();
        const sessionId = node.getAttribute("data-session-open");
        if (sessionId) {
          void openSession(sessionId);
        }
      });
    });

    queueNodes.forEach((node) => {
      if (node.dataset.queueBound === "true") return;
      node.dataset.queueBound = "true";
      node.addEventListener("click", () => focusDetectionByQueue(node));
    });
    updateRefinementQueueState();

    sessionDeleteButtons.forEach((button) => {
      button.addEventListener("click", async (event) => {
        event.preventDefault();
        event.stopPropagation();
        const sessionId = button.getAttribute("data-session-delete");
        if (!sessionId) return;
        const confirmed = window.confirm("Delete this session and remove its generated files? The original video will not be deleted.");
        if (!confirmed) return;
        const row = button.closest(".session-listing");
        const rowButtons = Array.from(row?.querySelectorAll("button") ?? []);
        rowButtons.forEach((node) => { node.disabled = true; });
        const originalLabel = button.textContent;
        button.textContent = "Deleting...";
        status && (status.textContent = "Deleting session...");
        const response = await fetch("/api/catalog", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "delete", analysisRunId: sessionId }),
        });
        const payload = await readJsonResponse(response);
        if (!response.ok) {
          rowButtons.forEach((node) => { node.disabled = false; });
          button.textContent = originalLabel;
          status && (status.textContent = payload.error ?? "Could not delete the session.");
          return;
        }
        const deletingCurrentSession = parsed.session?.id === sessionId || parsed.requestedSession === sessionId;
        reconcileSessionList(payload.sessions);
        if (row?.isConnected) {
          row.remove();
        }
        status && (status.textContent = payload.deleted === false ? "Session was already removed." : "Session deleted.");
        if (!deletingCurrentSession) {
          return;
        }
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.delete("session");
        nextUrl.searchParams.set("tab", String(Math.max(0, Math.min(getActiveTabIndex(), tabButtons.length - 1))));
        nextUrl.searchParams.delete("job");
        nextUrl.searchParams.set("refresh", String(Date.now()));
        window.location.replace(nextUrl.toString());
      });
    });

    sessionRenameButtons.forEach((button) => {
      button.addEventListener("click", async (event) => {
        event.preventDefault();
        event.stopPropagation();
        const sessionId = button.getAttribute("data-session-rename");
        const currentName = button.getAttribute("data-session-current-name") ?? "";
        if (!sessionId) return;
        const nextName = window.prompt("Session name", currentName);
        if (nextName == null) return;
        const trimmed = nextName.trim();
        if (!trimmed || trimmed === currentName.trim()) return;
        const response = await fetch("/api/catalog", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "rename", analysisRunId: sessionId, sessionName: trimmed }),
        });
        const payload = await readJsonResponse(response);
        if (!response.ok) {
          status && (status.textContent = payload.error ?? "Could not rename the session.");
          return;
        }
        const nextUrl = new URL(window.location.href);
        if (parsed.session?.id === sessionId) {
          window.location.assign(nextUrl.toString());
          return;
        }
        nextUrl.searchParams.delete("session");
        nextUrl.searchParams.set("tab", String(getActiveTabIndex()));
        nextUrl.searchParams.delete("job");
        window.location.assign(nextUrl.toString());
      });
    });

    async function saveDecision(label) {
      if (!parsed.session?.id || !current) return;
      if (String(current.id).startsWith("fn-")) return;
      const savedDetectionId = current.id;
      const subtype = isEvaluationSession() ? (decisionSubtype?.value?.trim() || null) : null;
      const eventLabel = isEvaluationSession() ? (eventLabelSelect?.value?.trim() || null) : null;
      const candidateUsefulness = isEvaluationSession() ? (candidateUsefulnessSelect?.value?.trim() || null) : null;
      const clipQualityValue = isEvaluationSession() ? (clipQualitySelect?.value?.trim() || "") : "";
      const clipQuality = isEvaluationSession() && clipQualityValue
        ? { clip_quality: clipQualityValue }
        : null;
      const anchorQualityValueSelected = isEvaluationSession() ? (anchorQualitySelect?.value?.trim() || "") : "";
      const anchorQuality = isEvaluationSession() && anchorQualityValueSelected
        ? anchorQualityValueSelected
        : null;
      const cleanupError = validateCleanupDecision(label, eventLabel, candidateUsefulness, clipQualityValue, anchorQualityValueSelected);
      if (cleanupError) {
        decisionStatus && (decisionStatus.textContent = cleanupError);
        return;
      }
      const response = await fetch(cleanupQueueActive ? "/api/cleanup-review" : "/api/review", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        cache: "no-store",
        body: JSON.stringify({
          analysisRunId: parsed.session.id,
          detectionId: savedDetectionId,
          label,
          eventLabel,
          subtype,
          candidateUsefulness,
          clipQuality,
          anchorQuality,
          notes: decisionNotes?.value ?? "",
        }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        decisionStatus && (decisionStatus.textContent = payload.error ?? "Could not save your decision.");
        return;
      }
      upsertDecisionSnapshot(payload.decision);
      const activeQueueNode = queueNodeForDetection(savedDetectionId);
      if (cleanupQueueActive && activeQueueNode) {
        activeQueueNode.setAttribute("data-queue-cleanup-review-label", String(payload.decision.label ?? ""));
        activeQueueNode.setAttribute("data-queue-cleanup-event-label", String(payload.decision.eventLabel ?? ""));
        activeQueueNode.setAttribute("data-queue-cleanup-anchor-quality", anchorQualityValue(payload.decision.anchorQuality));
        activeQueueNode.setAttribute("data-queue-cleanup-usefulness", String(payload.decision.candidateUsefulness ?? ""));
        activeQueueNode.setAttribute("data-queue-cleanup-clip-quality", String(payload.decision.clipQuality?.clip_quality ?? ""));
      }
      syncCurrentDecisionUi();
      updateRefinementQueueState();
      // Auto-advance: move to next unreviewed priority queue row after save
      const moved = moveRefinementQueueForwardAfterSave(savedDetectionId, label);
      if (!moved) {
        decisionStatus && (decisionStatus.textContent = `Saved ${payload.decision.label} for ${payload.decision.detectionId}.`);
      }
      if (sortEnabled) {
        telemetryDecisionsWhileSorted += 1;
        emitRowTelemetry("review_sort_decision_made_while_sorted", savedDetectionId, {
          decision_label: label,
        });
      }
      if (shadowV2Active) {
        emitTelemetry({
          event_type: "shadow_v2_decision_recorded",
          schema_version: "r182_shadow_v2_telemetry_v1",
          v2_shadow_active: true,
          candidate_id: String(savedDetectionId),
          review_label: String(label ?? ""),
          event_label: eventLabelSelect?.value?.trim() || null,
          anchor_quality: anchorQualitySelect?.value?.trim() || null,
          candidate_usefulness: candidateUsefulnessSelect?.value?.trim() || null,
          clip_quality: clipQualitySelect?.value?.trim() || null,
        });
      }
      await refreshDecisions();
      if (moveRefinementQueueForwardAfterSave(savedDetectionId, payload.decision.label)) {
        return;
      }
      moveReviewForwardAfterDecision(savedDetectionId, payload.decision.label);
    }

    async function saveEventLabelOnly() {
      if (!parsed.session?.id || !current) return;
      if (String(current.id).startsWith("fn-")) {
        const savedDetectionId = current.id;
        const response = await fetch("/api/review", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          cache: "no-store",
          body: JSON.stringify({
            analysisRunId: parsed.session.id,
            detectionId: current.id,
            label: "false_negative",
            eventLabel: eventLabelSelect?.value?.trim() || null,
            subtype: decisionSubtype?.value?.trim() || null,
            candidateUsefulness: candidateUsefulnessSelect?.value?.trim() || null,
            clipQuality: clipQualitySelect?.value?.trim() ? { clip_quality: clipQualitySelect.value.trim() } : null,
            anchorQuality: anchorQualitySelect?.value?.trim() || null,
            notes: decisionNotes?.value ?? "",
          }),
        });
        const payload = await readJsonResponse(response);
        if (!response.ok) {
          decisionStatus && (decisionStatus.textContent = payload.error ?? "Could not save the event label.");
          return;
        }
        const annotation = payload.annotation ?? null;
        if (annotation?.id) {
          falseNegativeAnnotations = falseNegativeAnnotations.map((item) =>
            item.id === annotation.id ? { ...item, ...annotation } : item
          );
          rebuildDetections();
          current = detections.find((item) => item.id === annotation.id) ?? current;
          syncCurrentDecisionUi();
          updateRefinementQueueState();
        }
        decisionStatus && (decisionStatus.textContent = `Saved event label for ${savedDetectionId}.`);
        await refreshDecisions();
        if (moveRefinementQueueForwardAfterSave(savedDetectionId, "false_negative")) {
          return;
        }
        moveReviewForwardAfterEventSave(savedDetectionId, "event label");
        return;
      }
      const existingDecision = decisionFor(current.id);
      if (!existingDecision) {
        decisionStatus && (decisionStatus.textContent = "Save the legacy decision first, then save the event label.");
        return;
      }
      const savedDetectionId = current.id;
      const response = await fetch("/api/review", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        cache: "no-store",
        body: JSON.stringify({
          analysisRunId: parsed.session.id,
          detectionId: savedDetectionId,
          label: existingDecision.label,
          eventLabel: eventLabelSelect?.value?.trim() || null,
          subtype: decisionSubtype?.value?.trim() || null,
          candidateUsefulness: candidateUsefulnessSelect?.value?.trim() || null,
          clipQuality: clipQualitySelect?.value?.trim() ? { clip_quality: clipQualitySelect.value.trim() } : null,
          anchorQuality: anchorQualitySelect?.value?.trim() || null,
          notes: decisionNotes?.value ?? "",
        }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        decisionStatus && (decisionStatus.textContent = payload.error ?? "Could not save the event label.");
        return;
      }
      upsertDecisionSnapshot(payload.decision);
      syncCurrentDecisionUi();
      updateRefinementQueueState();
      decisionStatus && (decisionStatus.textContent = `Saved event label for ${payload.decision.detectionId}.`);
      await refreshDecisions();
      if (moveRefinementQueueForwardAfterSave(savedDetectionId, payload.decision.label)) {
        return;
      }
      moveReviewForwardAfterEventSave(savedDetectionId, "event label");
    }

    async function saveFalseNegative() {
      if (!parsed.session?.id || !isEvaluationSession()) return;
      const timestampSeconds = Number(reviewVideo?.currentTime ?? current?.timestamp_seconds ?? 0);
      const subtype = decisionSubtype?.value?.trim() || null;
      const response = await fetch("/api/review", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        cache: "no-store",
        body: JSON.stringify({
          analysisRunId: parsed.session.id,
          label: "false_negative",
          timestampSeconds,
          subtype,
          eventLabel: eventLabelSelect?.value?.trim() || null,
          candidateUsefulness: candidateUsefulnessSelect?.value?.trim() || null,
          clipQuality: clipQualitySelect?.value?.trim() ? { clip_quality: clipQualitySelect.value.trim() } : null,
          anchorQuality: anchorQualitySelect?.value?.trim() || null,
          notes: decisionNotes?.value ?? "",
        }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        decisionStatus && (decisionStatus.textContent = payload.error ?? "Could not save the false negative.");
        return;
      }
      decisionStatus && (decisionStatus.textContent = `Logged a false negative at ${formatSeconds(timestampSeconds)}.`);
      await refreshDecisions();
      if (payload.annotation?.id) {
        selectDetection(payload.annotation.id, { autoplay: false, scrollQueue: true });
      }
    }

    async function removeFalseNegativeAnnotation(detectionId) {
      if (!parsed.session?.id || !isEvaluationSession()) return;
      const response = await fetch("/api/review", {
        method: "DELETE",
        headers: { "Content-Type": "application/json" },
        cache: "no-store",
        body: JSON.stringify({
          analysisRunId: parsed.session.id,
          detectionId,
        }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        decisionStatus && (decisionStatus.textContent = payload.error ?? "Could not remove false negative.");
        return;
      }
      decisionStatus && (decisionStatus.textContent = `Removed ${detectionId}.`);
      await refreshDecisions();
      const fallback = detections.find((item) => item.id !== detectionId) ?? null;
      if (fallback) {
        selectDetection(fallback.id, { autoplay: false, scrollQueue: true });
      }
    }

    function isTypingTarget(target) {
      const element = target instanceof HTMLElement ? target : null;
      if (!element) return false;
      const tagName = element.tagName.toLowerCase();
      return tagName === "input" || tagName === "textarea" || tagName === "select" || element.isContentEditable;
    }

    async function applyEvaluationShortcut(label, subtype, eventLabel, description) {
      if (!isEvaluationSession() || !current) return;
      if (String(current.id).startsWith("fn-")) {
        decisionStatus && (decisionStatus.textContent = "Use Save event label for manual false negatives.");
        return;
      }
      if (decisionSubtype) decisionSubtype.value = subtype ?? "";
      if (eventLabelSelect) eventLabelSelect.value = eventLabel ?? "";
      decisionStatus && (decisionStatus.textContent = `${description}: saving ${current.id}...`);
      await saveDecision(label);
    }

    document.querySelectorAll("[data-decision]").forEach((button) => {
      button.addEventListener("click", async () => {
        await saveDecision(button.getAttribute("data-decision"));
      });
    });
    eventSaveButton?.addEventListener("click", async () => {
      await saveEventLabelOnly();
    });
    previousButton?.addEventListener("click", () => {
      selectAdjacentDetection(-1);
    });
    nextButton?.addEventListener("click", () => {
      selectAdjacentDetection(1);
    });
    falseNegativeButton?.addEventListener("click", async () => {
      await saveFalseNegative();
    });
    splashPauseButton?.addEventListener("click", () => {
      splashPauseEnabled = !splashPauseEnabled;
      updateSplashPauseButton();
    });
    sidebarModeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        setSidebarMode(button.getAttribute("data-sidebar-mode-target") ?? "review");
      });
    });
    candidateUsefulnessSelect?.addEventListener("change", () => {
      applyUsefulnessAutofill();
    });
    eventLabelSelect?.addEventListener("change", () => {
      applyUsefulnessAutofill();
    });
    decisionSubtype?.addEventListener("change", () => {
      applyUsefulnessAutofill();
    });

    function renderExportList(paths) {
      exportedPaths = paths ?? [];
      if (!exportList) return;
      if (isEvaluationSession()) {
        exportList.innerHTML = `
          <article>
            <strong>Cached evaluation artifacts</strong>
            <span>Audio and proxy generation happen once. Review decisions and false negatives update the evaluation session without re-running full video ingest.</span>
          </article>
        `;
        updateReviewCounts();
        renderExportInsights();
        return;
      }
      const exportedByName = new Map(
        exportedPaths.map((item) => {
          const name = item.split("/").pop() ?? item;
          return [name, item];
        }),
      );
      const kept = keptDetections();
      if (!kept.length) {
        exportList.innerHTML = "<article><strong>Nothing ready yet.</strong><span>Mark attempts as Keep in Review to prepare them for export.</span></article>";
        updateReviewCounts();
        renderExportInsights();
        return;
      }
      exportList.innerHTML = kept.map((item) => {
        const expectedName = item.clip.filename ?? `${item.id}.mp4`;
        const exportedPath = exportedByName.get(expectedName);
        const exported = Boolean(exportedPath);
        const title = `Dive ${item.index}`;
        const subtitle = `Splash at ${formatSeconds(item.timestamp_seconds)}`;
        const previewPath = item.reviewClipPath ?? item.clip?.browser_path ?? item.clip?.path ?? null;
        const previewUrl = previewPath
          ? `/api/media?path=${encodeURIComponent(previewPath)}`
          : (parsed.primaryVideoUrl ?? parsed.sourceVideoUrl ?? "");
        const previewMarkup = previewUrl
          ? `<video class="export-card__thumb" muted playsinline preload="metadata" src="${previewUrl}#t=${Math.max(0, Number(item.review_start_seconds ?? item.start_time_seconds ?? item.timestamp_seconds ?? 0)).toFixed(3)}"></video>`
          : `<div class="export-card__thumb export-card__thumb--empty" aria-hidden="true"></div>`;
        return exported
          ? `
            <a href="/api/media?path=${encodeURIComponent(exportedPath)}" target="_blank" class="export-card export-card--done">
              ${previewMarkup}
              <div class="export-card__body">
                <strong>${title}</strong>
                <span>${subtitle}</span>
                <em>Exported</em>
              </div>
            </a>
          `
          : `
            <article class="export-card export-card--ready">
              ${previewMarkup}
              <div class="export-card__body">
                <strong>${title}</strong>
                <span>${subtitle}</span>
              </div>
            </article>
          `;
      }).join("");
      updateReviewCounts();
      renderExportInsights();
    }

    function formatExportStatus(payload) {
      const totalCount = Number(payload?.detectionIds?.length ?? 0);
      const exportedCount = Number(payload?.exportedPaths?.length ?? 0);

      if (payload?.status === "failed") {
        return payload.error ?? "Export failed. Try again.";
      }

      if (payload?.status === "completed") {
        if (exportedCount <= 0) return "Export finished.";
        return `${exportedCount} clip${exportedCount === 1 ? "" : "s"} ready.`;
      }

      if (payload?.phase === "queued") {
        return totalCount > 0
          ? `Preparing ${totalCount} clip${totalCount === 1 ? "" : "s"} for export...`
          : "Preparing export...";
      }

      if (payload?.phase === "preparing") {
        return totalCount > 0
          ? `Getting ${totalCount} clip${totalCount === 1 ? "" : "s"} ready...`
          : "Getting export ready...";
      }

      if (payload?.phase === "exporting") {
        const currentCount = Math.min(totalCount || exportedCount + 1, exportedCount + 1);
        if (totalCount > 0) {
          return `Exporting clip ${currentCount} of ${totalCount}...`;
        }
        return "Exporting clips...";
      }

      return "Working on your export...";
    }

    async function pollExportJob(jobId) {
      exportJobId = jobId;
      while (true) {
        const response = await fetch(`/api/export?job=${encodeURIComponent(jobId)}`);
        const payload = await readJsonResponse(response);
        if (payload?._invalidJson) {
          exportStatus && (exportStatus.textContent = payload.error ?? "Could not read the export status.");
          return;
        }
        exportStatus && (exportStatus.textContent = formatExportStatus(payload));
        if (payload.status === "completed") {
          renderExportList(payload.exportedPaths ?? []);
          return;
        }
        if (payload.status === "failed") {
          exportStatus && (exportStatus.textContent = payload.error ?? "The export failed.");
          return;
        }
        await new Promise((resolve) => setTimeout(resolve, 1200));
      }
    }

    exportButton?.addEventListener("click", async () => {
      if (!parsed.session?.id) return;
      exportStatus && (exportStatus.textContent = "Starting export job...");
      const response = await fetch("/api/export", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ analysisRunId: parsed.session.id }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        exportStatus && (exportStatus.textContent = payload.error ?? "Could not start the export.");
        return;
      }
      setTab(2);
      await pollExportJob(payload.id);
    });

    document.addEventListener("keydown", (event) => {
      if (isTypingTarget(event.target)) return;
      const key = event.key.toLowerCase();
      const reviewShortcutActive = isEvaluationSession() && getActiveTabIndex() === 1 && !event.repeat;
      if (reviewShortcutActive && event.shiftKey && !event.metaKey && !event.ctrlKey && !event.altKey && key === "b") {
        event.preventDefault();
        void applyEvaluationShortcut("non_dive", "board_rebound", "springboard_rebound_only", "Shortcut board rebound");
        return;
      }
      if (reviewShortcutActive && event.shiftKey && !event.metaKey && !event.ctrlKey && !event.altKey && key === "n") {
        event.preventDefault();
        void applyEvaluationShortcut("non_dive", "voice_whistle", "noise_or_other", "Shortcut voice/whistle");
        return;
      }
      if (reviewShortcutActive && event.shiftKey && !event.metaKey && !event.ctrlKey && !event.altKey && key === "h") {
        event.preventDefault();
        void applyEvaluationShortcut("non_dive", "handling_noise", "noise_or_other", "Shortcut handling noise");
        return;
      }
      if (reviewShortcutActive && event.shiftKey && !event.metaKey && !event.ctrlKey && !event.altKey && key === "p") {
        event.preventDefault();
        void applyEvaluationShortcut("dive", "", "platform_dive", "Shortcut platform dive");
        return;
      }
      if (reviewShortcutActive && event.shiftKey && !event.metaKey && !event.ctrlKey && !event.altKey && key === "s") {
        event.preventDefault();
        void applyEvaluationShortcut("dive", "", "springboard_dive", "Shortcut springboard dive");
        return;
      }
      if (event.key === " ") {
        event.preventDefault();
        if (reviewVideo?.paused) {
          void playCurrentSegment();
        } else {
          reviewVideo?.pause();
        }
      } else if (event.key === "ArrowRight") {
        selectAdjacentDetection(1);
      } else if (event.key === "ArrowLeft") {
        selectAdjacentDetection(-1);
      } else if (!isEvaluationSession() && event.key.toLowerCase() === "k") {
        void saveDecision("keep");
      } else if (!isEvaluationSession() && event.key.toLowerCase() === "r") {
        void saveDecision("reject");
      } else if (key === "u") {
        void saveDecision("unsure");
      } else if (isEvaluationSession() && key === "d") {
        void saveDecision("dive");
      } else if (isEvaluationSession() && key === "n") {
        void saveDecision("non_dive");
      } else if (isEvaluationSession() && key === "f") {
        void saveFalseNegative();
      }
    });

    updateReviewModeCopy();
    configureCleanupModeUi();
    updateToggleButtons();
    updateSplashPauseButton();
    renderExportList(exportedPaths);
    installMediaSessionHandlers();
    syncVideoSource();
    rebuildDetections();
    updateQueueNavigationState();
    renderDetectionTable();
    if (current) selectDetection(current.id, { autoplay: autoPlayEnabled });
    refreshDecisions();
  </script>
</main>
