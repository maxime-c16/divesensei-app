---
import path from "node:path";
import brandLockupDark from "@/assets/divesensei-lockup-dark.svg";
import { getWorkspaceCopy } from "@/lib/copy";
import { getSessionExportState } from "@/lib/export-state";
import {
  formatDurationLabel,
  formatSeconds,
  getUiData,
  mediaUrl,
  resolveClipMediaPath,
  resolveSourceMediaPath,
  sessionIsReviewReady,
  sessionStatusLabel,
} from "@/lib/ui-data";

interface ThemeConfig {
  id: string;
  name: string;
  route: string;
  tagline: string;
  subtitle: string;
  tabs: [string, string, string, string];
}

const { theme } = Astro.props as { theme: ThemeConfig };
const copy = getWorkspaceCopy();
const requestedSession = Astro.url.searchParams.get("session") ?? undefined;
const requestedTab = Astro.url.searchParams.get("tab");
const requestedJob = Astro.url.searchParams.get("job");
const activeTabIndex = Number.parseInt(requestedTab ?? "0", 10);
const initialTabIndex = Number.isNaN(activeTabIndex) ? 0 : Math.max(0, Math.min(theme.tabs.length - 1, activeTabIndex));
const { library, manifest, selectedSessionId, artifactsPreview } = getUiData(requestedSession);
const hasSession = library.session_count > 0;
const session = manifest.session;
const detections = manifest.detections.map((item) => ({
  ...item,
  reviewClipPath: resolveClipMediaPath(item.clip.browser_path ?? item.clip.path),
}));
const selected = detections[0];
const highest = [...detections].sort((a, b) => b.scores.combined - a.scores.combined)[0] ?? selected;
const defaultSessionName = `Session ${new Intl.DateTimeFormat("sv-SE", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(new Date()).replace(" ", " ").replace(",", "")}`;
const sessionReadyNow = sessionIsReviewReady(session.status);
const primaryVideoUrl = mediaUrl(resolveSourceMediaPath(session.source_video_path, session.output_dir));
const sourceVideoUrl = mediaUrl(session.source_video_path);
const sourceVideoBrowserFriendly = [".mp4", ".webm", ".m4v"].includes(path.extname(session.source_video_path).toLowerCase());
const initialReviewVideoUrl = session.status === "ready_proxy_pending" && !sourceVideoBrowserFriendly ? "" : primaryVideoUrl;
const initialReviewPlaceholderVisible = session.status === "ready_proxy_pending" && !sourceVideoBrowserFriendly;
const timelineStart = 0;
const timelineEnd = Math.max(
  Number(session.session_duration_seconds ?? 0),
  Number(session.timestamp_range.last ?? 0),
  1,
);
const rangeStart = timelineStart;
const rangeSpan = Math.max(timelineEnd - timelineStart, 1);
const niceTimelineStep = (span: number) => {
  const targetTicks = 7;
  const rough = Math.max(span / targetTicks, 0.5);
  const steps = [0.5, 1, 2, 5, 10, 15, 20, 30, 45, 60, 90, 120, 180, 300, 600];
  return steps.find((step) => rough <= step) ?? steps[steps.length - 1];
};
const timelineStep = niceTimelineStep(rangeSpan);
const timelineTicks = (() => {
  const ticks: Array<{ value: number; left: number; label: string }> = [];
  const firstTick = Math.ceil(rangeStart / timelineStep) * timelineStep;
  for (let value = firstTick; value < timelineEnd; value += timelineStep) {
    if (value <= rangeStart + 0.01 || value >= timelineEnd - 0.01) continue;
    const left = Math.min(99.2, Math.max(0.8, ((value - rangeStart) / rangeSpan) * 100));
    ticks.push({ value, left, label: formatSeconds(value) });
  }
  return ticks;
})();
const timelineScaleLabels = [
  { left: 0.8, label: formatSeconds(timelineStart), edge: "start" },
  ...timelineTicks.map((tick) => ({ left: tick.left, label: tick.label, edge: "mid" })),
  { left: 99.2, label: formatSeconds(timelineEnd), edge: "end" },
];
const markerPosition = (timestamp: number) => {
  const normalized = ((timestamp - rangeStart) / rangeSpan) * 100;
  return Math.min(99.2, Math.max(0.8, normalized));
};
const reviewStartFor = (item: typeof detections[number]) => item.review_start_seconds ?? item.start_time_seconds;
const reviewEndFor = (item: typeof detections[number]) => item.review_end_seconds ?? item.end_time_seconds;
const signalLabelFor = (confidence: string) => {
  if (confidence === "high") return "Strong";
  if (confidence === "medium") return "Review";
  return "Weak";
};
const detectorLabelFor = (value: string | undefined) => {
  if (!value || value === "audio_v2_pcen_classifier") return "Standard audio";
  if (value === "audio_v1_heuristic") return "Legacy audio";
  if (value === "audio_v2_hybrid_video") return "Audio + video";
  return value.replaceAll("_", " ");
};
const profileLabelFor = (value: string | undefined) => {
  if (!value || value === "long-session") return "Training session";
  if (value === "reviewed") return "Reviewed session";
  return value.replaceAll("-", " ");
};
const formatSessionStamp = (value: string | undefined) => {
  if (!value) return "Unknown";
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return value;
  return new Intl.DateTimeFormat("en-GB", {
    year: "numeric",
    month: "short",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  }).format(parsed);
};
const sessionDisplayName = session.session_name ?? session.title;
const hasActiveSession = hasSession && Boolean(session.id);
const sessionDurationSeconds = Number(session.session_duration_seconds ?? session.timestamp_range.last ?? 0);
const analysisRuntimeSeconds = Number(session.telemetry.total_runtime_seconds ?? 0);
const sourceVideoLabel = session.source_video_path ? path.basename(session.source_video_path) : "No video selected";
const topAttemptSummary = highest
  ? `${formatSeconds(highest.timestamp_seconds)} · ${highest.confidence} confidence`
  : "Analysis not run yet";
const nextActionLabel = !hasActiveSession
  ? copy.sessions.defaultAction
  : detections.length === 0
    ? copy.sessions.noAttemptsFound
    : sessionReadyNow
      ? copy.sessions.nextActionReady
      : copy.sessions.nextActionPending;
const recentSessions = library.sessions.slice(0, 5).map(item => ({
  id: item.id,
  session_name: item.session_name ?? item.title,
  title: item.title,
  candidate_count: item.candidate_count,
  extracted_count: item.extracted_count,
  updated_at: item.updated_at,
}));
const initialExportedPaths: string[] = hasActiveSession ? getSessionExportState(session.output_dir).exportedPaths : [];
const clientBundle = JSON.stringify({
  copy,
  hasSession,
  session,
  detections,
  primaryVideoUrl,
  sourceVideoUrl,
  rangeStart,
  rangeSpan,
  initialReviewPending: initialReviewPlaceholderVisible,
  requestedTab,
  requestedSession,
  requestedJob,
  recentSessions,
  initialExportedPaths,
});
---

<main class={`screen theme-${theme.id}`} data-design-root>
  <header class="workspace-header shell">
    <a class="brand-lockup" href="/" aria-label="DiveSensei home">
      <img src={brandLockupDark.src} alt="DiveSensei" class="brand-lockup__image" />
    </a>
    <nav class="header-nav" aria-label="Workspace tabs">
      {theme.tabs.map((tab, index) => (
        <button
          class={`tab ${index === initialTabIndex ? "is-active" : ""}`}
          type="button"
          data-tab-trigger
          data-tab-target={`panel-${index}`}
        >
          {tab}
        </button>
      ))}
    </nav>
  </header>

  <section class={`panel shell ${initialTabIndex === 0 ? "is-active" : ""}`} id="panel-0" data-tab-panel>
    <div class="grid library-grid">
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>{copy.sessions.heading}</h2>
            <p class="section-note">{copy.sessions.subtitle}</p>
          </div>
          <span class="counter" data-session-total>{library.session_count} total</span>
        </div>
        {sessionReadyNow && session.status === "ready_proxy_pending" && (
          <div class="library-inline-note">
            <strong>Ready to review.</strong> The review video is still being prepared.
          </div>
        )}
        <form class="analysis-launcher" data-analysis-form>
          <div class="section-card__header">
            <div>
              <h3>{copy.sessions.newRunHeading}</h3>
              <p class="section-note">{copy.sessions.newRunSubtitle}</p>
            </div>
          </div>
          <div class="analysis-launcher__grid">
            <label class="field">
              <span>{copy.fields.sessionName}</span>
              <input
                type="text"
                name="sessionName"
                value={defaultSessionName}
                data-analysis-session-name
                data-default-session-name={defaultSessionName}
                autocomplete="off"
              />
            </label>
            <label class="field">
              <span>{copy.fields.videoFile}</span>
              <div class="analysis-picker">
                <input type="text" name="videoPath" value="" data-analysis-path autocomplete="off" placeholder="/absolute/path/to/video.mov" />
                <div class="analysis-picker__controls">
                  <button type="button" class="action-link analysis-picker__button" data-analysis-pick>{copy.actions.chooseFile}</button>
                  <span class="analysis-picker__label" data-analysis-file-label>No file selected. You can still paste a path manually.</span>
                </div>
                <input
                  type="file"
                  accept="video/*,.mov,.mp4,.m4v,.avi,.mkv,.webm"
                  class="analysis-picker__native"
                  data-analysis-file
                />
              </div>
            </label>
            <label class="field">
              <span>{copy.fields.sessionType}</span>
              <select name="profile" data-analysis-profile>
                <option value="long-session" selected>Training session</option>
                <option value="reviewed">Reviewed run</option>
              </select>
            </label>
            <label class="field">
              <span>{copy.fields.detector}</span>
              <select name="detectorId" data-analysis-detector>
                <option value="audio_v2_pcen_classifier" selected>Standard</option>
                <option value="audio_v1_heuristic">Legacy audio</option>
                <option value="audio_v2_hybrid_video">Audio + video</option>
              </select>
            </label>
          </div>
          <div class="analysis-launcher__actions launcher-actions">
            <button type="submit" class="action-link action-link--primary">{copy.actions.startAnalysis}</button>
          </div>
          <p class="analysis-launcher__status" data-analysis-status>{copy.sessions.idleStatus}</p>
        </form>
        <div class="session-list">
          {library.sessions.map((item) => (
            <article class={`session-listing ${item.id === selectedSessionId ? "is-current" : ""}`} data-session-row={item.id}>
              <div class="session-listing__main">
                <div class="session-listing__summary">
                  <strong>{item.session_name ?? item.title}</strong>
                  <small>{path.basename(item.source_video_path)}</small>
                  <small>Updated {formatSessionStamp(item.updated_at ?? item.created_at)}</small>
                  <small class="session-listing__status">{sessionStatusLabel(item.status)}</small>
                </div>
                <div class="session-listing__stats">
                  <span>{item.candidate_count} attempts</span>
                  <span data-session-export-count={item.id}>{item.extracted_count} exports</span>
                  <span>Duration {formatDurationLabel(item.timestamp_range.last)}</span>
                </div>
              </div>
              <div class="session-listing__actions">
                <button type="button" class="action-link" data-session-open={item.id}>{copy.actions.open}</button>
                <button type="button" class="action-link" data-session-rename={item.id} data-session-current-name={item.session_name ?? item.title}>{copy.actions.rename}</button>
                <button type="button" class="action-link session-delete" data-session-delete={item.id}>{copy.actions.delete}</button>
              </div>
            </article>
          ))}
        </div>
      </article>

      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>{copy.sessions.currentSessionHeading}</h2>
            <p class="section-note">{hasActiveSession ? sessionDisplayName : copy.sessions.noSessionSelected}</p>
          </div>
        </div>
        {hasActiveSession ? (
          <>
            <div class="session-summary">
              <div class="session-summary__hero">
                <strong>{sourceVideoLabel}</strong>
                <span>{sessionStatusLabel(session.status)}</span>
              </div>
              <p class="session-summary__note">{nextActionLabel}</p>
              <dl class="session-summary__grid">
                <div>
                  <dt>Detector</dt>
                  <dd>{detectorLabelFor(session.detector_id)}</dd>
                </div>
                <div>
                  <dt>Profile</dt>
                  <dd>{profileLabelFor(session.profile)}</dd>
                </div>
                <div>
                  <dt>Video length</dt>
                  <dd>{formatDurationLabel(sessionDurationSeconds)}</dd>
                </div>
                <div>
                  <dt>Analysis time</dt>
                  <dd>{analysisRuntimeSeconds > 0 ? `${analysisRuntimeSeconds.toFixed(2)}s` : "Pending"}</dd>
                </div>
                <div>
                  <dt>Attempts found</dt>
                  <dd>{detections.length}</dd>
                </div>
                <div>
                  <dt>Exports</dt>
                  <dd data-current-export-count>{session.extracted_count}</dd>
                </div>
                <div>
                  <dt>Best candidate</dt>
                  <dd>{topAttemptSummary}</dd>
                </div>
                <div>
                  <dt>Updated</dt>
                  <dd>{formatSessionStamp(session.updated_at)}</dd>
                </div>
              </dl>
              <div class="session-summary__path-block">
                <span>Video path</span>
                <code>{session.source_video_path}</code>
              </div>
            </div>
            <div class="action-list">
              <button class="action-link" type="button" data-open-tab="1">{copy.actions.openReview}</button>
              <button class="action-link" type="button" data-open-tab="3">{copy.actions.openDiagnostics}</button>
            </div>
          </>
        ) : (
          <div class="session-summary session-summary--empty">
            <div class="session-summary__hero">
              <strong>{copy.sessions.noSessionSelected}</strong>
              <span>Ready to start</span>
            </div>
            <p class="session-summary__note">{copy.sessions.emptySessionNote}</p>
            <div class="session-summary__empty-grid">
              <article>
                <strong>1. {copy.sessions.chooseVideoStep}</strong>
                <p>Choose a file or paste an absolute path.</p>
              </article>
              <article>
                <strong>2. {copy.sessions.startRunStep}</strong>
                <p>DiveSensei finds likely attempts and prepares them for review.</p>
              </article>
              <article>
                <strong>3. {copy.sessions.reviewExportStep}</strong>
                <p>Open the review tab, keep the right attempts, then export only those clips.</p>
              </article>
            </div>
          </div>
        )}
      </article>
    </div>
  </section>

  <section class={`panel panel--review shell ${initialTabIndex === 1 ? "is-active" : ""}`} id="panel-1" data-tab-panel>
    <div class="review-layout">
      <article class="review-main">
        <div class="review-main__top">
          <span data-review-current>Attempt {selected?.index ?? 0}</span>
          <span data-review-counts>{detections.length} waiting</span>
          <span data-review-position>{selected ? `${selected.index} of ${detections.length}` : "0 of 0"}</span>
          <span data-review-time>{selected ? formatSeconds(selected.timestamp_seconds) : "0:00.000"}</span>
        </div>
        <div class="review-main__video">
          <div class="player-stage__frame">
            <video
              class="review-video"
              controls
              preload="metadata"
              playsinline
              src={initialReviewVideoUrl || undefined}
              data-review-video
              data-source-src={primaryVideoUrl}
            ></video>
            <div class="library-inline-note" data-review-placeholder hidden={!initialReviewPlaceholderVisible}>
              The review video for this file is still being prepared. Playback will appear automatically.
            </div>
          </div>
        </div>
        <div class="review-main__controls">
          <div class="review-decisions">
            <button class="action-link review-decisions__button review-decisions__button--keep" type="button" data-decision="keep">{copy.actions.keep}</button>
            <button class="action-link review-decisions__button review-decisions__button--reject" type="button" data-decision="reject">{copy.actions.reject}</button>
            <button class="action-link review-decisions__button review-decisions__button--unsure" type="button" data-decision="unsure">{copy.actions.unsure}</button>
            <input type="text" class="review-decisions__note" data-decision-notes placeholder={copy.review.notePlaceholder} />
          </div>
        </div>
        <div class="review-main__timeline">
          <div class="tl" data-timeline-viewport>
            <div class="tl__scale">
              {timelineScaleLabels.map((tick) => (
                <span
                  class={`tl__time tl__time--${tick.edge}`}
                  style={`left:${tick.left}%;`}
                >
                  {tick.label}
                </span>
              ))}
            </div>
            <div class="tl__track" data-timeline-track>
              <div class="tl__playhead" data-timeline-playhead></div>
              <div class="tl__tooltip" data-timeline-tooltip hidden></div>
              {timelineTicks.map((tick) => (
                <span
                  class="tl__tick"
                  style={`left:${tick.left}%;`}
                  aria-hidden="true"
                ></span>
              ))}
              {detections.map((item) => (
                <button
                  type="button"
                  class={`tl__pip confidence-${item.confidence} ${item.id === selected?.id ? "is-current" : ""}`}
                  style={`left:${markerPosition(item.timestamp_seconds)}%;`}
                  data-focus-detection={item.id}
                  data-timeline-marker={item.id}
                  data-pip-index={item.index}
                  data-pip-time={formatSeconds(item.timestamp_seconds)}
                  aria-label={`Attempt ${item.index} at ${formatSeconds(item.timestamp_seconds)}`}
                ></button>
              ))}
            </div>
          </div>
        </div>
        <p class="review-main__status" data-decision-status hidden>{copy.review.noDecisionYet}</p>
        <div class="library-inline-note" data-review-progress hidden>
          Review is available now. Export only the clips you keep.
        </div>
      </article>

      <aside class="review-sidebar">
        <div class="review-sidebar__header">
          <h2 data-review-list-title>{copy.review.attemptsHeading}</h2>
          <select class="review-sidebar__filter" data-review-filter>
            <option value="all" selected>{copy.review.allFilter}</option>
            <option value="pending">{copy.review.pendingFilter}</option>
            <option value="keep">{copy.review.keptFilter}</option>
            <option value="reject">{copy.review.rejectedFilter}</option>
            <option value="unsure">{copy.review.unsureFilter}</option>
          </select>
        </div>
        <div class="review-sidebar__list">
          <table class="queue-table">
            <thead>
              <tr>
                <th>Attempt</th>
                <th>Splash</th>
                <th>Decision</th>
                <th>Signal</th>
              </tr>
            </thead>
            <tbody data-detection-table>
              {detections.map((item) => (
                <tr class={item.id === selected?.id ? "is-current" : ""} data-focus-detection={item.id}>
                  <td>{item.id}</td>
                  <td>{formatSeconds(item.timestamp_seconds)}</td>
                  <td>Pending</td>
                  <td>{signalLabelFor(item.confidence)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="detail-bar">
          <span data-detail-audio>Audio {selected ? selected.scores.audio.toFixed(2) : "0.00"}</span>
          <span data-detail-window>Window {selected ? `${formatSeconds(reviewStartFor(selected))} to ${formatSeconds(reviewEndFor(selected))}` : "0:00.000 to 0:00.000"}</span>
          <span data-detail-decision>No decision yet</span>
        </div>
      </aside>
    </div>
  </section>

  <section class={`panel shell ${initialTabIndex === 2 ? "is-active" : ""}`} id="panel-2" data-tab-panel>
    <div class="grid library-grid exports-grid">
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>{copy.exports.heading}</h2>
            <p class="section-note">{copy.exports.subtitle}</p>
          </div>
          <span class="counter" data-export-total-count>{session.extracted_count} exports</span>
        </div>
        <div class="analysis-launcher__actions export-actions">
          <button class="action-link action-link--primary" type="button" data-export-kept>{copy.actions.exportKeptClips}</button>
        </div>
        <p class="analysis-launcher__status" data-export-status>{copy.exports.idleStatus}</p>
        <div class="export-section" data-export-pending-section>
          <h3 class="export-section__title">{copy.exports.readyHeading}</h3>
          <div class="artifact-grid" data-export-pending-list></div>
        </div>
        <div class="export-section" data-export-done-section>
          <h3 class="export-section__title">{copy.exports.exportedHeading}</h3>
          <div class="artifact-grid" data-export-list></div>
        </div>
      </article>
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>{copy.exports.progressHeading}</h2>
            <p class="section-note">{copy.exports.progressSubtitle}</p>
          </div>
        </div>
        <div class="export-progress-grid" data-export-progress>
          <div class="export-progress-stat">
            <span class="export-progress-stat__value" data-progress-kept>0</span>
            <span class="export-progress-stat__label">Kept</span>
          </div>
          <div class="export-progress-stat">
            <span class="export-progress-stat__value" data-progress-rejected>0</span>
            <span class="export-progress-stat__label">Rejected</span>
          </div>
          <div class="export-progress-stat">
            <span class="export-progress-stat__value" data-progress-exported>0</span>
            <span class="export-progress-stat__label">Exported</span>
          </div>
          <div class="export-progress-stat">
            <span class="export-progress-stat__value" data-progress-pending>0</span>
            <span class="export-progress-stat__label">Pending</span>
          </div>
        </div>
        <div class="section-card__header" style="margin-top: 20px;">
          <div>
            <h2>{copy.exports.recentSessionsHeading}</h2>
            <p class="section-note">{copy.exports.recentSessionsSubtitle}</p>
          </div>
        </div>
        <div class="artifact-grid" data-recent-sessions></div>
      </article>
    </div>
  </section>

  <section class={`panel shell ${initialTabIndex === 3 ? "is-active" : ""}`} id="panel-3" data-tab-panel>
    <div class="grid library-grid">
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>{copy.diagnostics.heading}</h2>
            <p class="section-note">{copy.diagnostics.subtitle}</p>
          </div>
        </div>
        <div class="artifact-grid">
          {Object.entries(manifest.artifacts).filter(([, value]) => Boolean(value)).map(([key, value]) => (
            <a href={mediaUrl(value)} target="_blank">
              <strong>{key}</strong>
              <span>{value}</span>
            </a>
          ))}
        </div>
      </article>
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>{copy.diagnostics.previewHeading}</h2>
            <p class="section-note">{copy.diagnostics.previewSubtitle}</p>
          </div>
        </div>
        <div class="artifact-grid">
          {Object.entries(artifactsPreview).filter(([, value]) => value && value !== "Artifact unavailable in current workspace.").map(([key, value]) => (
            <article>
              <strong>{key}</strong>
              <pre>{value}</pre>
            </article>
          ))}
        </div>
      </article>
    </div>
  </section>

  <script is:inline type="application/json" id="workspace-data" set:html={clientBundle}></script>
  <script is:inline>
    // @ts-nocheck
    const parsed = JSON.parse(document.getElementById("workspace-data")?.textContent ?? "{}");
    const uiCopy = parsed.copy ?? {};
    let detections = parsed.detections ?? [];
    const rangeStartValue = Number(parsed.rangeStart ?? 0);
    const rangeSpanValue = Math.max(Number(parsed.rangeSpan ?? 1), 1);
    let current = detections[0] ?? null;
    let decisions = [];
    let reviewFilter = "all";
    let loopEnabled = true;
    let autoPlayEnabled = true;
    let autoAdvanceEnabled = true;
    let sourceLoopHandler = null;
    let exportJobId = null;
    let exportedPaths = [];

    const tabButtons = Array.from(document.querySelectorAll("[data-tab-trigger]"));
    const panels = Array.from(document.querySelectorAll("[data-tab-panel]"));
    const currentLabel = document.querySelector("[data-review-current]");
    const timeLabel = document.querySelector("[data-review-time]");
    const reviewLabel = document.querySelector("[data-review-label]");
    const reviewVideo = document.querySelector("[data-review-video]");
    const reviewPlaceholder = document.querySelector("[data-review-placeholder]");
    const tableBody = document.querySelector("[data-detection-table]");
    let rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
    const audioLabel = document.querySelector("[data-detail-audio]");
    const windowLabel = document.querySelector("[data-detail-window]");
    const decisionDetailLabel = document.querySelector("[data-detail-decision]");
    const reviewProgress = document.querySelector("[data-review-progress]");
    const reviewListTitle = document.querySelector("[data-review-list-title]");
    const reviewListNote = document.querySelector("[data-review-list-note]");
    const reviewCounts = document.querySelector("[data-review-counts]");
    const reviewPosition = document.querySelector("[data-review-position]");
    const loopButton = document.querySelector("[data-toggle-loop]");
    const autoplayButton = document.querySelector("[data-toggle-autoplay]");
    const autoAdvanceButton = document.querySelector("[data-toggle-autoadvance]");
    const reviewFilterSelect = document.querySelector("[data-review-filter]");
    const decisionStatus = document.querySelector("[data-decision-status]");
    const decisionNotes = document.querySelector("[data-decision-notes]");
    const timelineViewport = document.querySelector("[data-timeline-viewport]");
    const timelineTrack = document.querySelector("[data-timeline-track]");
    const decisionList = document.querySelector("[data-decision-list]");
    const exportButton = document.querySelector("[data-export-kept]");
    const exportStatus = document.querySelector("[data-export-status]");
    const exportList = document.querySelector("[data-export-list]");
    const exportPendingList = document.querySelector("[data-export-pending-list]");
    const exportTotalCount = document.querySelector("[data-export-total-count]");
    const currentExportCount = document.querySelector("[data-current-export-count]");
    const progressKept = document.querySelector("[data-progress-kept]");
    const progressRejected = document.querySelector("[data-progress-rejected]");
    const progressExported = document.querySelector("[data-progress-exported]");
    const progressPending = document.querySelector("[data-progress-pending]");
    const recentSessionsList = document.querySelector("[data-recent-sessions]");
    const sessionTotal = document.querySelector("[data-session-total]");
    const sessionList = document.querySelector(".session-list");
    const sessionDeleteButtons = Array.from(document.querySelectorAll("[data-session-delete]"));
    const sessionRenameButtons = Array.from(document.querySelectorAll("[data-session-rename]"));
    const sessionOpenNodes = Array.from(document.querySelectorAll("[data-session-open]"));
    let timelineLayoutFrame = null;
    let playbackUiFrame = null;

    function setTab(index) {
      tabButtons.forEach((button, buttonIndex) => button.classList.toggle("is-active", buttonIndex === index));
      panels.forEach((panel, panelIndex) => panel.classList.toggle("is-active", panelIndex === index));
      const url = new URL(window.location.href);
      url.searchParams.set("tab", String(index));
      history.replaceState(null, "", url);
    }

    function formatSeconds(value) {
      const minutes = Math.floor(value / 60);
      const seconds = value - minutes * 60;
      if (minutes > 0) return `${minutes}m ${seconds.toFixed(1).padStart(4, "0")}s`;
      return `${seconds.toFixed(1)}s`;
    }

    function reviewStartFor(item) {
      return Number(item?.review_start_seconds ?? item?.start_time_seconds ?? 0);
    }

    function reviewEndFor(item) {
      const fallbackStart = reviewStartFor(item);
      return Number(item?.review_end_seconds ?? item?.end_time_seconds ?? fallbackStart + 0.5);
    }

    function signalLabelFor(item) {
      if (!item) return "Check";
      if (item.confidence === "high") return "Strong";
      if (item.confidence === "medium") return "Check";
      return "Low";
    }

    function decisionFor(detectionId) {
      return decisions.find((entry) => entry.detectionId === detectionId) ?? null;
    }

    function decisionLabelFor(detectionId) {
      return decisionFor(detectionId)?.label ?? "pending";
    }

    function updateReviewCounts() {
      const keepCount = decisions.filter((entry) => entry.label === "keep").length;
      const rejectCount = decisions.filter((entry) => entry.label === "reject").length;
      const unsureCount = decisions.filter((entry) => entry.label === "unsure").length;
      const pendingCount = Math.max(0, detections.length - decisions.length);
      if (reviewCounts) {
        reviewCounts.textContent = `${pendingCount} pending • ${keepCount} kept • ${rejectCount} rejected • ${unsureCount} unsure`;
      }
      const currentIndex = current ? detections.findIndex((item) => item.id === current.id) + 1 : 0;
      if (reviewPosition) {
        reviewPosition.textContent = `Attempt ${currentIndex} of ${detections.length}`;
      }
      if (exportButton) {
        exportButton.disabled = keepCount === 0;
      }
      if (progressKept) progressKept.textContent = String(keepCount);
      if (progressRejected) progressRejected.textContent = String(rejectCount);
      if (progressExported) progressExported.textContent = String(exportedPaths.length);
      if (progressPending) progressPending.textContent = String(pendingCount);
      renderExportPendingList();
    }

    function updateToggleButtons() {
      if (loopButton) loopButton.textContent = loopEnabled ? "Loop on" : "Loop off";
      if (autoplayButton) autoplayButton.textContent = autoPlayEnabled ? "Autoplay on" : "Autoplay off";
      if (autoAdvanceButton) autoAdvanceButton.textContent = autoAdvanceEnabled ? "Auto-next on" : "Auto-next off";
    }

    function browserFriendlySource(url) {
      return /\.(mp4|webm|m4v)(\?|$)/i.test(url || "");
    }

    function bindDetectionNodes() {
      document.querySelectorAll("[data-focus-detection]").forEach((node) => {
        if (node.dataset.focusBound === "true") return;
        node.dataset.focusBound = "true";
        node.addEventListener("click", () => selectDetection(node.getAttribute("data-focus-detection")));
      });
      rows = Array.from(document.querySelectorAll("[data-detection-table] tr"));
    }

    function scheduleTimelineLayout() {
      if (!timelineTrack) return;
      if (timelineLayoutFrame != null) {
        window.cancelAnimationFrame(timelineLayoutFrame);
      }
      timelineLayoutFrame = window.requestAnimationFrame(() => {
        timelineLayoutFrame = null;
        layoutTimelineMarkers();
      });
    }

    function layoutTimelineMarkers() {
      if (!timelineTrack || !timelineViewport) return;
      const pips = Array.from(timelineTrack.querySelectorAll("[data-timeline-marker]"));
      pips.forEach((pip) => {
        const id = pip.getAttribute("data-timeline-marker") ?? "";
        const decision = decisionLabelFor(id);
        pip.classList.toggle("is-kept", decision === "keep");
        pip.classList.toggle("is-rejected", decision === "reject");
        pip.classList.toggle("is-unsure", decision === "unsure");
        pip.classList.toggle("is-current", id === current?.id);
      });
    }

    const timelinePlayhead = document.querySelector("[data-timeline-playhead]");
    const timelineTooltip = document.querySelector("[data-timeline-tooltip]");

    function updateTimelinePlayhead() {
      if (!timelinePlayhead || !reviewVideo) return;
      const pos = ((reviewVideo.currentTime - rangeStartValue) / rangeSpanValue) * 100;
      const clamped = Math.min(100, Math.max(0, pos));
      timelinePlayhead.style.left = clamped + "%";
    }

    function cancelPlaybackUiLoop() {
      if (playbackUiFrame == null) return;
      window.cancelAnimationFrame(playbackUiFrame);
      playbackUiFrame = null;
    }

    function syncPlaybackUi() {
      updateTimelinePlayhead();
    }

    function tickPlaybackUi() {
      playbackUiFrame = null;
      syncPlaybackUi();
      if (!reviewVideo || reviewVideo.paused || reviewVideo.ended) return;
      playbackUiFrame = window.requestAnimationFrame(tickPlaybackUi);
    }

    function startPlaybackUiLoop() {
      cancelPlaybackUiLoop();
      if (!reviewVideo || reviewVideo.paused || reviewVideo.ended) {
        syncPlaybackUi();
        return;
      }
      playbackUiFrame = window.requestAnimationFrame(tickPlaybackUi);
    }

    if (timelineTrack) {
      timelineTrack.addEventListener("mouseover", (event) => {
        const pip = event.target.closest("[data-timeline-marker]");
        if (!pip || !timelineTooltip) return;
        const idx = pip.getAttribute("data-pip-index") ?? "";
        const time = pip.getAttribute("data-pip-time") ?? "";
        const id = pip.getAttribute("data-timeline-marker") ?? "";
        const decision = decisionLabelFor(id);
        const tag = decision !== "pending" ? decision : "";
        timelineTooltip.textContent = "#" + idx + "  " + time + (tag ? "  " + tag : "");
        timelineTooltip.hidden = false;
        const left = pip.style.left;
        timelineTooltip.style.left = left;
      });
      timelineTrack.addEventListener("mouseout", (event) => {
        const pip = event.target.closest("[data-timeline-marker]");
        if (pip && timelineTooltip) timelineTooltip.hidden = true;
      });
    }

    if (reviewVideo) {
      reviewVideo.addEventListener("timeupdate", syncPlaybackUi);
      reviewVideo.addEventListener("play", startPlaybackUiLoop);
      reviewVideo.addEventListener("pause", () => {
        cancelPlaybackUiLoop();
        syncPlaybackUi();
      });
      reviewVideo.addEventListener("ended", () => {
        cancelPlaybackUiLoop();
        syncPlaybackUi();
      });
      reviewVideo.addEventListener("seeking", syncPlaybackUi);
      reviewVideo.addEventListener("seeked", syncPlaybackUi);
      reviewVideo.addEventListener("loadedmetadata", syncPlaybackUi);
    }

    function renderDetectionTable() {
      if (!tableBody) return;
      tableBody.innerHTML = detections.map((item) => `
        <tr class="${item.id === current?.id ? "is-current" : ""}" data-focus-detection="${item.id}">
          <td>${item.id}</td>
          <td>${formatSeconds(item.timestamp_seconds)}</td>
          <td>${decisionLabelFor(item.id)}</td>
          <td>${signalLabelFor(item)}</td>
        </tr>
      `).join("");
      bindDetectionNodes();
      applyQueueFilter();
      scheduleTimelineLayout();
    }

    function updateReviewModeCopy() {
      if (reviewListTitle) reviewListTitle.textContent = "Attempts";
      if (reviewListNote) {
        reviewListNote.textContent = uiCopy.messages?.reviewListHint ?? "Choose an attempt, review it, then save your decision.";
      }
    }

    function playCurrentSegment() {
      if (!reviewVideo || !current) return;
      const start = reviewStartFor(current);
      const end = reviewEndFor(current);
      if (reviewVideo.currentTime < start || reviewVideo.currentTime >= end) {
        reviewVideo.currentTime = start;
      }
      return reviewVideo.play().catch(() => {});
    }

    function nextDetection(direction = 1, preferPending = false) {
      if (!current || detections.length === 0) return null;
      const startIndex = Math.max(0, detections.findIndex((item) => item.id === current.id));
      for (let step = 1; step <= detections.length; step += 1) {
        const candidate = detections[(startIndex + step * direction + detections.length) % detections.length];
        if (!preferPending || decisionLabelFor(candidate.id) === "pending") {
          return candidate;
        }
      }
      return null;
    }

    function selectAdjacentDetection(direction) {
      const candidate = nextDetection(direction, false);
      if (candidate) {
        selectDetection(candidate.id, { autoplay: autoPlayEnabled });
      }
    }

    function pendingDetections() {
      return detections.filter((item) => decisionLabelFor(item.id) === "pending");
    }

    function nextPendingDetectionFrom(fromId) {
      if (detections.length === 0) return null;
      const pending = pendingDetections();
      if (!pending.length) return null;
      const startIndex = Math.max(0, detections.findIndex((item) => item.id === fromId));
      for (let step = 1; step <= detections.length; step += 1) {
        const candidate = detections[(startIndex + step) % detections.length];
        if (decisionLabelFor(candidate.id) === "pending") {
          return candidate;
        }
      }
      return pending[0] ?? null;
    }

    function moveReviewForwardAfterDecision(savedDetectionId, label) {
      const pending = pendingDetections();
      if (!pending.length) {
        decisionStatus && (decisionStatus.textContent = `Saved ${label} for ${savedDetectionId}. Review complete — opening Exports.`);
        setTab(2);
        return;
      }
      const nextPending = nextPendingDetectionFrom(savedDetectionId);
      if (!nextPending) return;
      if (reviewFilterSelect && !["all", "pending"].includes(reviewFilter)) {
        reviewFilter = "pending";
        reviewFilterSelect.value = "pending";
        applyQueueFilter();
      }
      selectDetection(nextPending.id, { autoplay: autoPlayEnabled });
    }

    function applyQueueFilter() {
      rows.forEach((row) => {
        const id = row.getAttribute("data-focus-detection") ?? "";
        const detection = detections.find((item) => item.id === id);
        const decision = decisionLabelFor(id);
        const haystack = `${id} ${decision} ${detection?.confidence ?? ""}`.toLowerCase();
        const matchesFilter = reviewFilter === "all" || (reviewFilter === "pending" ? decision === "pending" : decision === reviewFilter);
        row.hidden = !matchesFilter;
      });
    }

    function syncVideoSource() {
      if (!reviewVideo || !current) return;
      const proxySrc = parsed.primaryVideoUrl ?? "";
      const directSrc = parsed.sourceVideoUrl ?? "";
      if (sourceLoopHandler) {
        reviewVideo.removeEventListener("timeupdate", sourceLoopHandler);
        sourceLoopHandler = null;
      }
      const start = reviewStartFor(current);
      const end = reviewEndFor(current);
      reviewVideo.controls = true;
      let sourceSrc = proxySrc;
      let waitingForProxy = false;
      if (parsed.session?.status === "ready_proxy_pending") {
        if (browserFriendlySource(directSrc)) {
          sourceSrc = directSrc;
        } else {
          waitingForProxy = true;
          sourceSrc = "";
        }
      }

      if (waitingForProxy) {
        cancelPlaybackUiLoop();
        reviewVideo.pause();
        reviewVideo.removeAttribute("src");
        reviewVideo.load();
        if (reviewPlaceholder) {
          reviewPlaceholder.hidden = false;
          reviewPlaceholder.textContent = "The review video for this file is still being prepared. Playback will appear automatically.";
        }
        return;
      }

      reviewPlaceholder && (reviewPlaceholder.hidden = true);
      if (reviewVideo.dataset.sourceSrc !== sourceSrc || !reviewVideo.getAttribute("src")) {
        reviewVideo.src = sourceSrc;
        reviewVideo.dataset.sourceSrc = sourceSrc;
        reviewVideo.addEventListener("loadedmetadata", () => {
          reviewVideo.currentTime = start;
          syncPlaybackUi();
          if (autoPlayEnabled) void playCurrentSegment();
        }, { once: true });
      } else {
        reviewVideo.currentTime = start;
      }
      sourceLoopHandler = () => {
        if (reviewVideo.currentTime >= end) {
          if (loopEnabled) {
            reviewVideo.currentTime = start;
          } else if (autoAdvanceEnabled) {
            reviewVideo.pause();
            const next = nextDetection(1, true) ?? nextDetection(1, false);
            if (next && next.id !== current?.id) {
              selectDetection(next.id, { autoplay: autoPlayEnabled });
              return;
            }
            reviewVideo.currentTime = start;
          } else {
            reviewVideo.pause();
            reviewVideo.currentTime = start;
          }
        }
        syncPlaybackUi();
      };
      reviewVideo.addEventListener("timeupdate", sourceLoopHandler);
      updateReviewModeCopy();
      startPlaybackUiLoop();
    }

    function selectDetection(id, options = {}) {
      current = detections.find((item) => item.id === id) ?? current;
      if (!current) return;
      currentLabel && (currentLabel.textContent = `Attempt ${current.index}`);
      timeLabel && (timeLabel.textContent = formatSeconds(current.timestamp_seconds));
      reviewLabel && (reviewLabel.textContent = `${formatSeconds(reviewStartFor(current))} to ${formatSeconds(reviewEndFor(current))} · ${parsed.session?.source_video_path ?? ""}`);
      audioLabel && (audioLabel.textContent = `Audio ${current.scores.audio.toFixed(2)}`);
      windowLabel && (windowLabel.textContent = `Window ${formatSeconds(reviewStartFor(current))} to ${formatSeconds(reviewEndFor(current))}`);
      decisionDetailLabel && (decisionDetailLabel.textContent = `Decision ${decisionFor(current.id)?.label ?? "pending"}`);
      document.querySelectorAll("[data-focus-detection]").forEach((node) => {
        node.classList.toggle("is-current", node.getAttribute("data-focus-detection") === id);
      });
      rows.forEach((row) => row.classList.toggle("is-current", row.getAttribute("data-focus-detection") === id));
      scheduleTimelineLayout();
      syncVideoSource();
      updateMediaSessionMetadata();
      updateReviewCounts();
      const currentDecision = decisionFor(current.id);
      if (currentDecision) {
        decisionStatus && (decisionStatus.textContent = `Saved ${currentDecision.label} for ${currentDecision.detectionId}.`);
        decisionDetailLabel && (decisionDetailLabel.textContent = `Decision ${currentDecision.label}`);
        if (decisionNotes) decisionNotes.value = currentDecision.notes ?? "";
      } else {
        decisionStatus && (decisionStatus.textContent = uiCopy.messages?.noDecisionSaved ?? "No decision saved for this attempt.");
        decisionDetailLabel && (decisionDetailLabel.textContent = uiCopy.messages?.noDecisionDetail ?? "No decision yet");
        if (decisionNotes) decisionNotes.value = "";
      }
      if (options.autoplay && autoPlayEnabled) {
        window.setTimeout(() => { void playCurrentSegment(); }, 40);
      }
    }

    tabButtons.forEach((button, index) => button.addEventListener("click", () => setTab(index)));
    document.querySelectorAll("[data-open-tab]").forEach((button) => {
      button.addEventListener("click", () => setTab(Number(button.getAttribute("data-open-tab"))));
    });
    bindDetectionNodes();
    scheduleTimelineLayout();
    window.addEventListener("resize", scheduleTimelineLayout);

    reviewFilterSelect?.addEventListener("change", (event) => {
      reviewFilter = String(event.target?.value ?? "all");
      applyQueueFilter();
    });

    const form = document.querySelector("[data-analysis-form]");
    const input = document.querySelector("[data-analysis-path]");
    const status = document.querySelector("[data-analysis-status]");
    const profile = document.querySelector("[data-analysis-profile]");
    const detector = document.querySelector("[data-analysis-detector]");
    const sessionNameInput = document.querySelector("[data-analysis-session-name]");
    const pickedFileInput = document.querySelector("[data-analysis-file]");
    const pickButton = document.querySelector("[data-analysis-pick]");
    const pickedFileLabel = document.querySelector("[data-analysis-file-label]");
    let pickedVideoFile = null;
    const defaultSessionName = String(sessionNameInput?.getAttribute("data-default-session-name") ?? "").trim();
    let sessionNameAutoFilled = !sessionNameInput || String(sessionNameInput.value ?? "").trim() === defaultSessionName;

    function deriveSessionNameFromPath(filePath) {
      const raw = String(filePath ?? "").trim();
      if (!raw) return "";
      const leaf = raw.split(/[\\\\/]/).pop() ?? raw;
      return leaf.replace(/\.[^.]+$/, "");
    }

    function canAutoFillSessionName() {
      if (!sessionNameInput) return false;
      const currentValue = String(sessionNameInput.value ?? "").trim();
      return !currentValue || currentValue === defaultSessionName || sessionNameAutoFilled;
    }

    function reconcileSessionList(sessions) {
      if (!sessionList || !Array.isArray(sessions)) return;
      const liveIds = new Set(sessions.map((item) => item.sessionId));
      sessionList.querySelectorAll("[data-session-row]").forEach((row) => {
        const rowId = row.getAttribute("data-session-row");
        if (rowId && !liveIds.has(rowId)) {
          row.remove();
        }
      });
      if (sessionTotal) {
        sessionTotal.textContent = `${sessions.length} total`;
      }
    }

    function renderDecisions(decisions) {
      if (!decisionList) return;
      if (!decisions.length) {
        decisionList.innerHTML = `<article><strong>${uiCopy.messages?.noDecisionsYet ?? "No decisions yet"}</strong><p>Use Review to mark attempts as Keep, Reject, or Unsure.</p></article>`;
        return;
      }
      decisionList.innerHTML = decisions.slice(0, 8).map((entry) => `
        <article>
          <strong>${entry.detectionId} · ${entry.label}</strong>
          <div class="session-listing__meta">
            <span>${entry.updatedAt}</span>
          </div>
          <p>${entry.notes || (uiCopy.messages?.noNoteAdded ?? "No note added.")}</p>
        </article>
      `).join("");
    }

    async function readJsonResponse(response) {
      const contentType = String(response.headers.get("content-type") ?? "").toLowerCase();
      const raw = await response.text();
      if (!raw) return {};
      if (!contentType.includes("application/json")) {
        return {
          error: response.ok ? "Unexpected non-JSON response." : raw.trim() || "Request failed.",
          _invalidJson: true,
        };
      }
      try {
        return JSON.parse(raw);
      } catch {
        return { error: "Invalid JSON response.", _invalidJson: true };
      }
    }

    async function refreshDecisions() {
      if (!parsed.session?.id) return;
      const response = await fetch(`/api/review?analysisRunId=${encodeURIComponent(parsed.session.id)}`);
      const payload = await readJsonResponse(response);
      decisions = payload.decisions ?? [];
      renderDecisions(decisions);
      updateReviewCounts();
      renderDetectionTable();
      if (current) selectDetection(current.id);
    }

    sessionNameInput?.addEventListener("input", () => {
      const currentValue = String(sessionNameInput.value ?? "").trim();
      sessionNameAutoFilled = !currentValue || currentValue === defaultSessionName;
    });

    pickButton?.addEventListener("click", () => {
      pickedFileInput?.click();
    });

    pickedFileInput?.addEventListener("change", () => {
      pickedVideoFile = pickedFileInput?.files?.[0] ?? null;
      if (pickedFileLabel) {
        pickedFileLabel.textContent = pickedVideoFile
          ? `${pickedVideoFile.name} ${uiCopy.messages?.fileSelectedSuffix ?? "selected. It will be copied into the local runtime when you start the analysis."}`
          : (uiCopy.messages?.filePickerIdle ?? "No file selected. You can still paste a path manually.");
      }
      if (input) {
        input.value = pickedVideoFile
          ? pickedVideoFile.name
          : "";
      }
      if (!sessionNameInput || !pickedVideoFile || !canAutoFillSessionName()) return;
      sessionNameInput.value = deriveSessionNameFromPath(pickedVideoFile.name);
      sessionNameAutoFilled = true;
    });

    loopButton?.addEventListener("click", () => {
      loopEnabled = !loopEnabled;
      updateToggleButtons();
    });
    autoplayButton?.addEventListener("click", () => {
      autoPlayEnabled = !autoPlayEnabled;
      updateToggleButtons();
    });
    autoAdvanceButton?.addEventListener("click", () => {
      autoAdvanceEnabled = !autoAdvanceEnabled;
      updateToggleButtons();
    });

    const initialTab = Number(parsed.requestedTab ?? "0");
    if (!Number.isNaN(initialTab) && initialTab >= 0) {
      setTab(initialTab);
    }

    function installMediaSessionHandlers() {
      if (!("mediaSession" in navigator)) return;
      try {
        navigator.mediaSession.setActionHandler("play", () => { void playCurrentSegment(); });
        navigator.mediaSession.setActionHandler("pause", () => { reviewVideo?.pause(); });
        navigator.mediaSession.setActionHandler("previoustrack", () => { selectAdjacentDetection(-1); });
        navigator.mediaSession.setActionHandler("nexttrack", () => { selectAdjacentDetection(1); });
      } catch {}
    }

    function updateMediaSessionMetadata() {
      if (!("mediaSession" in navigator) || !current) return;
      try {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: `Attempt ${current.index}`,
          artist: parsed.session?.session_name ?? parsed.session?.title ?? "DiveSensei",
          album: "DiveSensei Review",
        });
      } catch {}
    }

    async function refreshManifest() {
      if (!parsed.hasSession || !parsed.session?.output_dir) return;
      const manifestPath = `${parsed.session.output_dir}/ui_session_manifest.json`;
      const response = await fetch(`/api/media?path=${encodeURIComponent(manifestPath)}`, { cache: "no-store" });
      if (!response.ok) return;
      const manifest = await readJsonResponse(response);
      if (manifest?._invalidJson || !manifest?.session) return;
      parsed.session = manifest.session;
      parsed.primaryVideoUrl = `/api/media?path=${encodeURIComponent(`${manifest.session.output_dir}/web/session_source_review.mp4`)}`;
      parsed.sourceVideoUrl = `/api/media?path=${encodeURIComponent(manifest.session.source_video_path)}`;
      detections = (manifest.detections ?? []).map((item) => ({
        ...item,
        reviewClipPath: item.clip?.browser_path ?? item.clip?.path,
      }));
      const currentId = current?.id;
      current = detections.find((item) => item.id === currentId) ?? detections[0] ?? null;
      parsed.requestedSession = manifest.session.id;
      renderDetectionTable();
      scheduleTimelineLayout();
      if (current) {
        selectDetection(current.id);
      }
    }

    async function pollJob(jobId) {
      let redirectedToReview = false;
      while (true) {
        const response = await fetch(`/api/analysis?job=${encodeURIComponent(jobId)}`);
        const payload = await readJsonResponse(response);
        if (payload?._invalidJson) {
          status && (status.textContent = payload.error ?? "Could not read the run status.");
          reviewProgress && (reviewProgress.textContent = payload.error ?? "Could not read the run status.");
          return;
        }
        const headline = payload.phaseLabel ?? payload.phase ?? payload.status;
        const detail = payload.progressDetail ? ` - ${payload.progressDetail}` : "";
        status && (status.textContent = `${headline}${detail}`);
        reviewProgress && (reviewProgress.textContent = `${headline}${detail}`);
        if (!redirectedToReview && (payload.phase === "review-ready" || payload.phase === "building-review-proxy" || payload.phase === "finalizing" || payload.status === "completed")) {
          const alreadyOnTargetReview = parsed.requestedSession === payload.sessionId && String(parsed.requestedTab ?? "0") === "1";
          redirectedToReview = true;
          if (!alreadyOnTargetReview) {
            const nextUrl = new URL(window.location.href);
            nextUrl.searchParams.set("session", payload.sessionId);
            nextUrl.searchParams.set("tab", "1");
            nextUrl.searchParams.set("job", payload.id);
            window.location.replace(nextUrl.toString());
            return;
          }
        }
        if (parsed.requestedJob) {
          await refreshManifest();
        }
        if (payload.status === "completed" || payload.status === "failed") {
          if (payload.status === "completed") {
            await refreshManifest();
            reviewProgress && (reviewProgress.textContent = "Review video is ready. Finish your review, then export the clips you want.");
          }
          return;
        }
        await new Promise((resolve) => setTimeout(resolve, 1500));
      }
    }

    if (parsed.hasSession && parsed.requestedJob && parsed.session?.status === "ready_proxy_pending") {
      pollJob(parsed.requestedJob);
    }

    if (parsed.hasSession && !parsed.requestedJob && parsed.session?.status === "ready_proxy_pending") {
      const passivePoll = async () => {
        while (parsed.session?.status === "ready_proxy_pending") {
          await new Promise((resolve) => setTimeout(resolve, 3000));
          await refreshManifest();
          reviewProgress && (reviewProgress.textContent = "The review video is still being prepared. Playback will appear automatically.");
        }
        reviewProgress && (reviewProgress.textContent = "Review video is ready. Finish your review, then export the clips you want.");
      };
      void passivePoll();
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      status && (status.textContent = "Starting run...");
      let videoPath = input?.value ?? "";
      if (pickedVideoFile) {
        status && (status.textContent = `Copying ${pickedVideoFile.name} into the workspace...`);
        const uploadBytes = await pickedVideoFile.arrayBuffer();
        const importResponse = await fetch("/api/import-video", {
          method: "POST",
          headers: {
            "Content-Type": "application/octet-stream",
            "X-File-Name": pickedVideoFile.name,
          },
          body: uploadBytes,
        });
        const importPayload = await readJsonResponse(importResponse);
        if (!importResponse.ok) {
          status && (status.textContent = importPayload.error ?? "Could not import the selected file.");
          return;
        }
        videoPath = importPayload.path ?? "";
        if (!videoPath) {
          status && (status.textContent = "Could not resolve the imported file path.");
          return;
        }
        input && (input.value = videoPath);
      }
      const response = await fetch("/api/analysis", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          videoPath,
          sessionName: sessionNameInput?.value ?? "",
          profile: profile?.value ?? "long-session",
          detectorId: detector?.value ?? "audio_v2_pcen_classifier",
        }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        status && (status.textContent = payload.error ?? "Could not start the run.");
        return;
      }
      await pollJob(payload.id);
    });

    async function openSession(sessionId) {
      await fetch("/api/catalog", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "open", analysisRunId: sessionId }),
      }).catch(() => {});
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set("session", sessionId);
      nextUrl.searchParams.set("tab", "1");
      nextUrl.searchParams.delete("job");
      window.location.assign(nextUrl.toString());
    }

    sessionOpenNodes.forEach((node) => {
      node.addEventListener("click", (event) => {
        event.preventDefault();
        const sessionId = node.getAttribute("data-session-open");
        if (sessionId) {
          void openSession(sessionId);
        }
      });
    });

    sessionDeleteButtons.forEach((button) => {
      button.addEventListener("click", async (event) => {
        event.preventDefault();
        event.stopPropagation();
        const sessionId = button.getAttribute("data-session-delete");
        if (!sessionId) return;
        const confirmed = window.confirm("Delete this run and remove its generated files? The original video will not be deleted.");
        if (!confirmed) return;
        const row = button.closest(".session-listing");
        const rowButtons = Array.from(row?.querySelectorAll("button") ?? []);
        rowButtons.forEach((node) => { node.disabled = true; });
        const originalLabel = button.textContent;
        button.textContent = "Deleting...";
        status && (status.textContent = "Deleting run...");
        const response = await fetch("/api/catalog", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "delete", analysisRunId: sessionId }),
        });
        const payload = await readJsonResponse(response);
        if (!response.ok) {
          rowButtons.forEach((node) => { node.disabled = false; });
          button.textContent = originalLabel;
          status && (status.textContent = payload.error ?? "Could not delete the run.");
          return;
        }
        const deletingCurrentSession = parsed.session?.id === sessionId || parsed.requestedSession === sessionId;
        reconcileSessionList(payload.sessions);
        if (row?.isConnected) {
          row.remove();
        }
        status && (status.textContent = payload.deleted === false ? "Run was already removed." : "Run deleted.");
        if (!deletingCurrentSession) {
          return;
        }
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.delete("session");
        nextUrl.searchParams.set("tab", "0");
        nextUrl.searchParams.delete("job");
        nextUrl.searchParams.set("refresh", String(Date.now()));
        window.location.replace(nextUrl.toString());
      });
    });

    sessionRenameButtons.forEach((button) => {
      button.addEventListener("click", async (event) => {
        event.preventDefault();
        event.stopPropagation();
        const sessionId = button.getAttribute("data-session-rename");
        const currentName = button.getAttribute("data-session-current-name") ?? "";
        if (!sessionId) return;
        const nextName = window.prompt("Session name", currentName);
        if (nextName == null) return;
        const trimmed = nextName.trim();
        if (!trimmed || trimmed === currentName.trim()) return;
        const response = await fetch("/api/catalog", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "rename", analysisRunId: sessionId, sessionName: trimmed }),
        });
        const payload = await readJsonResponse(response);
        if (!response.ok) {
          status && (status.textContent = payload.error ?? "Could not rename the run.");
          return;
        }
        const nextUrl = new URL(window.location.href);
        if (parsed.session?.id === sessionId) {
          window.location.assign(nextUrl.toString());
          return;
        }
        nextUrl.searchParams.delete("session");
        nextUrl.searchParams.set("tab", "0");
        nextUrl.searchParams.delete("job");
        window.location.assign(nextUrl.toString());
      });
    });

    async function saveDecision(label) {
      if (!parsed.session?.id || !current) return;
      const savedDetectionId = current.id;
      const response = await fetch("/api/review", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          analysisRunId: parsed.session.id,
          detectionId: savedDetectionId,
          label,
          notes: decisionNotes?.value ?? "",
        }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        decisionStatus && (decisionStatus.textContent = payload.error ?? "Could not save your decision.");
        return;
      }
      decisionStatus && (decisionStatus.textContent = `Saved ${payload.decision.label} for ${payload.decision.detectionId}.`);
      await refreshDecisions();
      moveReviewForwardAfterDecision(savedDetectionId, payload.decision.label);
    }

    document.querySelectorAll("[data-decision]").forEach((button) => {
      button.addEventListener("click", async () => {
        await saveDecision(button.getAttribute("data-decision"));
      });
    });

    function renderExportPendingList() {
      if (!exportPendingList) return;
      const keptItems = detections.filter((item) => decisionLabelFor(item.id) === "keep");
      const exportedFileNames = new Set(exportedPaths.map((p) => {
        const name = p.split("/").pop() ?? "";
        return name.replace(/\.[^.]+$/, "");
      }));
      const pending = keptItems.filter((item) => {
        return !exportedFileNames.has(item.id);
      });
      if (!pending.length) {
        exportPendingList.innerHTML = `<article><span>${uiCopy.messages?.noPendingExports ?? "No clips are waiting for export. Mark clips as Keep in Review first."}</span></article>`;
        return;
      }
      exportPendingList.innerHTML = pending.map((item) => `
        <article class="export-card">
          <strong>Attempt ${item.index}</strong>
          <span class="export-card__time">${formatSeconds(item.timestamp_seconds)} · ${item.confidence} confidence</span>
        </article>
      `).join("");
    }

    function renderExportList(paths) {
      exportedPaths = paths ?? [];
      updateReviewCounts();
      if (!exportList) return;
      if (!exportedPaths.length) {
        exportList.innerHTML = `<article><span>${uiCopy.messages?.noExportedClips ?? "No exported clips yet."}</span></article>`;
        return;
      }
      exportList.innerHTML = exportedPaths.map((item) => `
        <a href="/api/media?path=${encodeURIComponent(item)}" target="_blank" class="export-card">
          <div class="export-card__thumb">
            <video src="/api/media?path=${encodeURIComponent(item)}" preload="metadata" muted></video>
          </div>
          <div>
            <strong>${item.split("/").pop()}</strong>
            <span class="export-card__path-wrap"><span class="export-card__path">${item}</span></span>
          </div>
        </a>
      `).join("");
      exportList.querySelectorAll(".export-card__path-wrap").forEach((wrap) => {
        wrap.style.setProperty("--wrap-width", wrap.offsetWidth + "px");
      });
    }

    function renderRecentSessions() {
      if (!recentSessionsList) return;
      const recent = parsed.recentSessions ?? [];
      if (!recent.length) {
        recentSessionsList.innerHTML = `<article><span>${uiCopy.messages?.noRecentSessions ?? "No recent sessions."}</span></article>`;
        return;
      }
      recentSessionsList.innerHTML = recent.map((item) => `
        <article style="cursor: pointer;" data-focus-recent-session="${item.id}">
          <strong>${item.session_name ?? item.title}</strong>
          <span>${item.candidate_count} attempts · ${item.extracted_count} exports</span>
        </article>
      `).join("");
      recentSessionsList.querySelectorAll("[data-focus-recent-session]").forEach((node) => {
        node.addEventListener("click", () => {
          const sessionId = node.getAttribute("data-focus-recent-session");
          if (sessionId) window.location.href = "/?session=" + encodeURIComponent(sessionId);
        });
      });
    }

    async function refreshExportState() {
      if (!parsed.session?.id) return;
      const response = await fetch(`/api/export?analysisRunId=${encodeURIComponent(parsed.session.id)}`, { cache: "no-store" });
      const payload = await readJsonResponse(response);
      if (!response.ok || payload?._invalidJson) {
        exportStatus && (exportStatus.textContent = payload.error ?? "Could not refresh exported clips.");
        return;
      }
      const exportedCount = Number(payload.exportedCount ?? payload.exportedPaths?.length ?? 0);
      parsed.session.extracted_count = exportedCount;
      exportedPaths = payload.exportedPaths ?? [];
      const sessionExportNode = sessionList?.querySelector(`[data-session-export-count="${parsed.session.id}"]`);
      if (currentExportCount) currentExportCount.textContent = String(exportedCount);
      if (exportTotalCount) exportTotalCount.textContent = `${exportedCount} exports`;
      if (sessionExportNode) sessionExportNode.textContent = `${exportedCount} exports`;
      if (Array.isArray(parsed.recentSessions)) {
        parsed.recentSessions = parsed.recentSessions.map((item) =>
          item.id === parsed.session.id ? { ...item, extracted_count: exportedCount } : item
        );
        renderRecentSessions();
      }
      renderExportList(exportedPaths);
    }

    async function pollExportJob(jobId) {
      exportJobId = jobId;
      while (true) {
        const response = await fetch(`/api/export?job=${encodeURIComponent(jobId)}`);
        const payload = await readJsonResponse(response);
        if (payload?._invalidJson) {
          exportStatus && (exportStatus.textContent = payload.error ?? "Could not read the export status.");
          return;
        }
        const detail = payload.progressDetail ? ` - ${payload.progressDetail}` : "";
        exportStatus && (exportStatus.textContent = `Export job ${payload.id}: ${payload.phaseLabel}${detail}`);
        if (payload.status === "completed") {
          await refreshExportState();
          return;
        }
        if (payload.status === "failed") {
          exportStatus && (exportStatus.textContent = payload.error ?? "The export failed.");
          return;
        }
        await new Promise((resolve) => setTimeout(resolve, 1200));
      }
    }

    exportButton?.addEventListener("click", async () => {
      if (!parsed.session?.id) return;
      exportStatus && (exportStatus.textContent = "Starting export job...");
      const response = await fetch("/api/export", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ analysisRunId: parsed.session.id }),
      });
      const payload = await readJsonResponse(response);
      if (!response.ok) {
        exportStatus && (exportStatus.textContent = payload.error ?? "Could not start the export.");
        return;
      }
      setTab(2);
      await pollExportJob(payload.id);
    });

    document.addEventListener("keydown", (event) => {
      const tagName = event.target?.tagName?.toLowerCase();
      if (tagName === "input" || tagName === "textarea" || tagName === "select") return;
      if (event.key === " ") {
        event.preventDefault();
        if (reviewVideo?.paused) {
          void playCurrentSegment();
        } else {
          reviewVideo?.pause();
        }
      } else if (event.key === "ArrowRight") {
        selectAdjacentDetection(1);
      } else if (event.key === "ArrowLeft") {
        selectAdjacentDetection(-1);
      } else if (event.key.toLowerCase() === "k") {
        void saveDecision("keep");
      } else if (event.key.toLowerCase() === "r") {
        void saveDecision("reject");
      } else if (event.key.toLowerCase() === "u") {
        void saveDecision("unsure");
      }
    });

    updateReviewModeCopy();
    updateToggleButtons();
    renderExportList(parsed.initialExportedPaths ?? []);
    renderRecentSessions();
    if (parsed.session?.id) {
      void refreshExportState();
    }
    installMediaSessionHandlers();
    syncVideoSource();
    renderDetectionTable();
    if (current) selectDetection(current.id, { autoplay: autoPlayEnabled });
    refreshDecisions();
  </script>
</main>
