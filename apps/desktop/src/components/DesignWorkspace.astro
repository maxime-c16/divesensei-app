---
import fs from "node:fs";
import path from "node:path";
import brandLockupDark from "@/assets/divesensei-lockup-dark.svg";
import {
  formatSeconds,
  getUiData,
  mediaUrl,
  resolveClipMediaPath,
  resolveSourceMediaPath,
  sessionIsReviewReady,
  sessionStatusLabel,
} from "@/lib/ui-data";
import { listExportedPathsForAnalysisRun } from "@/lib/export-jobs";
import { listEvaluationFalseNegatives, listEvaluationReviewDecisions } from "@/lib/evaluation-review-store";

interface ThemeConfig {
  id: string;
  name: string;
  route: string;
  tagline: string;
  subtitle: string;
  tabs: [string, string, string, string];
}

const { theme } = Astro.props as { theme: ThemeConfig };
const requestedSession = Astro.url.searchParams.get("session") ?? undefined;
const requestedTab = Astro.url.searchParams.get("tab");
const requestedJob = Astro.url.searchParams.get("job");
const requestedFocus = Astro.url.searchParams.get("focus");
const requestedCleanupQueue = Astro.url.searchParams.get("cleanupQueue") ?? undefined;
const requestedShadowV2Telemetry = Astro.url.searchParams.get("shadowV2Telemetry") ?? undefined;
const requestedAssignmentDraftRun = Astro.url.searchParams.get("assignmentDraftRun") ?? undefined;
const activeTabIndex = Number.parseInt(requestedTab ?? "0", 10);
const initialTabIndex = Number.isNaN(activeTabIndex) ? 0 : Math.max(0, Math.min(theme.tabs.length - 1, activeTabIndex));
const uiData = getUiData(requestedSession, requestedCleanupQueue);
const {
  library,
  manifest,
  selectedSessionId,
  eventReviewSupport,
  eventReviewQueueRows: loadedReviewQueueRows,
  eventReviewQueueTitle,
  eventReviewQueueNote,
  eventReviewQueueSummary,
  cleanupQueueMode,
  approveReviewPolicy,
  approveReviewSummary,
  approveReviewShadowPolicies,
  approveReviewShadowSummaries,
} = uiData;
const eventReviewSupportRows = Array.isArray(eventReviewSupport) ? eventReviewSupport : [];
const eventReviewQueueRows = Array.isArray(loadedReviewQueueRows) ? loadedReviewQueueRows : [];
const isCleanupQueueMode = cleanupQueueMode === "r162";
const cleanupQueueSummaryStats = isCleanupQueueMode && eventReviewQueueSummary && typeof eventReviewQueueSummary === "object"
  ? {
      total: Number((eventReviewQueueSummary as Record<string, unknown>).total ?? eventReviewQueueRows.length),
      completed: Number((eventReviewQueueSummary as Record<string, unknown>).completed ?? 0),
      remaining: Number((eventReviewQueueSummary as Record<string, unknown>).remaining ?? eventReviewQueueRows.length),
    }
  : null;
const cleanupQueuePriorityStats = isCleanupQueueMode && eventReviewQueueSummary && typeof eventReviewQueueSummary === "object"
  ? Object.entries(((eventReviewQueueSummary as Record<string, unknown>).perPriority ?? {}) as Record<string, { total?: number; remaining?: number }>).map(([bucket, data]) => ({
      bucket,
      remaining: Number(data?.remaining ?? data?.total ?? 0),
    }))
  : [];
const cleanupQueueSessionProgress = isCleanupQueueMode && eventReviewQueueSummary && typeof eventReviewQueueSummary === "object"
  ? Object.entries(((eventReviewQueueSummary as Record<string, unknown>).perSession ?? {}) as Record<string, { total?: number; completed?: number }>).map(([sessionId, data]) => ({
      sessionId,
      completed: Number(data?.completed ?? 0),
      total: Number(data?.total ?? 0),
    }))
  : [];

function timingGroupForDetection(detectionId: string): string {
  const support = eventReviewSupportRows.find((row: Record<string, unknown>) => String(row.legacy_candidate_id ?? "") === String(detectionId));
  if (!support) return "";
  const ts = (support.timing_semantics_shadow ?? {}) as Record<string, unknown>;
  if (!ts || typeof ts !== "object") return "";
  if (ts.immediate_pair_is_confirmed_on_dive) return "confirmed_on_dive_pair";
  if (ts.immediate_pair_is_dive_labeled_event) return "dive_labeled_pair";
  if (ts.chain_reaches_dive_labeled_event) return "rebound_chain_to_dive_labeled";
  if (ts.immediate_pair_candidate_id && ts.immediate_pair_delta_seconds != null && Number(ts.immediate_pair_delta_seconds) <= 3.0) return "rebound_chain_to_dive_labeled";
  if (ts.bucket === "er_isolated_representative") return "isolated_early_rebound_representative";
  if (ts.bucket === "er_ambiguous") return "ambiguous_early_rebound";
  return "";
}

function timingTooltipForDetection(detectionId: string): string {
  const support = eventReviewSupportRows.find((row: Record<string, unknown>) => String(row.legacy_candidate_id ?? "") === String(detectionId));
  if (!support) return "";
  const ts = (support.timing_semantics_shadow ?? {}) as Record<string, unknown>;
  if (!ts || typeof ts !== "object") return "";
  const pairId = String(ts.immediate_pair_candidate_id ?? "");
  const delta = ts.immediate_pair_delta_seconds != null ? Number(ts.immediate_pair_delta_seconds).toFixed(2) : "";
  const termId = String(ts.chain_terminal_candidate_id ?? "");
  const termDelta = ts.chain_terminal_delta_seconds != null ? Number(ts.chain_terminal_delta_seconds).toFixed(2) : "";
  const hops = ts.chain_hops_to_dive_labeled_event != null ? Number(ts.chain_hops_to_dive_labeled_event) : "";
  if (ts.immediate_pair_is_confirmed_on_dive) return `On-dive pair: paired with confirmed on-dive candidate ${pairId} (${delta}s)`;
  if (ts.immediate_pair_is_dive_labeled_event) return `Dive-labeled pair: not confirmed on-dive · paired with ${pairId} (${delta}s)`;
  if (ts.chain_reaches_dive_labeled_event) return `Chain to dive: reaches ${termId} (${termDelta}s, ${hops} hops) · not guaranteed same dive`;
  if (ts.immediate_pair_candidate_id && ts.immediate_pair_delta_seconds != null && Number(ts.immediate_pair_delta_seconds) <= 3.0) return `Chain to next: paired with non-dive ${pairId} (${delta}s) · not guaranteed same dive`;
  if (ts.bucket === "er_isolated_representative") return "Useful isolated: no nearby pair or chain";
  if (ts.bucket === "er_ambiguous") return "Needs review: cannot auto-classify · needs human judgment";
  return "";
}
const v2ShadowSummary = approveReviewShadowSummaries.find((item) => item.policy_id === "approve_review_v2_shadow") ?? null;
const v2ShadowPolicy = approveReviewShadowPolicies.find((item) => item.policy_id === "approve_review_v2_shadow") ?? null;
const refinementQueueStats = eventReviewQueueRows.reduce((acc, row) => {
  const key = String(row.current_final_human_event_label ?? "unlabeled");
  const currentCount = Number(acc[key] ?? 0);
  acc[key] = currentCount + 1;
  return acc;
}, {} as Record<string, number>);
const refinementFalseNegativeOrderBySession: Record<string, number> = {};
const formatQueueSessionLabel = (sessionId: string) => {
  const value = String(sessionId ?? "").trim();
  if (!value) return "Session";
  if (value.startsWith("evaluation_insep_15min")) return "INSEP · 15 min";
  if (value.startsWith("evaluation_insep_quick_9015")) return "INSEP · Quick 9015";
  if (value.startsWith("evaluation_champigny")) return "Champigny";
  if (value.startsWith("evaluation_")) {
    const parts = value.replace(/^evaluation_/, "").split("_").filter(Boolean);
    const short = parts.slice(0, 2).map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(" ");
    return short || "Session";
  }
  return value.length > 18 ? `${value.slice(0, 15)}…` : value;
};
const hasSession = library.session_count > 0;
const session = manifest.session;
const sessionMode = session.mode ?? "standard";
const isEvaluationSession = sessionMode === "evaluation";
const reviewDecisionByDetectionId = new Map(
  (isEvaluationSession ? listEvaluationReviewDecisions(manifest) : []).map((decision) => [decision.detectionId, decision])
);
const detections = manifest.detections.map((item) => {
  const decision = reviewDecisionByDetectionId.get(item.id);
  return {
    ...item,
    reviewClipPath: resolveClipMediaPath(item.clip.browser_path ?? item.clip.path),
    reviewLabel: decision?.label ?? item.reviewLabel ?? null,
    eventLabel: decision?.eventLabel ?? item.eventLabel ?? null,
    subtype: decision?.subtype ?? item.subtype ?? null,
  };
});
const initialFalseNegativeAnnotations = isEvaluationSession ? listEvaluationFalseNegatives(manifest) : [];
const initialFalseNegativeDetections = initialFalseNegativeAnnotations.map((annotation, index) => ({
  id: annotation.id,
  index: detections.length + index + 1,
  timestamp_seconds: Number(annotation.timestampSeconds ?? 0),
  start_time_seconds: Number(annotation.reviewStartSeconds ?? Math.max(0, Number(annotation.timestampSeconds ?? 0) - 2)),
  end_time_seconds: Number(annotation.reviewEndSeconds ?? Number(annotation.timestampSeconds ?? 0) + 2),
  duration_seconds: Math.max(0.5, Number(annotation.reviewEndSeconds ?? 0) - Number(annotation.reviewStartSeconds ?? 0)),
  review_start_seconds: Number(annotation.reviewStartSeconds ?? Math.max(0, Number(annotation.timestampSeconds ?? 0) - 2)),
  review_end_seconds: Number(annotation.reviewEndSeconds ?? Number(annotation.timestampSeconds ?? 0) + 2),
  review_duration_seconds: Math.max(0.5, Number(annotation.reviewEndSeconds ?? 0) - Number(annotation.reviewStartSeconds ?? 0)),
  confidence: "medium" as const,
  scores: {
    audio: 0,
    video: 0,
    combined: 0,
    audio_model_probability: 0,
    audio_clip_probability: 0,
  },
  features: {},
  clip: {
    path: null,
    browser_path: null,
    filename: null,
  },
  reviewClipPath: null,
  notes: annotation.notes ?? "",
  subtype: annotation.subtype ?? "",
  eventLabel: annotation.eventLabel ?? null,
  entry_type: "false_negative",
}));
const selected = detections[0];
const highest = [...detections].sort((a, b) => b.scores.combined - a.scores.combined)[0] ?? selected;
const defaultSessionName = `Session ${new Intl.DateTimeFormat("sv-SE", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
}).format(new Date()).replace(" ", " ").replace(",", "")}`;
const sessionReadyNow = sessionIsReviewReady(session.status);
const primaryVideoPath = resolveSourceMediaPath(session.source_video_path, session.output_dir);
const hasReviewProxy = primaryVideoPath !== session.source_video_path;
const primaryVideoUrl = mediaUrl(primaryVideoPath);
const sourceVideoUrl = mediaUrl(session.source_video_path);
const sourceVideoBrowserFriendly = [".mp4", ".webm", ".m4v"].includes(path.extname(session.source_video_path).toLowerCase());
const initialReviewVideoUrl = hasReviewProxy || sourceVideoBrowserFriendly ? primaryVideoUrl : "";
const initialReviewPlaceholderVisible = hasSession && !initialReviewVideoUrl;
const timelineStart = 0;
const timelineEnd = Math.max(
  Number(session.session_duration_seconds ?? 0),
  Number(session.timestamp_range.last ?? 0),
  1,
);
const rangeStart = timelineStart;
const rangeSpan = Math.max(timelineEnd - timelineStart, 1);
const niceTimelineStep = (span: number) => {
  const targetTicks = 7;
  const rough = Math.max(span / targetTicks, 0.5);
  const steps = [0.5, 1, 2, 5, 10, 15, 20, 30, 45, 60, 90, 120, 180, 300, 600];
  return steps.find((step) => rough <= step) ?? steps[steps.length - 1];
};
const timelineStep = niceTimelineStep(rangeSpan);
const timelineTicks = (() => {
  const ticks: Array<{ value: number; left: number; label: string }> = [];
  const firstTick = Math.ceil(rangeStart / timelineStep) * timelineStep;
  for (let value = firstTick; value < timelineEnd; value += timelineStep) {
    if (value <= rangeStart + 0.01 || value >= timelineEnd - 0.01) continue;
    const left = Math.min(99.2, Math.max(0.8, ((value - rangeStart) / rangeSpan) * 100));
    ticks.push({ value, left, label: formatSeconds(value) });
  }
  return ticks;
})();
const timelineScaleLabels = [
  { left: 0.8, label: formatSeconds(timelineStart), edge: "start" },
  ...timelineTicks.map((tick) => ({ left: tick.left, label: tick.label, edge: "mid" })),
  { left: 99.2, label: formatSeconds(timelineEnd), edge: "end" },
];
const markerPosition = (timestamp: number) => {
  const normalized = ((timestamp - rangeStart) / rangeSpan) * 100;
  return Math.min(99.2, Math.max(0.8, normalized));
};
const reviewStartFor = (item: typeof detections[number]) => item.review_start_seconds ?? item.start_time_seconds;
const reviewEndFor = (item: typeof detections[number]) => item.review_end_seconds ?? item.end_time_seconds;
const approveLaneForDetection = (item: typeof detections[number]) =>
  Number(item.scores.audio_model_probability) >= approveReviewPolicy.approve_min_score ? "auto_approved" : "needs_review";
const signalLabelFor = (confidence: string) => {
  if (confidence === "high") return "Strong";
  if (confidence === "medium") return "Review";
  return "Weak";
};
const detectorLabelFor = (value: string | undefined) => {
  if (!value || value === "audio_v2_pcen_classifier") return "Standard audio";
  if (value === "audio_v1_heuristic") return "Legacy audio";
  if (value === "audio_v2_hybrid_video") return "Audio + video";
  return value.replaceAll("_", " ");
};
const profileLabelFor = (value: string | undefined) => {
  if (!value || value === "long-session") return "Training session";
  if (value === "reviewed") return "Reviewed session";
  return value.replaceAll("-", " ");
};
const formatSessionStamp = (value: string | undefined) => {
  if (!value) return "Unknown";
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return value;
  return new Intl.DateTimeFormat("en-GB", {
    year: "numeric",
    month: "short",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  }).format(parsed);
};
const sessionDisplayName = session.session_name ?? session.title;
const hasActiveSession = hasSession && Boolean(session.id);
const sessionDurationSeconds = Number(session.session_duration_seconds ?? session.timestamp_range.last ?? 0);
const analysisRuntimeSeconds = Number(session.telemetry.total_runtime_seconds ?? 0);
const sourceVideoLabel = session.source_video_path ? path.basename(session.source_video_path) : "No video selected";
const sourceAvailabilityLabel = session.source_availability === "missing"
  ? "Source missing"
  : session.source_availability === "relink-required"
    ? "Relink required"
    : "Source available";
const topAttemptSummary = highest
  ? `${formatSeconds(highest.timestamp_seconds)} · ${highest.confidence} confidence`
  : "Analysis not started";
const nextActionLabel = !hasActiveSession
  ? "Choose a video, keep the default detector, and start analysis."
  : detections.length === 0
    ? "This session is ready, but no attempts have been found yet."
    : sessionReadyNow
      ? (isEvaluationSession
        ? "Open Review, label each attempt as dive or non-dive, and mark missed dives directly on the proxy."
        : "Open Review, confirm the attempts you want, then export the clips you keep.")
      : "Wait for analysis to finish, then open Review.";
const initialExportedPaths = hasActiveSession ? listExportedPathsForAnalysisRun(session.id) : [];
type AssignmentDraftRow = Record<string, string>;
const assignmentDraftRepoRoot = path.basename(process.cwd()) === "desktop"
  ? path.resolve(process.cwd(), "../..")
  : process.cwd();
const assignmentDraftRoot = path.join(assignmentDraftRepoRoot, "outputs", "assignment_drafts", "snmt");
const assignmentMobileShareRoot = path.join(assignmentDraftRepoRoot, "outputs", "mobile_share", "snmt");

function sanitizeAssignmentSlug(value: string): string {
  return value
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9._-]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .replace(/^[._]+|[._]+$/g, "") || "session";
}

function assignmentRunIdIsSafe(value: string | undefined): value is string {
  return typeof value === "string" && /^[a-zA-Z0-9][a-zA-Z0-9._-]*$/.test(value);
}

function readAssignmentMetadata(draftDir: string): Record<string, unknown> {
  const metadataPath = path.join(draftDir, "draft_metadata.json");
  if (!fs.existsSync(metadataPath)) return {};
  try {
    return JSON.parse(fs.readFileSync(metadataPath, "utf-8")) as Record<string, unknown>;
  } catch {
    return {};
  }
}

function listAssignmentDraftRuns(sessionSlug: string): string[] {
  const sessionDir = path.join(assignmentDraftRoot, sessionSlug);
  if (!fs.existsSync(sessionDir)) return [];
  return fs.readdirSync(sessionDir, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name)
    .filter((runId) => fs.existsSync(path.join(sessionDir, runId, "clip_assignments_draft.csv")))
    .sort();
}

function discoverAssignmentDraft() {
  const sessionBase = path.basename(String(session.output_dir || session.id || "session"));
  const sessionSlug = sanitizeAssignmentSlug(sessionBase);
  const availableRuns = listAssignmentDraftRuns(sessionSlug);
  const requestedRun = requestedAssignmentDraftRun;
  if (requestedRun && !assignmentRunIdIsSafe(requestedRun)) {
    return {
      enabled: false,
      scaffoldOnly: false,
      discoveryStatus: "invalid_run_id",
      sessionSlug,
      requestedRun,
      availableRuns,
      draftDir: "",
      mobilePackage: "",
    };
  }
  if (requestedRun) {
    const draftDir = path.join(assignmentDraftRoot, sessionSlug, requestedRun);
    if (!fs.existsSync(path.join(draftDir, "clip_assignments_draft.csv"))) {
      return {
        enabled: false,
        scaffoldOnly: false,
        discoveryStatus: "not_found",
        sessionSlug,
        requestedRun,
        availableRuns,
        draftDir: "",
        mobilePackage: "",
      };
    }
    const metadata = readAssignmentMetadata(draftDir);
    return {
      enabled: true,
      scaffoldOnly: false,
      discoveryStatus: "selected",
      sessionSlug,
      requestedRun,
      availableRuns,
      draftDir,
      mobilePackage: String(metadata.mobile_package || path.join(assignmentMobileShareRoot, sessionSlug)),
    };
  }
  if (availableRuns.length === 1) {
    const draftDir = path.join(assignmentDraftRoot, sessionSlug, availableRuns[0]);
    const metadata = readAssignmentMetadata(draftDir);
    return {
      enabled: true,
      scaffoldOnly: false,
      discoveryStatus: "single_match",
      sessionSlug,
      requestedRun: availableRuns[0],
      availableRuns,
      draftDir,
      mobilePackage: String(metadata.mobile_package || path.join(assignmentMobileShareRoot, sessionSlug)),
    };
  }
  return {
    enabled: false,
    scaffoldOnly: false,
    discoveryStatus: availableRuns.length > 1 ? "ambiguous" : "not_found",
    sessionSlug,
    requestedRun: "",
    availableRuns,
    draftDir: "",
    mobilePackage: "",
  };
}

const assignmentDraftScaffold = discoverAssignmentDraft();

function parseAssignmentDraftCsvLine(line: string): string[] {
  const values: string[] = [];
  let current = "";
  let quoted = false;
  for (let index = 0; index < line.length; index += 1) {
    const char = line[index];
    const next = line[index + 1];
    if (quoted && char === "\"" && next === "\"") {
      current += "\"";
      index += 1;
    } else if (char === "\"") {
      quoted = !quoted;
    } else if (!quoted && char === ",") {
      values.push(current);
      current = "";
    } else {
      current += char;
    }
  }
  values.push(current);
  return values;
}

function readAssignmentDraftRows(draftDir: string): AssignmentDraftRow[] {
  const csvPath = path.join(draftDir, "clip_assignments_draft.csv");
  if (!fs.existsSync(csvPath)) return [];
  const lines = fs.readFileSync(csvPath, "utf-8").split(/\r?\n/).filter((line) => line.length > 0);
  if (lines.length < 2) return [];
  const fields = parseAssignmentDraftCsvLine(lines[0]);
  return lines.slice(1).map((line) => {
    const values = parseAssignmentDraftCsvLine(line);
    return fields.reduce((row, field, index) => {
      row[field] = values[index] ?? "";
      return row;
    }, {} as AssignmentDraftRow);
  });
}

const assignmentDraftRows = readAssignmentDraftRows(assignmentDraftScaffold.draftDir);
const assignmentRowKeyByCandidateId: Record<string, string> = {};
assignmentDraftRows.forEach((row) => {
  const candidateId = String(row.candidate_id ?? "").trim();
  const rowKey = String(row.source_mobile_filename || row.mobile_filename || "").trim();
  if (candidateId && rowKey) assignmentRowKeyByCandidateId[candidateId] = rowKey;
});
const clientBundle = JSON.stringify({
  hasSession,
  session,
  sessionMode,
  detections,
  eventReviewSupportRows,
  primaryVideoUrl,
  sourceVideoUrl,
  reviewProxyAvailable: hasReviewProxy,
  sourceVideoBrowserFriendly,
  rangeStart,
  rangeSpan,
  initialExportedPaths,
  initialReviewPending: initialReviewPlaceholderVisible,
  initialFalseNegativeAnnotations,
  requestedTab,
  requestedSession: cleanupQueueMode ? selectedSessionId : requestedSession,
  requestedJob,
  requestedFocus,
  requestedCleanupQueue,
  requestedAssignmentDraftRun,
  eventReviewQueueRows,
  eventReviewQueueTitle,
  eventReviewQueueNote,
  eventReviewQueueSummary,
  cleanupQueueMode,
  shadowV2Telemetry: requestedShadowV2Telemetry,
  approveReviewPolicy,
  approveReviewSummary,
  approveReviewShadowPolicies,
  approveReviewShadowSummaries,
  assignmentDraft: {
    ...assignmentDraftScaffold,
    initialized: assignmentDraftRows.length > 0,
    rowCount: assignmentDraftRows.length,
    rowKeyByCandidateId: assignmentRowKeyByCandidateId,
  },
});
const timingSummaryCounts: Record<string, number> = {};
const timingGroupLabels: Record<string, string> = {
  confirmed_on_dive_pair: "On-dive",
  dive_labeled_pair: "Dive near",
  rebound_chain_to_dive_labeled: "Dive chain",
  isolated_early_rebound_representative: "Useful solo",
  ambiguous_early_rebound: "Needs review",
};
detections.forEach((item) => {
  const g = timingGroupForDetection(item.id);
  if (g) timingSummaryCounts[g] = (timingSummaryCounts[g] ?? 0) + 1;
});
const hasTimingGroups = Object.values(timingSummaryCounts).some((v: number) => v > 0);
const isSortEligible: boolean = (() => {
  if (!isEvaluationSession) return false;
  try {
    const reviewedPath = path.join(session.output_dir, "exports/evaluation-review/reviewed_candidates.jsonl");
    if (!fs.existsSync(reviewedPath)) return false;
    const reviewedLines = fs.readFileSync(reviewedPath, "utf-8").split("\n").filter(Boolean);
    let onDive = 0; let structuredER = 0; let ambER = 0;
    reviewedLines.forEach((line) => {
      const row = JSON.parse(line);
      const aq = (row.anchor_quality?.anchor_quality ?? "") as string;
      if (aq === "on_dive") onDive++;
      if (aq === "early_rebound") {
        const ts = row.timing_semantics_shadow as Record<string, unknown> | undefined;
        if (ts) {
          if (ts.immediate_pair_is_confirmed_on_dive) structuredER++;
          else if (ts.immediate_pair_is_dive_labeled_event) structuredER++;
          else if (ts.chain_reaches_dive_labeled_event) structuredER++;
          else if (ts.immediate_pair_candidate_id && ts.immediate_pair_delta_seconds != null && Number(ts.immediate_pair_delta_seconds) <= 3.0) structuredER++;
          else if (ts.bucket === "er_isolated_representative") structuredER++;
          else if (ts.bucket === "er_ambiguous") ambER++;
        }
      }
    });
    if (onDive < 5) return false;
    if (structuredER < 7) return false;
    if (ambER > 12) return false;
    if (onDive > 0) {
      const erGroups = Object.values(timingSummaryCounts).reduce((a: number, b: number) => a + b, 0);
      if (erGroups / onDive > 20) return false;
    }
    return true;
  } catch { return false; }
})();
---

<main class={`screen theme-${theme.id}`} data-design-root>
  <header class="workspace-header shell">
    <a class="brand-lockup" href="/" aria-label="DiveSensei home">
      <img src={brandLockupDark.src} alt="DiveSensei" class="brand-lockup__image" />
    </a>
    <nav class="header-nav" aria-label="Workspace tabs">
      {theme.tabs.map((tab, index) => (
        <button
          class={`tab ${index === initialTabIndex ? "is-active" : ""}`}
          type="button"
          data-tab-trigger
          data-tab-target={`panel-${index}`}
        >
          {tab}
        </button>
      ))}
    </nav>
  </header>

  <section class={`panel shell ${initialTabIndex === 0 ? "is-active" : ""}`} id="panel-0" data-tab-panel>
    <div class="grid library-grid">
      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>New session</h2>
            <p class="section-note">Choose a video, pick a detector, and start analysis.</p>
          </div>
          <button class="action-link" type="button" data-open-tab="3">Open library</button>
        </div>
        {sessionReadyNow && session.status === "ready_proxy_pending" && (
          <div class="library-inline-note">
            <strong>Ready to review.</strong> The review video is still being prepared.
          </div>
        )}
        <form class="analysis-launcher" data-analysis-form>
          <div class="analysis-launcher__grid">
            <label class="field">
              <span>Session name</span>
              <input
                type="text"
                name="sessionName"
                value={defaultSessionName}
                data-analysis-session-name
                data-default-session-name={defaultSessionName}
                autocomplete="off"
              />
            </label>
            <label class="field">
              <span>Video file</span>
              <div class="analysis-picker">
                <input type="text" name="videoPath" value="" data-analysis-path autocomplete="off" placeholder="/absolute/path/to/video.mov" />
                <div class="analysis-picker__controls">
                  <button type="button" class="action-link analysis-picker__button" data-analysis-pick>Choose file</button>
                  <span class="analysis-picker__label" data-analysis-file-label>No file selected. You can still paste a path manually.</span>
                </div>
                <input
                  type="file"
                  accept="video/*,.mov,.mp4,.m4v,.avi,.mkv,.webm"
                  class="analysis-picker__native"
                  data-analysis-file
                />
              </div>
            </label>
            <label class="field">
              <span>Session type</span>
              <select name="profile" data-analysis-profile>
                <option value="long-session" selected>Training session</option>
                <option value="reviewed">Reviewed session</option>
              </select>
            </label>
            <label class="field">
              <span>Detection method</span>
              <select name="detectorId" data-analysis-detector>
                <option value="audio_v2_pcen_classifier" selected>Standard</option>
                <option value="audio_v1_heuristic">Legacy audio</option>
                <option value="audio_v2_hybrid_video">Audio + video</option>
              </select>
            </label>
          </div>
          <div class="analysis-launcher__actions launcher-actions">
            <button type="submit" class="action-link action-link--primary">Start analysis</button>
          </div>
          <p class="analysis-launcher__status" data-analysis-status>Ready when you are.</p>
        </form>
      </article>

      <article class="section-card">
        <div class="section-card__header">
          <div>
            <h2>What happens next</h2>
            <p class="section-note">Create first, review second, export last.</p>
          </div>
        </div>
        <div class="session-summary session-summary--empty">
          <div class="session-summary__empty-grid">
            <article>
              <strong>1. Choose a video</strong>
              <p>Pick a file, or paste a full path if the video is already on disk.</p>
            </article>
            <article>
              <strong>2. Start analysis</strong>
              <p>DiveSensei scans the full session and prepares reviewable attempts.</p>
            </article>
            <article>
              <strong>3. Open Library</strong>
              <p>Use the Library tab to reopen older sessions, rename them, or remove them.</p>
            </article>
            <article>
              <strong>4. Review and export</strong>
              <p>Confirm the attempts you want, then export only the clips you keep.</p>
            </article>
          </div>
          <div class="action-list">
            <button class="action-link" type="button" data-open-tab="3">Browse library</button>
            <button class="action-link" type="button" data-open-tab="1" disabled={!hasActiveSession}>Open review</button>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class={`panel panel--review shell ${initialTabIndex === 1 ? "is-active" : ""}`} id="panel-1" data-tab-panel>
    <div class="review-layout">
      <article class="review-main">
        <div class="review-main__video">
          <div class="player-stage__frame">
            <video
              class="review-video"
              controls
              preload="metadata"
              playsinline
              src={initialReviewVideoUrl || undefined}
              data-review-video
              data-source-src={primaryVideoUrl}
            ></video>
            <div class="library-inline-note" data-review-placeholder hidden={!initialReviewPlaceholderVisible}>
              The review video for this file is still being prepared. Playback will appear automatically.
            </div>
          </div>
        </div>
        <div class="review-main__controls">
          <div class="review-decisions">
            <button class="action-link review-decisions__button" type="button" data-review-prev aria-label="Previous queue item">Previous</button>
            <button class="action-link review-decisions__button" type="button" data-review-next aria-label="Next queue item">Next</button>
            <button class="action-link review-decisions__button" type="button" data-toggle-splash-pause aria-label="Pause briefly at splash cue">Pause at splash off</button>
            <span class="review-splash-indicator" data-splash-cue-indicator aria-live="polite">Splash cue</span>
            <button class="action-link review-decisions__button review-decisions__button--keep" type="button" data-decision={isEvaluationSession ? "dive" : "keep"}>{isEvaluationSession ? "Dive" : "Keep"}</button>
            <button class="action-link review-decisions__button review-decisions__button--reject" type="button" data-decision={isEvaluationSession ? "non_dive" : "reject"}>{isEvaluationSession ? "Non-dive" : "Reject"}</button>
            <button class="action-link review-decisions__button review-decisions__button--unsure" type="button" data-decision="unsure">Unsure</button>
            {isEvaluationSession && (
              <button class="action-link review-decisions__button review-decisions__button--reject" type="button" data-decision-false-negative>Missed dive</button>
            )}
            {isEvaluationSession && (
              <label class="review-decisions__toggle">
                <input type="checkbox" data-timeline-fn-toggle />
                <span>FN focus timeline</span>
              </label>
            )}
            {isEvaluationSession && (
              <select class="review-decisions__subtype" data-decision-subtype aria-label="Evaluation subtype">
                <option value="">Subtype (optional)</option>
                <option value="board_rebound">Board rebound</option>
                <option value="board_slap">Board slap</option>
                <option value="non_dive_splash">Non-dive splash</option>
                <option value="voice_whistle">Voice / whistle</option>
                <option value="handling_noise">Handling noise</option>
                <option value="unknown_transient">Unknown transient</option>
              </select>
            )}
            {isEvaluationSession && (
              <select class="review-decisions__subtype" data-event-label aria-label="Event label">
                <option value="">Event label (optional)</option>
                <option value="platform_dive">Platform dive</option>
                <option value="springboard_dive">Springboard dive</option>
                <option value="noise_or_other">Noise or other</option>
                <option value="springboard_rebound_only">Springboard rebound only</option>
                <option value="unknown_or_unsure">Unknown / unsure</option>
                <option value="uncertain">Uncertain (legacy)</option>
              </select>
            )}
            {isEvaluationSession && (
              <select class="review-decisions__subtype" data-candidate-usefulness aria-label="Candidate usefulness">
                <option value="">Usefulness (optional)</option>
                <option value="useful_clip">Useful clip</option>
                <option value="duplicate_of_previous_dive">Duplicate of previous dive</option>
                <option value="wrong_event">Wrong event</option>
                <option value="too_early_or_late">Too early / late</option>
                <option value="unusable">Unusable</option>
                <option value="unsure">Unsure</option>
              </select>
            )}
            {isEvaluationSession && (
              <select class="review-decisions__subtype" data-clip-quality aria-label="Clip quality">
                <option value="">Clip quality (optional)</option>
                <option value="good">Good</option>
                <option value="too_early">Too early</option>
                <option value="too_late">Too late</option>
                <option value="too_short">Too short</option>
                <option value="too_long">Too long</option>
                <option value="wrong_event">Wrong event</option>
                <option value="unusable">Unusable</option>
              </select>
            )}
            {isEvaluationSession && (
              <select class="review-decisions__subtype" data-anchor-quality aria-label="Anchor quality">
                <option value="">Anchor quality (confirm)</option>
                <option value="on_dive">On dive</option>
                <option value="early_rebound">Early rebound</option>
                <option value="late_after_entry">Late after entry</option>
                <option value="duplicate">Duplicate</option>
                <option value="wrong_event">Wrong event</option>
                <option value="unclear">Unclear</option>
                <option value="unknown">Unknown</option>
              </select>
            )}
            <input type="text" class="review-decisions__note" data-decision-notes placeholder="Note (optional)" />
            {isEvaluationSession && (
              <button class="action-link review-decisions__button review-decisions__button--keep" type="button" data-event-save>Save event label</button>
            )}
          </div>
        </div>
        <div class="review-main__timeline">
          <div class="tl" data-timeline-viewport>
            <div class="tl__scale">
              {timelineScaleLabels.map((tick) => (
                <span
                  class={`tl__time tl__time--${tick.edge}`}
                  style={`left:${tick.left}%;`}
                >
                  {tick.label}
                </span>
              ))}
            </div>
            <div class="tl__track" data-timeline-track>
              <div class="tl__playhead" data-timeline-playhead></div>
              <div class="tl__tooltip" data-timeline-tooltip hidden></div>
              {timelineTicks.map((tick) => (
                <span
                  class="tl__tick"
                  style={`left:${tick.left}%;`}
                  aria-hidden="true"
                ></span>
              ))}
              {detections.map((item) => (
                <button
                  type="button"
                  class={`tl__pip confidence-${item.confidence} ${item.id === selected?.id ? "is-current" : ""}`}
                  style={`left:${markerPosition(item.timestamp_seconds)}%;`}
                  data-focus-detection={item.id}
                  data-timeline-marker={item.id}
                  data-pip-index={item.index}
                  data-pip-time={formatSeconds(item.timestamp_seconds)}
                  aria-label={`Attempt ${item.index} at ${formatSeconds(item.timestamp_seconds)}`}
                ></button>
              ))}
              {initialFalseNegativeDetections.map((item) => (
                <button
                  type="button"
                  class={`tl__pip confidence-${item.confidence} is-false-negative ${item.id === selected?.id ? "is-current" : ""}`}
                  style={`left:${markerPosition(item.timestamp_seconds)}%;`}
                  data-focus-detection={item.id}
                  data-timeline-marker={item.id}
                  data-pip-index={item.index}
                  data-pip-time={formatSeconds(item.timestamp_seconds)}
                  aria-label={`Manual false-negative window at ${formatSeconds(item.timestamp_seconds)}`}
                ></button>
              ))}
            </div>
          </div>
        </div>
        <p class="review-main__status" data-decision-status hidden>No decision saved for this attempt.</p>
        <div class="library-inline-note" data-review-progress hidden>
          Review is available now. Export only the clips you keep.
        </div>
        <section class="review-complete-toast" data-review-complete hidden>
          <div class="review-complete-toast__body">
            <strong data-review-complete-title>{isEvaluationSession ? "Evaluation review complete" : "Review complete"}</strong>
            <p data-review-complete-copy>{isEvaluationSession ? "You have reviewed every detector attempt. Open Summary to inspect dive, non-dive, and false-negative counts." : "You have finished the queue. Open Exports to create clips from the attempts you kept, or stay here and keep browsing."}</p>
          </div>
          <div class="review-complete-toast__actions">
            <button class="action-link action-link--primary" type="button" data-review-complete-export>{isEvaluationSession ? "Open summary" : "Open exports"}</button>
            <button class="action-link" type="button" data-review-complete-stay>Keep reviewing</button>
          </div>
          <div class="review-complete-toast__timer" aria-hidden="true"></div>
        </section>
      </article>

      <aside
        class="review-sidebar"
        data-review-sidebar
        data-filter-mode="all"
        data-has-refinement={eventReviewQueueRows.length > 0 ? "true" : "false"}
        data-sidebar-mode={eventReviewQueueRows.length > 0 ? "focus" : "review"}
      >
        <div class="review-sidebar__top">
        <div class="review-sidebar__modebar">
          {eventReviewQueueRows.length > 0 && (
            <button class="review-sidebar__modebutton is-active" type="button" data-sidebar-mode-button data-sidebar-mode-target="focus">
              Priority
            </button>
          )}
          <button class={`review-sidebar__modebutton ${eventReviewQueueRows.length === 0 ? "is-active" : ""}`} type="button" data-sidebar-mode-button data-sidebar-mode-target="review">
            Review
          </button>
          <button class="review-sidebar__modebutton" type="button" data-sidebar-mode-button data-sidebar-mode-target="assignment">
            Assign.
          </button>
          <button class="review-sidebar__modebutton" type="button" data-sidebar-mode-button data-sidebar-mode-target="policy">
            Policy
          </button>
          {isEvaluationSession && (
            <button class="review-sidebar__modebutton" type="button" data-sidebar-mode-button data-sidebar-mode-target="guide">
              Guide
            </button>
          )}
        </div>
        {isEvaluationSession && hasTimingGroups && (
          <div class="timing-summary" data-timing-summary title="Timing groups from shadow/debug metadata. Click a group to locate the first matching row.">
            {Object.entries(timingGroupLabels).map(([key, label]) => {
              const count = timingSummaryCounts[key] ?? 0;
              if (count === 0) return null;
              return (
                 <span class={`timing-summary__group timing-summary__group--${key}`} data-timing-scroll-to={key}>
                  {label} ({count})
                </span>
              );
            })}
          </div>
        )}
        </div>
        {eventReviewQueueRows.length > 0 && (
          <section class="review-sidebar__panel review-refinement" data-review-refinement data-sidebar-panel="focus">
            <div class="review-refinement__summary">
              <div class="review-refinement__header">
                <div class="review-refinement__titleblock">
                  <h2>{eventReviewQueueTitle ?? "Refinement queue"}<span class="review-refinement__count">{isCleanupQueueMode ? Number(eventReviewQueueSummary?.total ?? eventReviewQueueRows.length) : eventReviewQueueRows.length} rows</span></h2>
                  {eventReviewQueueNote && <p>{eventReviewQueueNote}</p>}
                </div>
              </div>
              {isCleanupQueueMode && (
              <div class="review-refinement__stats">
                <article class="review-refinement__stat">
                  <strong data-cleanup-completed>{cleanupQueueSummaryStats?.completed ?? 0}</strong>
                  <span>complete</span>
                </article>
                <article class="review-refinement__stat">
                  <strong data-cleanup-remaining>{cleanupQueueSummaryStats?.remaining ?? eventReviewQueueRows.length}</strong>
                  <span>remaining</span>
                </article>
                <article class="review-refinement__stat">
                  <strong data-cleanup-total>{cleanupQueueSummaryStats?.total ?? eventReviewQueueRows.length}</strong>
                  <span>total</span>
                </article>
                <article class="review-refinement__stat">
                  <strong data-cleanup-current-position>1</strong>
                  <span>current row</span>
                </article>
                {cleanupQueuePriorityStats.map(({ bucket, remaining }) => (
                  <article class="review-refinement__stat">
                    <strong>{remaining}</strong>
                    <span>{bucket.replaceAll("_", " ")}</span>
                  </article>
                ))}
              </div>
              )}
            </div>
            <ol class="review-refinement__list" data-review-refinement-list>
              {eventReviewQueueRows.map((row, index) => (
                (() => {
                  const sessionId = String(row.session_id ?? "");
                  const falseNegativeOrder = row.candidate_id == null
                    ? ((refinementFalseNegativeOrderBySession[sessionId] = (refinementFalseNegativeOrderBySession[sessionId] ?? 0) + 1), refinementFalseNegativeOrderBySession[sessionId])
                    : "";
                  const isCleanup = isCleanupQueueMode;
                  const labelText = isCleanup
                    ? String(row.cleanup_current_review_label ?? "unlabeled").replaceAll("_", " ")
                    : String(row.current_final_human_event_label ?? "unlabeled").replaceAll("_", " ");
                  const priorityBucket = String(row.suggested_priority_bucket ?? "").replaceAll("_", " ");
                  const needsLabels = Array.isArray(row.required_human_decisions) ? row.required_human_decisions.map((v) => String(v).replaceAll("_", " ")).map((v) => v === "anchor quality" ? "AQ" : v === "candidate usefulness" ? "CU" : v).join(", ") : "";
                  return (
                <li class="review-refinement__item">
                  <button
                    type="button"
                    class={isCleanup ? "review-refinement__row" : "review-refinement__row is-compact"}
                    data-queue-focus
                    data-queue-session={String(row.session_id ?? "")}
                    data-queue-candidate={String(row.candidate_id ?? "")}
                    data-queue-index={String(index + 1)}
                    data-queue-label={labelText}
                    data-queue-pred={String(row.model_predicted_label ?? "")}
                    data-queue-suggestion={String(row.suggestion_label ?? "")}
                    data-queue-fn-order={String(falseNegativeOrder)}
                    data-queue-cleanup-mode={String(row.cleanup_mode ?? "")}
                    data-queue-cleanup-complete={String(row.cleanup_complete ?? false)}
                    data-queue-cleanup-review-label={String(row.cleanup_current_review_label ?? "")}
                    data-queue-cleanup-event-label={String(row.cleanup_current_event_label ?? "")}
                    data-queue-cleanup-anchor-quality={String(row.cleanup_current_anchor_quality ?? "")}
                    data-queue-cleanup-usefulness={String(row.cleanup_current_candidate_usefulness ?? "")}
                    data-queue-cleanup-clip-quality={String(row.cleanup_current_clip_quality ?? "")}
                    data-queue-cleanup-required={Array.isArray(row.required_human_decisions) ? row.required_human_decisions.join("|") : ""}
                    data-queue-cleanup-priority={priorityBucket}
                    data-queue-cleanup-media-kind={String(row.review_media_kind ?? "")}
                    data-queue-cleanup-shadow-rank={String(row.candidate_quality_shadow_rank ?? "")}
                    data-queue-cleanup-shadow-score={String(row.candidate_quality_shadow_score_keep ?? "")}
                    data-queue-cleanup-split-role={String(row.split_role_context ?? "")}
                    data-queue-cleanup-is-unreviewed={needsLabels ? "true" : "false"}
                  >
                    <span class="review-refinement__rank">{String(index + 1).padStart(2, "0")}</span>
                    <div class="review-refinement__body">
                      <div class="review-refinement__rowhead">
                        <strong>{String(row.candidate_id ?? "Manual false-negative window")}</strong>
                        <div class="review-refinement__rowmeta">
                          <span class="review-refinement__status" data-queue-status>Pending</span>
                          {priorityBucket && <span class="review-refinement__priotag">{priorityBucket}</span>}
                          {needsLabels && <span class="review-refinement__needstag">Needs: {needsLabels}</span>}
                        </div>
                      </div>
                      <div class="review-refinement__labels">
                        <span data-queue-final-label class="review-refinement__finallabel">{labelText}</span>
                      </div>
                    </div>
                  </button>
                </li>
                  );
                })()
              ))}
            </ol>
            <div class="review-refinement__foot">
              <span>{isCleanupQueueMode ? "Click a row to jump directly into cleanup review. Save only intentional human edits; no labels are auto-filled." : "Click a row to jump directly into the review queue."}</span>
            </div>
          </section>
        )}
        <section class="review-sidebar__panel review-sidebar__panel--policy" data-sidebar-panel="policy" hidden>
          <section
            class="approve-policy-card"
            data-approve-policy
            data-policy-id={approveReviewPolicy.policy_id}
            data-model-ref={approveReviewPolicy.model_ref}
            data-approve-min-score={String(approveReviewPolicy.approve_min_score)}
          >
            <div class="approve-policy-card__header">
              <div>
                <h2>Approve/review v1</h2>
                <p>Trusted fast lane. Everything else stays in review.</p>
              </div>
              <span class="policy-pill">Default</span>
            </div>
            <div class="approve-policy-card__stats">
              <span><strong>{approveReviewSummary.auto_approved_count}</strong> auto-approved</span>
              <span><strong>{approveReviewSummary.needs_review_count}</strong> needs review</span>
            </div>
            {v2ShadowPolicy && v2ShadowSummary && (
              <div class="approve-policy-card__shadow" data-shadow-policy-id={v2ShadowPolicy.policy_id}>
                <span>Shadow v2 · guarded</span>
                <strong>{v2ShadowSummary.auto_approved_count}</strong>
                <span>candidate approvals, nuisance subtypes held for review</span>
              </div>
            )}
            <div class="approve-policy-card__meta">
              <span>{approveReviewPolicy.model_ref}</span>
              <span>score ≥ {approveReviewPolicy.approve_min_score.toFixed(5)}</span>
            </div>
          </section>
          <div class="review-sidebar__policy-detail">
            <p>Use this view when you need approval-lane context and shadow-ranking context. It does not change active product behavior.</p>
            <div class="review-sidebar__policy-grid">
              <span data-detail-audio>Audio {selected ? selected.scores.audio.toFixed(2) : "0.00"}</span>
              <span data-detail-window>Window {selected ? `${formatSeconds(reviewStartFor(selected))} to ${formatSeconds(reviewEndFor(selected))}` : "0:00.000 to 0:00.000"}</span>
              <span data-detail-decision>No decision yet</span>
              <span data-detail-shadow-rank>Shadow rank: audio embedding unavailable</span>
              <span data-detail-candidate-quality-shadow>Shadow quality: unavailable</span>
            </div>
          </div>
        </section>
        <section class="review-sidebar__panel review-sidebar__panel--review" data-sidebar-panel="review" hidden={eventReviewQueueRows.length > 0}>
          <div class="review-sidebar__header">
            <h2 data-review-list-title>{isEvaluationSession ? "Evaluation queue" : "Attempts"}</h2>
            <div class="review-sidebar__controls">
              <select class="review-sidebar__filter" data-review-filter>
                <option value="needs_review" selected>Needs review</option>
                <option value="auto_approved">Auto-approved</option>
                <option value="all">All rows</option>
                <option value="pending">Manual pending</option>
                {isEvaluationSession && <option value="shadow_available">Shadow score available</option>}
                {isEvaluationSession && <option value="useful_clip">Useful clips</option>}
                {isEvaluationSession && <option value="unknown_or_unsure">Unknown / unsure events</option>}
                <option value={isEvaluationSession ? "dive" : "keep"}>{isEvaluationSession ? "Dives" : "Kept"}</option>
                <option value={isEvaluationSession ? "non_dive" : "reject"}>{isEvaluationSession ? "Non-dives" : "Rejected"}</option>
                <option value="unsure">Unsure</option>
                {isEvaluationSession && <option value="needs_anchor_quality">Needs anchor quality</option>}
                {isEvaluationSession && <option value="false_negative">False negatives</option>}
              </select>
              {isSortEligible && (
              <button
                class="review-sidebar__sort-toggle"
                type="button"
                data-sort-toggle
                aria-pressed="false"
                title="Shadow-only experimental ordering. Does not affect final review. Per-session. Not default."
              >
                Experimental sort
              </button>
            )}
            </div>
          </div>
          <div class="review-sidebar__list">
            <table class="queue-table">
              <thead>
                <tr>
                  <th>Attempt</th>
                  <th>Splash</th>
                  <th>Decision</th>
                  <th>{isEvaluationSession ? "Type" : "Signal"}</th>
                </tr>
              </thead>
              <tbody data-detection-table>
                {detections.map((item) => {
                  const timingGroup = timingGroupForDetection(item.id);
                  const timingTooltip = timingTooltipForDetection(item.id);
                  return (
                  <tr
                    class={`${item.id === selected?.id ? "is-current" : ""} is-${approveLaneForDetection(item)} ${timingGroup ? `timing-${timingGroup}` : ""}`.trim()}
                    data-focus-detection={item.id}
                    data-policy-lane={approveLaneForDetection(item)}
                    data-policy-score={Number(item.scores.audio_model_probability).toFixed(3)}
                    data-timing-group={timingGroup || undefined}
                    title={timingTooltip || undefined}
                  >
                    <td>{item.id}</td>
                    <td>{formatSeconds(item.timestamp_seconds)}</td>
                    <td>{approveLaneForDetection(item)}</td>
                    <td>{signalLabelFor(item.confidence)}</td>
                  </tr>
                );})}
              </tbody>
            </table>
            <div class="review-sidebar__empty" data-review-empty hidden>
              No rows match this filter.
            </div>
          </div>
        </section>
        {isEvaluationSession && (
          <aside class="review-sidebar__panel anchor-quality-memo" id="anchor-quality-memo" data-anchor-quality-memo data-sidebar-panel="guide" hidden>
            <div class="anchor-quality-memo__header">
              <strong>Anchor quality guide</strong>
            </div>
            <p>Use this for anchor timing and duplicate quality only. Do not use it to replace the event label.</p>
            <div class="anchor-quality-memo__quickrules">
              <strong>Quick review rules</strong>
              <ul>
                <li>Label the event first. Use anchor quality only for timing and duplicate judgment.</li>
                <li><b>early_rebound</b> is still review-worthy when the clip clearly leads into the real dive.</li>
                <li><b>late_after_entry</b> and <b>wrong_event</b> usually mean deprioritize or suppress later.</li>
                <li>If the same dive appears twice, keep the better-timed row and mark the other <b>duplicate</b>.</li>
              </ul>
            </div>
            <span><b>on_dive</b>: anchor is on the actual dive or entry cue.</span>
            <span><b>early_rebound</b>: board/hurdle/rebound anchor, but the clip still leads to the dive.</span>
            <span><b>late_after_entry</b>: anchor fires after the useful dive moment.</span>
            <span><b>duplicate</b>: repeated candidate for the same dive.</span>
            <span><b>wrong_event</b>: no useful dive clip should be reviewed from this anchor.</span>
            <span><b>unclear</b>: needs human judgment. Do not force ambiguous failed-hurdle rows.</span>
          </aside>
        )}
